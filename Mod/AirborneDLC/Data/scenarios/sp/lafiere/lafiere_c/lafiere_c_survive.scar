		},
		
		Intro = {
		
			{ACTOR.LA_FIERE.Craft, 9430000},
			{ACTOR.LA_FIERE.Craft, 9430010},
			{ACTOR.LA_FIERE.GenericAlly, 9430020},
			{ACTOR.LA_FIERE.Craft, 9430030},
