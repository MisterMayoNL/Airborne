		if bridge_baron == false and medal_ui_baron_bridge == false then --and hpid_baron_bridge == false then
			
			--hpid_baron_bridge = HintPoint_Add(Marker_GetPosition(mkr_bridge_baron), true, 1389124)
			--pingid_baron_bridge = Objective_AddPing(OBJ_Defend, Util_GetPosition(mkr_bridge_baron), 1)
			medal_ui_baron_bridge = Objective_AddUIElements(OBJ_Medal_Bridge, mkr_bridge_baron, true, 1389124, true)
			
		elseif bridge_baron == true and medal_ui_baron_bridge ~= false then--and hpid_baron_bridge ~= false then
			
			--HintPoint_Remove(hpid_baron_bridge)
			--hpid_baron_bridge = false
			--Objective_RemovePing(OBJ_Defend, pingid_baron_bridge)
			
			Objective_RemoveUIElements(OBJ_Medal_Bridge, medal_ui_baron_bridge)
			medal_ui_baron_bridge = false
			
		end
		
		
		if EGroup_IsCapturedByPlayer(eg_flags_tourmau, player1, ANY) == false and medal_ui_tourmau == false then --and hpid_tourmau == false then
			--hpid_tourmau = HintPoint_Add(EGroup_GetPosition(eg_flags_tourmau), true, 1389123)
			--pingid_tourmau = Objective_AddPing(OBJ_Defend, Util_GetPosition(eg_flags_tourmau), 1)
			
			medal_ui_tourmau = Objective_AddUIElements(OBJ_Medal_Bridge, eg_flags_tourmau, true, 1389123, true, 2.3)
			
		
		elseif EGroup_IsCapturedByPlayer(eg_flags_tourmau, player1, ANY) and medal_ui_tourmau ~= false then--and hpid_tourmau ~= false then
			--HintPoint_Remove(hpid_tourmau)
			--hpid_tourmau = false
			--Objective_RemovePing(OBJ_Defend, pingid_tourmau)
			
			Objective_RemoveUIElements(OBJ_Medal_Bridge, medal_ui_tourmau)
			medal_ui_tourmau = false
			
		end
		
		if EGroup_IsCapturedByPlayer(eg_flags_tourmau_across, player1, ANY) == false and medal_ui_tourmau_across == false then -- and hpid_tourmau_across == false then
			--hpid_tourmau_across = HintPoint_Add(EGroup_GetPosition(eg_flags_tourmau_across), true, 1389123)
			--pingid_tourmau_across = Objective_AddPing(OBJ_Defend, Util_GetPosition(eg_flags_tourmau_across), 1)
			
			medal_ui_tourmau_across = Objective_AddUIElements(OBJ_Medal_Bridge, eg_flags_tourmau_across, true, 1389123, true, 2.3)
		
		elseif EGroup_IsCapturedByPlayer(eg_flags_tourmau_across, player1, ANY) and medal_ui_tourmau_across ~= false then --and hpid_tourmau_across ~= false then
			--HintPoint_Remove(hpid_tourmau_across)
			--hpid_tourmau_across = false
			--Objective_RemovePing(OBJ_Defend, pingid_tourmau_across)
			
			Objective_RemoveUIElements(OBJ_Medal_Bridge, medal_ui_tourmau_across)
			medal_ui_tourmau_across = false
			
		end
		
		
		if bridge_tourmau == false and medal_ui_tourmau_bridge == false then --and hpid_tourmau_bridge == false then
			
			--hpid_tourmau_bridge = HintPoint_Add(Marker_GetPosition(mkr_bridge_tourmau), true, 1389125)
			--pingid_tourmau_bridge = Objective_AddPing(OBJ_Defend, Util_GetPosition(mkr_bridge_tourmau), 1)
			
			medal_ui_tourmau_bridge = Objective_AddUIElements(OBJ_Medal_Bridge, mkr_bridge_tourmau, true, 1389125, true)
			
			
		elseif bridge_tourmau == true and medal_ui_tourmau_bridge ~= false then --and hpid_tourmau_bridge ~= false then
			
