--------------------------------------------------------------------------------
-- Player Wins
--------------------------------------------------------------------------------

-- 
EVENTS.OBJ_AllClear = function()
	
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Chubb, 1371450)	-- Sigs.  Message for Battalion.  (beat)  Situation resolved.  The city is fuckin' ours!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Chubb, 1371460)	-- That's how ya fuckin' do it troops!  Caen is ours boys!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Chubb, 1371470)	-- Pass the word.  All clear.  Get Ammo-Cas reports up the chain, have NCO's set up pickets and forced rest for their troops.  Move. 
	CTRL.WAIT()
	
end 