EVENTS.OBJ_DV2_START = function()
	-- reveal fog of war around rocket	
	FOW_RevealMarker(Marker_V2Rocket, -1)											
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 272100)
	CTRL.WAIT()
end

