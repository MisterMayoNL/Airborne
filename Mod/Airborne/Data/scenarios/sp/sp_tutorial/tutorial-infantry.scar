function Infantry_PickUp_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_PICKUP, false)
		
		if Misc_IsSGroupSelected(sg_playerunits, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryPickUpHMGIntro)
			
			local pos = SyncWeapon_GetPosition(infantry_hmg)
			Objective_AddUIElements(OBJ_INFANTRY_PICKUP, pos, false, 409258, true)
			
			Rule_AddInterval(Infantry_PickUp_Done, 0.5)
			
		else
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.ParatroopersSelect)
			
			Objective_AddUIElements(OBJ_INFANTRY_PICKUP, sg_playerunits, false, 409266, true)
			Rule_AddInterval(Infantry_PickUp_AirborneSelected, 0.5)
			
		end
		
	end
	
end


function Infantry_PickUp_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryPickUpHMGIntro)
		
		local pos = SyncWeapon_GetPosition(infantry_hmg)
		Objective_RemoveUIElements(OBJ_INFANTRY_PICKUP, OBJ_INFANTRY_PICKUP.PingID)
		Objective_AddUIElements(OBJ_INFANTRY_PICKUP, pos, false, 409258, true)
		
		Rule_AddInterval(Infantry_PickUp_Done, 0.5)
		
	end
	
end


function Infantry_PickUp_Done()
	
	if SyncWeapon_IsOwnedByPlayer(infantry_hmg, player1) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_PICKUP, false)
		HintPoint_RemoveAll()
		FOW_UnRevealMarker(mkr_infantry_revealhmg)
		
		Player_GetAll(player1)
		SGroup_AddGroup(sg_playerunits, sg_allsquads)
		SGroup_Duplicate(sg_allsquads, sg_group1)
		SGroup_Duplicate(sg_allsquads, sg_group2)
		SGroup_Filter(sg_group1, SBP.ALLIES.PARATROOPER, FILTER_KEEP)
		SGroup_Filter(sg_group2, SBP.ALLIES.PARATROOPER, FILTER_REMOVE)
		
		Rule_AddInterval(Infantry_PickUp_DoneB, 0.5)
		
	elseif Misc_IsSGroupSelected(sg_playerunits, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_PICKUP, OBJ_INFANTRY_PICKUP.PingID)
		OBJ_INFANTRY_PICKUP.PingID = Objective_AddUIElements(OBJ_INFANTRY_PICKUP, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_PickUp_AirborneSelected, 0.5)
		
	end
	
end
function Infantry_PickUp_DoneB()							-- wait until takeover is more complete (guys need to move up, etc)

	if Prox_AreSquadMembersNearMarker(sg_group2, mkr_infantry_hmgspawn, ALL) then
		
		Rule_RemoveMe()
		
		Util_StartIntel(EVENTS.InfantryPickUpHMGDone)
		
		EGroup_ReSpawn(eg_infantry_hmgpen) -- create the "pen"
		
		HintPoint_Add(sg_group1, true, 409263)
		HintPoint_Add(sg_group2, true, 409264)		
		
		Rule_AddInterval(Infantry_SetFacing_BeginLesson, 0.5)
		
	end
	
end





--------------------------------------------------------------------------------
-- Lesson: Set Facing of HMG
--------------------------------------------------------------------------------
function Infantry_SetFacing_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		HintPoint_RemoveAll()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_SETFACING, false)
		
		if Misc_IsSGroupSelected(sg_group2, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryRotateHMGIntro)
			
			EGroup_ReSpawn(eg_infantry_facingdirection)
			
			Rule_AddInterval(Infantry_SetFacing_Done, 0.5)
			
		else
			
			-- ask to select HMG
			Util_StartIntel(EVENTS.HMGsSelect)
			
			OBJ_INFANTRY_SETFACING.PingID = Objective_AddUIElements(OBJ_INFANTRY_SETFACING, sg_group2, false, 409267, true)
			
			Rule_AddInterval(Infantry_SetFacing_AirborneSelected, 0.5)
			
		end
		
	end
	
end


function Infantry_SetFacing_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_group2, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryRotateHMGIntro)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_SETFACING, OBJ_INFANTRY_SETFACING.PingID)
		EGroup_ReSpawn(eg_infantry_facingdirection)
		
		Rule_AddInterval(Infantry_SetFacing_Done, 0.5)
		
	end
	
end


function Infantry_SetFacing_Done()
	
	-- dir1 is the facing direction of the HMG
	local dir1 = World_Pos(0,0,0)
	if SyncWeapon_Exists(infantry_hmg) then
		dir1 = Entity_GetHeading(SyncWeapon_GetEntity(infantry_hmg))
	end
	
	-- dir2 is the direction from the HMG to the bad guy's approach direction
	local hmgpos = SyncWeapon_GetPosition(infantry_hmg)
	local enemypos = Marker_GetPosition(mkr_infantry_hmgrotatefacing)
	local dist = World_DistancePointToPoint(hmgpos, enemypos)
	local dir2 = World_Pos((enemypos.x - hmgpos.x)/dist, (enemypos.y - hmgpos.y)/dist, (enemypos.z - hmgpos.z)/dist)
	
	-- distance between the points should be less than 0.5 (approx. 30 degrees either side)
	if World_DistancePointToPoint(dir1, dir2) < 0.5 then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_SETFACING, false)
		EGroup_DeSpawn(eg_infantry_facingdirection)
		EGroup_DeSpawn(eg_infantry_hmgpen)
		
		Util_StartIntel(EVENTS.InfantryRotateHMGRotated)
		
		Rule_AddInterval(Infantry_SetFacing_StartAttack, 0.5)
		
	elseif Misc_IsSGroupSelected(sg_group2, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select HMG
		Util_StartIntel(EVENTS.HMGsReSelect)
		
		EGroup_DeSpawn(eg_infantry_facingdirection)
		OBJ_INFANTRY_SETFACING.PingID = Objective_AddUIElements(OBJ_INFANTRY_SETFACING, sg_group2, false, 409267, true)
		
		Rule_AddInterval(Infantry_SetFacing_AirborneSelected, 0.5)
		
	end
	
end


function Infantry_SetFacing_StartAttack()

	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		Util_StartIntel(EVENTS.InfantryRotateHMGIncoming)
		
		FOW_RevealMarker(mkr_infantry_revealcounterattack, -1)
		Camera_ClampToMarker(camera_infantry_d)
		Camera_MoveToPosition(mkr_infantry_revealcounterattack, true, SLOW_CAMERA_PANNING)
		Camera_SafetyDefault()
		
		SGroup_SetInvulnerable(sg_playerunits, true)
		
		Util_CreateSquads(player2, sg_group3, SBP.AXIS.GRENADIER, mkr_infantry_counterattackspawn, nil, 2)
		Modify_Vulnerability(sg_group3, 1.4)
		Cmd_AttackMove(sg_group3, sg_playerunits)
		
		Rule_AddInterval(Infantry_SetFacing_WaitUntilKilled, 0.5)
		
	end

end


function Infantry_SetFacing_WaitUntilKilled()
	
	if SGroup_Count(sg_group3) == 0 then
		
		Rule_RemoveMe()
		
		SGroup_SetInvulnerable(sg_playerunits, false)
		
		Util_StartIntel(EVENTS.InfantryRotateHMGDone)
		
		Rule_AddInterval(Infantry_MoreParas_Intro, 0.5)
		
	end
	
end


