-------------------------------------------------------------------------

-- MISSION START 

-------------------------------------------------------------------------

function GreyCastle_MissionStart()

	if Event_IsAnyRunning() == false then
		
		if g_debug ~= true then
			Rule_Add(Survive_CausewayRun)
		end
		Rule_AddInterval(GreyCastle_MissionStart2, 1)
		
		Rule_RemoveMe()
	end
end


function GreyCastle_MissionStart2()

	if Event_IsAnyRunning() == false then
		
		--Game_Letterbox(false, 1)
		Game_FadeToBlack(FADE_IN, 1)
		--Taskbar_SetVisibility(false)
		-- fix camera
 		Camera_SetDefault(30, 43, -123)
 		Camera_ResetToDefault()	
		FOW_Enable(true)
		
		-- delay first objective
		Rule_AddOneShot(LaFiere_C_DelayFirstOBJ, 2)
		
		Rule_AddInterval(GreyCastle_ObjTrack, 5)
		Rule_AddOneShot(Casualty_Preset, 10)
		
		Rule_RemoveMe()
	end
end


function LaFiere_C_DelayFirstOBJ()
	ATclear_CamoOn() -- calls the camo function from LaFiere_C_ATclear so the guns are hidden
	Objective_Start(OBJ_Survive)
	Sound_PlayMusic("Music/DLC/Causeway/LaFiere_C/LFC_Take_Causeway.bsc",2,0)

	-- debug 
	-- GreyCastle_SpawnHeroes(mkr_causeway_East)
 	-- Objective_Start(OBJ_Chef)

end


		
function LaFiere_C_MissionEnd()
	if Event_IsAnyRunning() == false then
		
		if g_debug ~= true then
			
			Rule_RemoveAll()
			Sound_StopMusic(3, 0)
			
			--Player_GetAll(player4, sg_p4cleanup)
			Player_GetAll(player3, sg_p3cleanup)
			Player_GetAll(player2, sg_p2cleanup)
			Player_GetAll(player1, sg_p1cleanup)
			
			if SGroup_IsEmpty(sg_p3cleanup) == false then
				SGroup_DeSpawn(sg_p3cleanup)
			end
			
			if SGroup_IsEmpty(sg_p1cleanup) == false then
				SGroup_DeSpawn(sg_p1cleanup)
			end
			
			if SGroup_IsEmpty(sg_p2cleanup) == false then
				SGroup_DeSpawn(sg_p2cleanup)
			end
			
--~ 			if SGroup_IsEmpty(sg_p4cleanup) == false then
--~ 				SGroup_DeSpawn(sg_p4cleanup)
--~ 			end
			Game_FadeToBlack(FADE_OUT, 1)
			Rule_AddInterval(LaFiere_C_DelayNIS, 1)
			
			Rule_RemoveMe()
		elseif g_debug == false then
			LaFiere_C_DelayNIS()
			Rule_RemoveMe()
		end
		return
	end
end

function LaFiere_C_DelayNIS()

	if Event_IsAnyRunning() == false then
		Util_StartNIS(NIS_CLOSING, LaFiere_C_PostEndNIS)
		Rule_RemoveMe()
	end

end


function LaFiere_C_PostEndNIS()
	if Event_IsAnyRunning() == false then
		Game_EndSP(true, 9439170) 
		Rule_RemoveMe()
	end
end

function GreyCastle_ObjTrack()
	
	-- Transition from 'Practice' to 'Manor'
	if Objective_IsComplete(OBJ_Survive) and Objective_IsStarted(OBJ_ATclear) == false then-- start the 2nd objective
		Objective_Start(OBJ_ATclear)
		ATclear_CamoOff()
		Sound_PlayMusic("Music/DLC/Causeway/LaFiere_C/LFC_Take_Town.bsc",2,0)
		return
	end
	
	-- Transition from 'Manor' to 'Chef'
	if Objective_IsComplete(OBJ_ATclear) and Objective_IsStarted(OBJ_Brae) == false then-- start the 3rd objective
		Objective_Start(OBJ_Brae)
		Objective_Start(OBJ_ClearFork)
		return
	end
	
	-- Transition from 'Manor' to 'Chef'
	if Objective_IsComplete(OBJ_Brae) and Objective_IsStarted(OBJ_Castle) == false then-- start the 3rd objective
		Objective_Start(OBJ_Castle)
		Sound_PlayMusic("Music/DLC/Causeway/LaFiere_C/LFC_Take_Castle.bsc",2,0)
		return
	end
	
	if Objective_IsComplete(OBJ_Castle) then
	
	
		if Objective_IsStarted(OBJ_AbleAndBakerSurvive) == false then
			-- need delay or won't work?
			Objective_Start(OBJ_AbleAndBakerSurvive, false)
			Rule_AddOneShot(LaFiere_AbleAndBakerSurviveComplete, 1)
		elseif Objective_IsStarted(OBJ_AbleAndBakerSurvive) == true then
			Objective_Complete(OBJ_AbleAndBakerSurvive, false)
			
		end
	
		if Objective_IsStarted(OBJ_CraftSurvive) == false then
			-- need delay or won't work?
			Objective_Start(OBJ_CraftSurvive, false)
			Rule_AddOneShot(LaFiere_CraftSurviveComplete, 1)
		elseif Objective_IsStarted(OBJ_CraftSurvive) == true then
			Objective_Complete(OBJ_CraftSurvive, false)
		end
		
		Rule_AddInterval(LaFiere_C_MissionEnd,1)
		Rule_RemoveMe()
	end
		
	if Objective_IsFailed(OBJ_Survive) or Objective_IsFailed(OBJ_ATclear) or Objective_IsFailed(OBJ_Brae) or Objective_IsFailed(OBJ_Castle) and Event_IsAnyRunning()== false then
		local failString = 9419640
		Game_EndSP(false, failString)
	else
	
		if Objective_IsFailed(OBJ_AbleAndBakerSurvive) then
			
			local failString = 9419640	
			if SGroup_IsEmpty(sg_p1_able) then
				failString = 9419650
			elseif SGroup_IsEmpty(sg_p1_baker) then
				failString = 9419660
				
			end
		
			Game_EndSP(false, failString)
			
		elseif Objective_IsFailed(OBJ_CraftSurvive) then
		
			if SGroup_IsEmpty(sg_p1_craft) then			
				failstring = 9419664
			end
		
			Game_EndSP(false, failString)
			
		end
	end
	
end

function LaFiere_AbleAndBakerSurviveComplete()
	Objective_Complete(OBJ_AbleAndBakerSurvive, false)
end

function LaFiere_CraftSurviveComplete()
	Objective_Complete(OBJ_CraftSurvive, false)
end
