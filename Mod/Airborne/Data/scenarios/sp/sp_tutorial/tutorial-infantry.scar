--------------------------------------------------------------------------------
-- Lesson: Move Through Graveyard
--------------------------------------------------------------------------------
function Infantry_Graveyard_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryGraveyardIntro)
		
		Player_SetCommandAvailability(player1, SCMD_Move, ITEM_LOCKED)
		
		Rule_AddInterval(Infantry_Graveyard_GiveObjective, 0.5)
		
	end
	
end


function Infantry_Graveyard_GiveObjective()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_GRAVEYARD, false)
		
		if Misc_IsSGroupSelected(sg_playerunits, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryGraveyardGiveObjective)
			Camera_ClampToMarker(camera_infantry_b)
			EGroup_DeSpawn(LAYER_wall_infantry_1)
			
			flashid_infantry_attackmove = UI_FlashCommandButton(SCMD_AttackMove, false, BT_UI_Strong_CommandBtn )
			hpid_infantry_attackmove = HintPoint_AddToCommandButton(SCMD_AttackMove, 409273, false)
			
			OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, mkr_infantry_chapel, false, 409265, true)
			
			Rule_Add(Infantry_Graveyard_IsAttackMoving)
			
		else
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.ParatroopersSelect)
			
			OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, sg_playerunits, false, 409266, true)
			
			Rule_AddInterval(Infantry_Graveyard_AirborneSelected, 0.5)
			
		end
		
	end
	
end


function Infantry_Graveyard_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryGraveyardGiveObjective)
		Camera_ClampToMarker(camera_infantry_b)
		EGroup_DeSpawn(LAYER_wall_infantry_1)
		
		flashid_infantry_attackmove = UI_FlashCommandButton(SCMD_AttackMove, false, BT_UI_Strong_CommandBtn )
		hpid_infantry_attackmove = HintPoint_AddToCommandButton(SCMD_AttackMove, 409273, false)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
		OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, mkr_infantry_chapel, false, 409265, true)
		
		Rule_Add(Infantry_Graveyard_IsAttackMoving)
		
	end
	
end


function Infantry_Graveyard_IsAttackMoving()

	if SGroup_IsAttackMoving(sg_playerunits, ANY) then
		
		if SGroup_HasDestination(sg_playerunits, mkr_infantry_chapel, ANY) then
			
			Rule_RemoveMe()
			Game_SkipEvent()
			
			HintPoint_RemoveAll()
			UI_StopFlashing(flashid_infantry_attackmove)
			
			Player_SetCommandAvailability(player1, SCMD_Move, ITEM_DEFAULT)
			
			Camera_MoveToPosition(mkr_infantry_firstattacktrigger, true, SLOW_CAMERA_PANNING)
			Camera_SafetyDefault()
			
			Util_StartIntel(EVENTS.InfantryGraveyardAttackMoving)
			
			Rule_Add(Infantry_Graveyard_TriggerSkirmish)
			
		else
			
			Rule_RemoveMe()
			Game_SkipEvent()
			
			HintPoint_RemoveAll()
			UI_StopFlashing(flashid_infantry_attackmove)
			
			Cmd_Stop(sg_playerunits)
			
			Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
			Util_StartIntel(EVENTS.InfantryGraveyardWrongLocation)
			
			Rule_AddInterval(Infantry_Graveyard_GiveObjective, 0.5)
			
		end
		
		
	elseif Misc_IsSGroupSelected(sg_playerunits, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
		OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_Graveyard_AirborneSelected, 0.5)
		
	end
	
end


function Infantry_Graveyard_TriggerSkirmish()

	if Prox_AreSquadMembersNearMarker(sg_playerunits, mkr_infantry_firstattacktrigger, ANY) then
		
		Rule_RemoveMe()
		
		Cmd_AttackMove(sg_group5, mkr_infantry_firstattackdest)
		
		Util_StartIntel(EVENTS.InfantryGraveyardFirstAttack)
		
		Rule_Add(Infantry_Graveyard_SkirmishDone)
		
	end
	
end


function Infantry_Graveyard_SkirmishDone()

	if SGroup_Count(sg_group5) == 0 then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		Util_StartIntel(EVENTS.InfantryGraveyardFirstAttackKilled)
		
		Rule_AddInterval(Infantry_KillMortar_BeginLesson, 0.5)
		
	end
	
end




--------------------------------------------------------------------------------
-- Lesson: Kill Mortar Crew
--------------------------------------------------------------------------------
function Infantry_KillMortar_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		SGroup_SetAutoTargetting(sg_group1, "hardpoint_01", true)
		Cmd_Ability(player2, ABILITY.SP.MORTARSTRIKE, Marker_GetPosition(mkr_infantry_mortarstrike1))
		Cmd_Ability(sg_group1, ABILITY.AXIS.MORTAR_BARRAGE, Marker_GetPosition(mkr_infantry_mortarstrike5))
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryGraveyardUnderAttack)
		
		Player_GetAll(player1)
		SGroup_Filter(sg_allsquads, SBP.ALLIES.PARATROOPER, FILTER_KEEP)
		SGroup_AddGroup(sg_playerunits, sg_allsquads)
		
		Rule_AddOneShot(Infantry_KillMortar_Show, 7.5)
		
		Rule_AddOneShot(Infantry_KillMortar_Strike1, 2)
		Rule_AddOneShot(Infantry_KillMortar_Strike2, 5)
		
	end
	
end
function Infantry_KillMortar_Strike1()
	Cmd_Ability(player2, ABILITY.SP.MORTARSTRIKE, Marker_GetPosition(mkr_infantry_mortarstrike2))
end
function Infantry_KillMortar_Strike2()
	Cmd_Ability(player2, ABILITY.SP.MORTARSTRIKE, Marker_GetPosition(mkr_infantry_mortarstrike3))
end


function Infantry_KillMortar_Show()					-- fly camera over

	Objective_UpdateText(OBJ_INFANTRY_GRAVEYARD, 409202, 409203, false)
	
	Modify_Vulnerability(sg_group1, 1.8)
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryAttackMortarsIntro)
		
		SGroup_SetInvulnerable(sg_group1, false)
		
		FOW_RevealMarker(mkr_infantry_revealmortar, -1)
		Camera_MoveToPosition(mkr_infantry_revealmortar, true, SLOW_CAMERA_PANNING)
		Camera_SafetyDefault()
		
		Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
		OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, sg_group1, false, 409254, true)
		
		Rule_AddInterval(Infantry_KillMortar_Attacking, 0.5)
		
	else
		
		-- ask to select paratroopers
		Util_StartIntel(EVENTS.ParatroopersSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
		OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_KillMortar_AirborneSelected, 0.5)
		
	end
	
end


function Infantry_KillMortar_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryAttackMortarsIntro)
		
		SGroup_SetInvulnerable(sg_group1, false)
		
		FOW_RevealMarker(mkr_infantry_revealmortar, -1)
		Camera_MoveToPosition(mkr_infantry_revealmortar, true, SLOW_CAMERA_PANNING)
		Camera_SafetyDefault()
		
		Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
		OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, sg_group1, false, 409254, true)
		
		Rule_AddInterval(Infantry_KillMortar_Attacking, 0.5)
		
	end
	
end


function Infantry_KillMortar_Attacking()

	if SGroup_IsUnderAttackByPlayer(sg_group1, player1, 1) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		Util_StartIntel(EVENTS.InfantryAttackMortarsAttacking)
		
		Rule_Add(Infantry_KillMortar_Done)
		
	elseif Misc_IsSGroupSelected(sg_playerunits, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_GRAVEYARD, OBJ_INFANTRY_GRAVEYARD.PingID)
		OBJ_INFANTRY_GRAVEYARD.PingID = Objective_AddUIElements(OBJ_INFANTRY_GRAVEYARD, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_KillMortar_AirborneSelected, 0.5)
		
	end
	
end


function Infantry_KillMortar_Done()
	
	if SGroup_Count(sg_group1) == 0 then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		if SGroup_GetVeterancyRank(sg_playerunits) < 1 then
			SGroup_IncreaseVeterancyRank(sg_playerunits, 1)
		end
		
		local eid = SyncWeapon_GetEntity(infantry_mortar)
		if eid ~= nil then
			Entity_Kill(eid)
		end
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_GRAVEYARD, false)
		
		FOW_UnRevealMarker(mkr_infantry_revealmortar)
		
		Util_StartIntel(EVENTS.InfantryAttackMortarsDone)
		
		Rule_AddInterval(Infantry_Veterancy_Mention, 0.5)
		
	end
	
end


function Infantry_Veterancy_Mention()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		Util_StartIntel(EVENTS.InfantryAttackMortarsVeterancy)
		
		Rule_AddInterval(Infantry_KillHMG_BeginLesson, 0.5)
		
	end
	
end



--------------------------------------------------------------------------------
-- Lesson: Attack / Flank HMG Site
--------------------------------------------------------------------------------
function Infantry_KillHMG_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- change perimeters
		FOW_RevealMarker(mkr_infantry_revealhmg, -1)
		Camera_ClampToMarker(camera_infantry_c)
		Camera_MoveToPosition(mkr_infantry_revealhmg, true, SLOW_CAMERA_PANNING)
		Camera_SafetyDefault()
		EGroup_DeSpawn(LAYER_wall_infantry_2)
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryAttackHMGSpotted)
		
		Cmd_Move(sg_playerunits, mkr_infantry_prehmgdest)
		
		Rule_AddInterval(Infantry_KillHMG_GiveObjective, 0.5)
		
	end
	
end


function Infantry_KillHMG_GiveObjective()

	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_ATTACKHMG, false)
		
		
		if Misc_IsSGroupSelected(sg_playerunits, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryAttackHMGIntro)
			
			OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_group2, false, 409255, true)
			
			Rule_AddInterval(Infantry_KillHMG_Attacking, 0.5)
			
		else
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.ParatroopersSelect)
			
			OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_playerunits, false, 409266, true)
			
			Rule_AddInterval(Infantry_KillHMG_AirborneSelected, 0.5)
			
		end
		
	end
	
end


function Infantry_KillHMG_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
