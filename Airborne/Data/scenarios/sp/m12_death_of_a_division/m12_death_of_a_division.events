t_dp_kill = {320700, 320710, 320720, 320730, 320740, 320750}
EVENTS.OBJ_DP_PnthrDestroyed = function()
	local text = t_dp_kill[World_GetRand(1, table.getn(t_dp_kill))]
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, text)
	CTRL.WAIT()
end

EVENTS.FriendsDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraFriends, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
end

t_dp_kill_veh = {320400, 320410, 320420, 320430, 320441, 320451, 320461, 320466}
EVENTS.OBJ_DP_PnthrDestroyedVeh = function()
	local rand = World_GetRand(1, table.getn(t_dp_kill_veh))
	local text = t_dp_kill_veh[rand]
	table.remove(t_dp_kill_veh, rand)
	CTRL.Actor_PlaySpeech(ACTOR.Carota, text)
	CTRL.WAIT()
end


