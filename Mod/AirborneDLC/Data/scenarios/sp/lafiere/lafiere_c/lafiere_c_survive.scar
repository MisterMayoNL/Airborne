	eg_surv_traps = EGroup_CreateIfNotFound("eg_surv_traps")
	-- for clearing debris so NIS plays properly
	eg_surv_clear = EGroup_CreateIfNotFound("eg_suv_clear")
	-- in case retreat point does not exist
	eg_retreat_point = EGroup_CreateIfNotFound("eg_retreat_point")
	
	sg_surv_hmg = SGroup_CreateTable("sg_surv_hmg%d", 3)
	sg_surv_hmgAll = SGroup_CreateIfNotFound("sg_surv_hmgAll")
	sg_surv_def = SGroup_CreateTable("sg_surv_def%d", 5)
	sg_surv_defAll = SGroup_CreateIfNotFound("sg_surv_defAll")
	
	sg_surv_para = SGroup_CreateTable("sg_surv_para%d", 5)
	sg_surv_paraAll = SGroup_CreateIfNotFound("sg_surv_defAll")
	
	sg_p1_craft = SGroup_CreateIfNotFound("sg_p1_craft")
	sg_p1_able = SGroup_CreateIfNotFound("sg_p1_able")
	sg_p1_baker = SGroup_CreateIfNotFound("sg_p1_baker")
	
	sg_cleanup = SGroup_CreateIfNotFound("sg_cleanup")
	
	sg_surv_beginParas = SGroup_CreateTable("sg_surv_beginParas%d",4)
	
	
	
