-- INTEL INVENTS
--------------------------------------------------------------------------------
	
EVENTS.Opening = function() 
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1390670) CTRL.WAIT() 
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1390680) CTRL.WAIT() 
	CTRL.Event_Delay(0.1) CTRL.WAIT() 
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1390510) CTRL.WAIT() 
	CTRL.Event_Delay(0.5) CTRL.WAIT() 
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Wallis, 1390710) CTRL.WAIT() 
end
	
