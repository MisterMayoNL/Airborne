	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380235)		-- again... RSE, Defensive manuvers, secure perimeter around the Hill and the bridges... we have Panzers incoming!
	CTRL.WAIT()
end


