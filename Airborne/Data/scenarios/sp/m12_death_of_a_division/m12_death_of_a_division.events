--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- NIS 01
--------------------------------------------------------------------------------
EVENTS.NIS01 = function ()
	-- set speech and sfx volume groups to 0 so we don't hear any audio in between NIS and Sit Rep.  Sit Rep transition out will re-set volume groups.
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)

	
	CTRL.Game_Letterbox(true, 1)
		Game_FadeToBlack(FADE_IN, 1)
		FOW_Enable(false)
	CTRL.WAIT()
	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()

	nis_stop()
	
--	CTRL.Game_Letterbox(false, 1)
		
		-- temp fix for the NIS scripts
		EGroup_Hide(LAYER_N12_01_Unwanted_WO, false)
		Game_FadeToBlack(true, 1)
		FOW_Enable(true)
	CTRL.WAIT()
		
	-- set view
	Camera_MoveToPosition(mkr_player_start2)
	Camera_ResetToDefault()

end

--------------------------------------------------------------------------------
-- NIS 02
--------------------------------------------------------------------------------
EVENTS.MISSION_COMPLETE = function ()

	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	Game_FadeToBlack(FADE_OUT, 1.5)
	Sound_SetVolume("Speech", 0.0, 1.5)
	Sound_SetVolume("SFXmaster", 0.0, 1.5)
	CTRL.Event_Delay(2)
	
	CTRL.WAIT()
	CTRL.Event_Delay(1.5)
	Util_ClearWrecksFromMarker(mkr_nis02area)
	Util_ClearWrecksFromMarker(mkr_pnthr2_prox_lg)
	Util_HidePlayerForNIS(player1, true)
	Util_HidePlayerForNIS(player2, true)
	FOW_Enable(false)

	CTRL.WAIT()
	Game_FadeToBlack(FADE_IN, 1)
	
	World_ClearCasualties()
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()

	nis_stop()
	
	FOW_Enable(true)
	Util_HidePlayerForNIS(player1, false)
	Util_HidePlayerForNIS(player2, false)
	CTRL.WAIT()
	
	-- set view
	Game_EndSP(true)
end
