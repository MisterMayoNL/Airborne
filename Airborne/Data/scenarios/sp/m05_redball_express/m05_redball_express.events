--------------------------------------------------------------------------------
-- LANDMINES
--------------------------------------------------------------------------------

EVENTS.Landmines = function()

	CTRL.Game_Letterbox(true, 1)
		FOW_Enable(false)
		g_NISmineCam = Camera_GetTargetPos()
	CTRL.WAIT()
	
	Camera_ResetToDefault()
	Camera_ResetToDefault()
	if g_landmines_south then
		Camera_MoveToPosition(Marker_GetPosition(mkr_mines_south), true, SLOW_CAMERA_PANNING)
	else
		Camera_MoveToPosition(Marker_GetPosition(mkr_mines_north), true, SLOW_CAMERA_PANNING)
	end
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 200912)
	CTRL.WAIT()	
	if g_landmines_south then
		EGroup_Kill(eg_mines_south)
	else
		EGroup_Kill(eg_mines_north)
	end
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 200914)
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 200915)
	CTRL.WAIT()	
	
	CTRL.Game_Letterbox(false, 1)
		--[[ set view]]
		Camera_MoveToPosition(g_NISmineCam, true, SLOW_CAMERA_PANNING)
		FOW_Enable(true)
	CTRL.WAIT()

end







