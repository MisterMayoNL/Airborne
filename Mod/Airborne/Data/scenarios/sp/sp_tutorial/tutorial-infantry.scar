function Infantry_Upgrade_IsUpgrading()
	
	if SGroup_IsUpgrading(sg_group1, UPG.ALLIES.PARATROOPER_AT, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		UI_StopFlashing(flashid_infantry_upgrade)
		
		Util_StartIntel(EVENTS.InfantryUpgradeUpgrading)
		
		Rule_AddInterval(Infantry_Upgrade_Done, 0.5)
		
	elseif	Misc_IsSGroupSelected(sg_group1, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		OBJ_INFANTRY_UPGRADE.PingID = Objective_AddUIElements(OBJ_INFANTRY_UPGRADE, sg_group1, false, 409266, true)
		
		Rule_AddInterval(Infantry_Upgrade_AirborneSelected, 0.5)
		
	end
	
end


function Infantry_Upgrade_Done()
	
	if SGroup_HasUpgrade(sg_group1, UPG.ALLIES.PARATROOPER_AT, ANY) then
		
		Rule_RemoveMe()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_UPGRADE, false)
		HintPoint_RemoveAll()
		
		Util_StartIntel(EVENTS.InfantryUpgradeDone)
		Rule_AddInterval(Infantry_AttackBarn_BeginLesson, 0.5)
		
	end
	
end




--------------------------------------------------------------------------------
-- Lesson: Attack Barn
--------------------------------------------------------------------------------
function Infantry_AttackBarn_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- create the enemy
		Util_CreateSquads(player2, sg_group4, SBP.AXIS.HEAVYMG_SP_NOSUP, eg_infantry_barn, nil, 1)
		
		-- change perimeters
		FOW_RevealMarker(mkr_infantry_revealbarn, -1)
		Camera_MoveToPosition(mkr_infantry_revealbarn, true, SLOW_CAMERA_PANNING)
		Camera_SafetyDefault()
		EGroup_DeSpawn(LAYER_wall_infantry_4)
		
		Player_SetAbilityAvailability(player1, ABILITY.ALLIES.SATCHEL_CHARGE, ITEM_UNLOCKED)
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryAttackBarnIntro)
		
		Objective_Start(OBJ_INFANTRY_ATTACKBARN, false)
		Rule_AddInterval(Infantry_AttackBarn_Done, 0.5)
		
	end
	
end


function Infantry_AttackBarn_Done()
	
	if Player_OwnsEGroup(player2, eg_infantry_barn) == false then
		
		Rule_RemoveMe()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_ATTACKBARN, false)
		HintPoint_RemoveAll()
		
		Util_StartIntel(EVENTS.InfantryAttackBarnDone)
		Rule_AddInterval(Infantry_TutorialComplete, 0.5)
		
	end
	
end


function Infantry_CheckSquad()
	if SGroup_TotalMembersCount(sg_playerunits) <= 4 then
		Rule_RemoveMe()
		SGroup_SetInvulnerable(sg_playerunits, true)
	end
end


--------------------------------------------------------------------------------
-- Closing
--------------------------------------------------------------------------------
function Infantry_TutorialComplete()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		PlayerProfile_SetVar("InfantryTutorial_Completed", "true")
		Rule_AddOneShot(Infantry_EndTutorial, 5)
		
	end
	
end




--------------------------------------------------------------------------------
-- End the tutorial and return to the courtyard
--------------------------------------------------------------------------------
function Infantry_EndTutorial()

	Rule_RemoveAll(0)
	Game_SkipAllEvents(true)
	
	Infantry_CleanUp()
	Courtyard_Start()

end

function Infantry_CleanUp()

	HintPoint_RemoveAll()
	SelectionCheck_Stop()
	
	-- stop everything
	Player_GetAll(player1)
	Cmd_Stop(eg_allentities)
	Cmd_Stop(sg_allsquads)

	FOW_UnRevealMarker(mkr_infantry_revealparadrop)
	FOW_UnRevealMarker(mkr_infantry_revealmortar)
	FOW_UnRevealMarker(mkr_infantry_revealhmg)
	FOW_UnRevealMarker(mkr_infantry_revealcounterattack)
	FOW_UnRevealMarker(mkr_infantry_revealbarn)
	
	Player_SetAbilityAvailability(player1, ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_PARADROP, ITEM_LOCKED)
	Player_SetUpgradeAvailability(player1, UPG.ALLIES.PARATROOPER_AT, ITEM_LOCKED)
	Player_SetAbilityAvailability(player1, ABILITY.ALLIES.GRENADE, ITEM_LOCKED)
	Player_SetAbilityAvailability(player1, ABILITY.ALLIES.SATCHEL_CHARGE, ITEM_LOCKED)
	Player_SetCommandAvailability(player1, SCMD_Capture, ITEM_LOCKED)
	
	Misc_RemoveCommandRestriction()
	
	-- revert all territories
	EGroup_SetStrategicPointNeutral(eg_vp_infantry)
	
	-- remove all the units spawned for this tutorial
	SGroup_DestroyAllSquads(sg_playerunits)
	SGroup_DestroyAllSquads(sg_engineer)
	SGroup_DestroyAllSquads(sg_friends)
	SGroup_DestroyAllSquads(sg_convoy)
	SGroup_DestroyAllSquads(sg_group1)
	SGroup_DestroyAllSquads(sg_group2)
	SGroup_DestroyAllSquads(sg_group3)
	SGroup_DestroyAllSquads(sg_group4)
	SGroup_DestroyAllSquads(sg_group5)
	SGroup_DestroyAllSquads(sg_group6)
	SGroup_DestroyAllSquads(sg_group7)
	SGroup_DestroyAllSquads(sg_group8)
	SGroup_DestroyAllSquads(sg_group9)
	SGroup_DestroyAllSquads(sg_allsquads)

	
	-- remove all the objectives used in this tutorial
 	Objective_Show(OBJ_INFANTRY_PARATROOPERS, false)
 	Objective_Show(OBJ_INFANTRY_LIGHTCOVER, false)
 	Objective_Show(OBJ_INFANTRY_HEAVYCOVER, false)
 	Objective_Show(OBJ_INFANTRY_GRAVEYARD, false)
 	Objective_Show(OBJ_INFANTRY_KILLMORTAR, false)
 	Objective_Show(OBJ_INFANTRY_ATTACKHMG, false)
 	Objective_Show(OBJ_INFANTRY_PICKUP, false)
 	Objective_Show(OBJ_INFANTRY_SETFACING, false)
 	Objective_Show(OBJ_INFANTRY_CAPTURE, false)
 	Objective_Show(OBJ_INFANTRY_UPGRADE, false)
 	Objective_Show(OBJ_INFANTRY_ATTACKBARN, false)

	-- remove any titlecards
	if screen_redshield ~= nil then
		Misc_ScreenFadeChange(screen_redshield, 0.0, 0.0, 0.1)
	end
	if screen_veteran ~= nil then
		Misc_ScreenFadeChange(screen_veteran, 0.0, 0.0, 0.1)
	end
	if screen_weaponupgrade ~= nil then
		Misc_ScreenFadeChange(screen_weaponupgrade, 0.0, 0.0, 0.1)
	end
	
	-- remove any perimeters
	EGroup_DeSpawn(LAYER_perimeter_infantry)
	EGroup_DeSpawn(eg_infantry_facingdirection)
	EGroup_DeSpawn(eg_infantry_hmgpen)	
	
end





