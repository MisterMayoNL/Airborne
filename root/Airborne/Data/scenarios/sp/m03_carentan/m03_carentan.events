function NIS_Init()
	NIS01 = "sp/M03_Carentan/NIS/N03_01"
	nis_load(NIS01)	
	NIS02 = "sp/M03_Carentan/NIS/N03_02"
	nis_load(NIS02)	

	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)
end

Scar_AddInit(NIS_Init)

	
EVENTS = {}

EVENTS.NIS01 = function()
	FOW_RevealMarker(Marker_AbleCompanySpawn, -1)
	Game_Letterbox(true, 0)
	Game_FadeToBlack(FADE_IN, 2)
	FOW_Enable(false)
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()
	nis_stop()	
	MG42CafeNormandie1 = SGroup_CreateIfNotFound("MG42CafeNormandie1")
	Util_CreateSquads(player2, MG42CafeNormandie1, SBP.AXIS.HEAVYMG_M03, Blg_CafeNormandie)
	SGroup_SetInvulnerable(MG42CafeNormandie1, true)
	MG42CafeNormandie2 = SGroup_CreateIfNotFound("MG42CafeNormandie2")
	Util_CreateSquads(player2, MG42CafeNormandie2, SBP.AXIS.GRENADIER, Blg_CafeNormandie, nil, 1, 2)
	SGroup_SetInvulnerable(MG42CafeNormandie2, true)
	Game_Letterbox(false, 0.75)
	Game_FadeToBlack(false, 0.75)
	Camera_ResetToDefault()
	Camera_ResetToDefault()
	--Scar_Autosave(239050) 
end

joey_dead = {212037, 212040, 212053, 212065}
EVENTS.JoeyDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraJoey, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(0.65)
	CTRL.WAIT()
	local text = joey_dead[World_GetRand(1, table.getn(joey_dead))]
	CTRL.Actor_PlaySpeech(ACTOR.Lewis, text)
	CTRL.WAIT()
	CTRL.Event_Delay(0.25)
	CTRL.WAIT()
end

EVENTS.CafeNormandieStart = function()
	UI_FlashAbilityButton(ABILITY.ALLIES.SATCHEL_CHARGE, true, BT_UI_Weak_CommandBtn )
	--CTRL.Util_MissionTitle(239910)											-- New Primary Objective: Destroy Cafe Normandie
	--CTRL.WAIT()
--~ 	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 230120)						-- Shelby get that B.A.R going, keep their heads down!
--~ 	CTRL.WAIT()
	FOW_RevealMarker(Marker_Start1, -1)
	CTRL.Actor_PlaySpeech(ACTOR.Lewis, 230151)						-- They've sighted the road, take cover!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 230130)						-- Find some cover...we're taking enfilade fire!
	CTRL.WAIT()
--~ 	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 230140)						-- NOW MOVE IT DAMN IT!
--~ 	CTRL.WAIT()
--~		CTRL.Actor_PlaySpeech(ACTOR.Carota, 230160)						-- Get some suppressing fire going!
--~		CTRL.WAIT()
--~ 	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 230170)						-- DON'T STOP , DON'T STOP... KEEP MOVING UP.
--~ 	CTRL.WAIT()
--~ 	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 230170)						-- DON'T STOP , DON'T STOP... KEEP MOVING UP.
--~ 	CTRL.WAIT()
--~ 	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 230250)						-- Get to the intersection.
--~ 	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 230270)						-- Get Satchel Charges in that building.  
	CTRL.WAIT()
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Lewis, 230171)						-- Don't stop don't stop - keep moving up!  
	CTRL.WAIT()
	
end

