end


EVENTS.AxisHQ_Complete = function()
	if g_navalguns_complete == false then
		--CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 260661)
			Objective_Complete(OBJ_NavalGuns)
		--CTRL.WAIT()	
	end
	CTRL.Actor_PlaySpeech(ACTOR.McKay, 260650)
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.McKay, 260660)
	CTRL.WAIT()	
	
	-- variable delay for the sake of the end NIS
	CTRL.Event_Delay(3)
	CTRL.WAIT()	
end

