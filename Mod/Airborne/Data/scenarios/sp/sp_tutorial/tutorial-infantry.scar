-------------------------------------------------------------------------
-------------------------------------------------------------------------
--
-- Script File for TUTORIAL - INFANTRY section
--
-------------------------------------------------------------------------
-------------------------------------------------------------------------



--------------------------------------------------------------------------------
-- Initialisation and Setup
--------------------------------------------------------------------------------
function Infantry_Init()

	Infantry_RegisterObjectives() -- see end of file
	
end



--------------------------------------------------------------------------------
-- Start Tutorial
--------------------------------------------------------------------------------
function Infantry_Start()

	-- clean up from the menu
	Rule_RemoveAll(0)
	HintPoint_RemoveAll()
	Game_SkipAllEvents(true)
	UI_ClearEventCues()
	
	tutorial_infantry_available = false
	tutorial_currentsection = "infantry"
	TutorialMenu_UpdateAvailability()
	
	Camera_SetInputEnabled(false)
	Game_FadeToBlack(FADE_OUT, TIMING_FADE_OUT)
	
	-- do the title card
	Game_TextTitleFade(409910, TIMING_FADE_IN, 3, TIMING_FADE_OUT, "" )
	
	Rule_AddOneShot(Infantry_StartB, 3+TIMING_FADE_IN)
	
end
function Infantry_StartB()

	-- clean up player units
	Player_GetAll(player1)
	SGroup_DestroyAllSquads(sg_allsquads)
	Player_GetAll(player5)
	SGroup_DestroyAllSquads(sg_allsquads)
	Player_GetAll(player6)
	SGroup_DestroyAllSquads(sg_allsquads)
	
	-- switch to the Allied player
	Game_SetLocalPlayer(player1)

	Rule_AddOneShot(Infantry_StartC, 0.5)
	
end
function Infantry_StartC()

	-- reload taskbar for bindings that have been disabled
	UI_LoadTaskbar("taskbar.lua")
	Rule_AddOneShot(RedoBindings, 0.1)
	
	Game_SetMode(UI_Normal)
	Game_FadeToBlack(FADE_IN, TIMING_FADE_IN)
	Game_Letterbox(false, 0)
	
	-- camera clamping
	Camera_ClampToMarker(mkr_infantry_paradrop1)
	Camera_MoveToPosition(mkr_infantry_paradrop1)
	Camera_ResetToDefault()
	
	-- bring up the perimeter
	EGroup_ReSpawn(LAYER_perimeter_infantry)
	EGroup_ReSpawn(LAYER_wall_infantry_1)
	EGroup_ReSpawn(LAYER_wall_infantry_2)
	EGroup_ReSpawn(LAYER_wall_infantry_3)
	EGroup_ReSpawn(LAYER_wall_infantry_4)
	
	-- create all the relevant units
	Util_CreateSquads(player2, sg_group1, SBP.AXIS.MORTAR, mkr_infantry_mortarspawn, nil, 1)
 	Util_CreateSquads(player2, sg_group2, SBP.AXIS.HEAVYMG_SP_NOSUP, mkr_infantry_hmgspawn, nil, 1)
	Util_CreateSquads(player2, sg_group5, SBP.AXIS.VOLKSGRENADIER, mkr_infantry_firstattackspawn, nil, 1, 3)
	Cmd_InstantSetupTeamWeapon(sg_group1, true)
	Cmd_InstantSetupTeamWeapon(sg_group2, true)	
	Modify_Vulnerability(sg_group1, 1.7)
	Modify_Vulnerability(sg_group5, 2.3)
	Modify_Vulnerability(sg_playerunits, 0.7)
	SGroup_SetAutoTargetting(sg_group1, "hardpoint_01", false)
	SGroup_SetInvulnerable(sg_group1, true)
	SGroup_SetInvulnerable(sg_group2, true)
	SGroup_SetTeamWeaponCapturable(sg_group1, false)
	
	-- ensure there are enough resources
	Player_SetResource(player1, RT_Manpower, 1000)
	Player_SetResource(player1, RT_Munition, 1000)
	Player_SetResource(player1, RT_Fuel, 1000)
	--Player_SetMaxPopulation(player1, CT_Personnel, 21)
	
	FOW_RevealMarker(mkr_infantry_revealparadrop, -1)
	
	-- enable cover previews from now on
	UI_CoverPreviewShow()
	PlayerProfile_SetVar("Tutorial_EnableCoverIndicators", "true")
	
	-- give the introductory talk
	Util_StartIntel(EVENTS.InfantryIntro)
	
	Rule_AddInterval(Infantry_StartD, 0.5)
	
end
function Infantry_StartD()

	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryIntro2)
		
		SGroup_SnapFacePosition(sg_group2, Marker_GetPosition(mkr_infantry_hmgfacing))
		infantry_hmg = SyncWeapon_GetFromSGroup(sg_group2)
		
		infantry_mortar = SyncWeapon_GetFromSGroup(sg_group1)
		
		-- start lesson 1 when ready
		Rule_AddInterval(Infantry_Paratroopers_BeginLesson, 0.5)
		
	end
	
end




--------------------------------------------------------------------------------
-- Lesson: Bring in Paratroopers
--------------------------------------------------------------------------------
function Infantry_Paratroopers_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_PARATROOPERS, false)
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryParatroopersIntro)
		Player_SetAbilityAvailability(player1, ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_PARADROP, ITEM_UNLOCKED)
		--Misc_RestrictCommandsToMarker(mkr_infantry_revealparadrop) --~ Range should be 18/15
		Misc_RestrictCommandsToMarker(mkr_infantry_paradrop1)
		
		Rule_AddOneShot(Infantry_Paratroopers_BeginLessonB, 0.1)
		Rule_AddInterval(Infantry_Paratroopers_Done, 0.5)
		
	end
	
end
function Infantry_Paratroopers_BeginLessonB()
	flashid_infantry_paradrop = UI_FlashAbilityButton(ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_PARADROP, true, BT_UI_Strong_AbilityBtn )
	HintPoint_AddToAbilityButton(ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_PARADROP, 409270, true)
end


function Infantry_Paratroopers_Done()
	
	Player_GetAll(player1)
	SGroup_Filter(sg_allsquads, SBP.ALLIES.PARATROOPER, FILTER_KEEP)
	
	if SGroup_Count(sg_allsquads) >= 1 then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_PARATROOPERS, false)
		UI_StopFlashing(flashid_infantry_paradrop)
		HintPoint_RemoveAll()
		FOW_UnRevealMarker(mkr_infantry_revealparadrop)
		
		SGroup_AddGroup(sg_playerunits, sg_allsquads)
		
		Camera_SetInputEnabled(true)
		Camera_ClampToMarker(camera_infantry_a)
		Misc_RemoveCommandRestriction()
		
		Util_StartIntel(EVENTS.InfantryParatroopersComingIn)
		Util_StartIntel(EVENTS.InfantryParatroopersDone)
		Player_SetAbilityAvailability(player1, ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_PARADROP, ITEM_DEFAULT)
		Rule_AddInterval(Infantry_LightCover_BeginLesson, 0.5)
		
	end
	
end




--------------------------------------------------------------------------------
-- Lesson: Move To Light Cover
--------------------------------------------------------------------------------
function Infantry_LightCover_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_LIGHTCOVER, false)
		
		Player_GetAll(player1)
		SGroup_Filter(sg_allsquads, SBP.ALLIES.PARATROOPER, FILTER_KEEP)
		SGroup_AddGroup(sg_playerunits, sg_allsquads)
		
		Rule_Add(Infantry_CheckSquad)
		
		if Misc_IsSGroupSelected(sg_playerunits, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryLightCoverIntro)
			
			Camera_MoveToPosition(camera_infantry_light, true, SLOW_CAMERA_PANNING)
			Camera_SafetyDefault()
			
			OBJ_INFANTRY_LIGHTCOVER.PingID = Objective_AddUIElements(OBJ_INFANTRY_LIGHTCOVER, mkr_infantry_lightcover, false, 409251, true)
			
			SelectionCheck_Start()
			
			Rule_AddInterval(Infantry_LightCover_IsMoving, 0.5)
			
		else
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.ParatroopersSelect)
			
			OBJ_INFANTRY_LIGHTCOVER.PingID = Objective_AddUIElements(OBJ_INFANTRY_LIGHTCOVER, sg_playerunits, false, 409266, true)
			
			Rule_AddInterval(Infantry_LightCover_AirborneSelected, 0.5)
			
		end
		
	end
	
end


function Infantry_LightCover_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryLightCoverIntro)
		
		Camera_MoveToPosition(camera_infantry_light, true, SLOW_CAMERA_PANNING)
		Camera_SafetyDefault()
		
		Objective_RemoveUIElements(OBJ_INFANTRY_LIGHTCOVER, OBJ_INFANTRY_LIGHTCOVER.PingID)
		OBJ_INFANTRY_LIGHTCOVER.PingID = Objective_AddUIElements(OBJ_INFANTRY_LIGHTCOVER, mkr_infantry_lightcover, false, 409251, true)
		
		SelectionCheck_Start()
		
		Rule_AddInterval(Infantry_LightCover_IsMoving, 0.5)
		
	end
	
end


function Infantry_LightCover_IsMoving()

	if SGroup_IsMoving(sg_playerunits, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		Util_StartIntel(EVENTS.InfantryLightCoverMoving)
		
		Rule_AddInterval(Infantry_LightCover_Done, 0.5)
		
	elseif Misc_IsSGroupSelected(sg_playerunits, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_LIGHTCOVER, OBJ_INFANTRY_LIGHTCOVER.PingID)
		OBJ_INFANTRY_LIGHTCOVER.PingID = Objective_AddUIElements(OBJ_INFANTRY_LIGHTCOVER, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_LightCover_AirborneSelected, 0.5)
		
	end

end


function Infantry_LightCover_Done()
	
	if Prox_ArePlayerMembersNearMarker(player1, mkr_infantry_lightcover, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_LIGHTCOVER, false)
		HintPoint_RemoveAll()
		
		Util_StartIntel(EVENTS.InfantryLightCoverDone)
		Rule_AddInterval(Infantry_HeavyCover_BeginLesson, 0.5)
		
	end
	
end




