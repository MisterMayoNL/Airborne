			Objective_RemoveUIElements(OBJ_Medal_Bridge, medal_ui_tourmau_bridge)
			medal_ui_tourmau_bridge = false
			
		end
		
		
	end
end



-----------------------------------------------------------------------------------
-- Tactical Event Speech
-----------------------------------------------------------------------------------


-- this function checks if the player is losing a point and plays speech if they are
function Event_Losing_Point()
	
	if Objective_IsComplete(OBJ_Defend) then
		Rule_RemoveMe()
	else
	
		for k, this in pairs(t_points) do
		
			EGroup_IsCapturedByPlayer(this.egroup, player1, ANY)
			
			local current_owner = Util_GetPlayerOwner(this.egroup)
			
			-- if the point has been taken from the player, play the speech
			if this.owner == player1 and current_owner ~= this.owner then
				Util_StartIntel(EVENTS.Losing_Points)
				this.owner = current_owner
			
			elseif this.owner ~= current_owner then
				this.owner = current_owner
			end
		end
	end
end

-- this function plays speech if the Axis are pushing up the left side of the hill
function Event_Left_Flank()

	if Objective_IsComplete(OBJ_Defend) then
		Rule_RemoveMe()
	else
		
		if (World_GetGameTime() - last_left_flank_warning) >= 90 then		-- check that at least 90 secs has passed since the last warning
			
			local flag = false
			
			SGroup_Clear(sg_temp)
			Player_GetAllSquadsNearMarker(player2, sg_temp, sectorid_hill_1)
			if SGroup_IsUnderAttack(sg_temp, ANY, 10) then
				flag = true
			end
			
			SGroup_Clear(sg_temp)
			Player_GetAllSquadsNearMarker(player2, sg_temp, sectorid_hill_2)
			if SGroup_IsUnderAttack(sg_temp, ANY, 10) then
				flag = true
			end
			
			if flag == true then
				
				last_left_flank_warning = World_GetGameTime()
				Util_StartIntel(EVENTS.Left_Flank)
				
			end
			
		end
		
	end
	
end

