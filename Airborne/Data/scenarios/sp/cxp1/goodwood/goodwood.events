--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- NIS File for Goodwood
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

function NIS_Init()

	-- load NIS's
	NIS01 = "sp/CXP1/Goodwood/NIS/N09_01"
	nis_load(NIS01)
	NIS02 = "sp/CXP1/Goodwood/NIS/N09_02"
	nis_load(NIS02)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)





EVENTS = {}


--------------------------------------------------------------------------------
-- Opening Cinematic (NIS01)
--------------------------------------------------------------------------------

EVENTS.NIS01 = function()

	Game_Letterbox(true, 0)
	FOW_Enable(false)
	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()
	
	nis_stop()
	
	print("Test")
	
	FOW_Enable(true)
	--[[Game_Letterbox(false, 2)
	Game_FadeToBlack(false, 2)
	]]
end

EVENTS.GlennDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraGlenn, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
end

--------------------------------------------------------------------------------
-- Closing Cinematic (NIS02)
--------------------------------------------------------------------------------

EVENTS.NIS02 = function()

	CTRL.Game_Letterbox(true, 2)
	CTRL.WAIT()
	
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()
	
	nis_stop()
	
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)
	Sound_SetVolume("Music", 0.0, 0)
	
	Game_BlockTextClear()
	Game_BlockTextAdd(1309180)
	Game_BlockTextAdd(1309181)
	CTRL.Game_BlockTextFade( 2, 8, 1 )
	CTRL.WAIT()
	
	Game_BlockTextClear()
	Game_BlockTextAdd(1309182)
	Game_BlockTextAdd(1309183)
	CTRL.Game_BlockTextFade( 1, 10, 1 )
	CTRL.WAIT()
	
	Game_BlockTextClear()
	Game_BlockTextAdd(18501030)
	Game_BlockTextAdd(18501040)
	CTRL.Game_BlockTextFade( 1, 10, 1 )
	CTRL.WAIT()
	
	CTRL.Event_Delay(2)
	CTRL.WAIT()

end


