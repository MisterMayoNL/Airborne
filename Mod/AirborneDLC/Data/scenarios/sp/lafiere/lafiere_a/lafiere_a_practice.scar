-------------------------------------------------------------------------
-- Objective Name 
-------------------------------------------------------------------------
-- Short descriptive name of what the player is cht_eventsed to do
-- give a brief description of win conditions and loose conditions if any 
-- also describe the kind of challenges the player will face
-------------------------------------------------------------------------
function Initialize_OBJ_Practice()

	OBJ_Practice = {
		
		SetupUI = function() 
			-- mark a point or position
			--OBJ_Practice.mapElementID = Objective_AddUIElements(OBJ_Practice, t_practice.rally_point1, true, LOC("Rally With Baker"), true)
		end,
		
		OnStart = function()
			Sound_PlayMusic("Music/DLC/Causeway/LaFiere_A/LFA_Phase_1.bsc",2,0)
			--Game_LoadAtmosphere("data:art/scenarios/presets/atmosphere/LA_FIERE_PREDAWN_00.APS", 30)
			-- announce the goal
			--Util_AutoIntel(t_practice.events.A_intro)
			
			-- win/lose check
			Rule_AddInterval(Practice_Rule_WinCheck, 3)
			
			-- start related action
			Practice_Kickoff()
			-- EncounterName_Kickoff()
			
		end,
		
		OnComplete = function()
			
			-- tell the player they did good
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 9419020, -- "Rally with Baker Company"
		Description = 9419030, -- "Meet up with Sgt. Craft and Baker Company prior to assaulting the Manor."
		TitleEnd = 9419000, -- "Locate Baker"
		Type = OT_Primary,
		
--~ 		SitRep = {}, -- only needed once the SitRep is created and there are lines of dialogue.
	}
	
	-- Register Objective
	Objective_Register(OBJ_Practice)
	
	-- Initialize Data
	Practice_Init()
	
end

Scar_AddInit(Initialize_OBJ_Practice)

-------------------------------------------------------------------------
-- Objective Name - Functions 
-------------------------------------------------------------------------

-- 'Init()' is used to initialize the Obj data
-- anything that needs to be there for the Obj to work
-- does not need to be called at 'OnInit()'
function Practice_Init()
	
	-- fix camera
	Camera_SetDefault(30, 43, 55)
	Camera_ResetToDefault()
	
	-- define sgroups, egroups, etc associated with this obj
	sg_p1_able = SGroup_CreateIfNotFound("sg_p1_able")
	sg_p1_baker = SGroup_CreateIfNotFound("sg_p1_baker")
	sg_p1_all = SGroup_CreateIfNotFound("sg_p1_all")
	sg_p1_range = SGroup_CreateIfNotFound("sg_p1_range")
	sg_gm_patrol = SGroup_CreateIfNotFound("sg_gm_patrol")
	sg_pracAttacker = SGroup_CreateIfNotFound("sg_pracAttacker")
	sg_railHMG = SGroup_CreateIfNotFound("sg_railHMG")
	sg_mudGuard = SGroup_CreateTable("sg_mudGuard%d", 4)
	sg_mudGuardAll = SGroup_CreateIfNotFound("sg_mudGuardAll")
	
	g_SuppressTimer = ""
	
	g_suicideRun = false
	g_ableReceiveDmg = false
	
	if Misc_IsCommandLineOptionSet("test_objectives") then
--~ 		Scar_DebugConsoleExecute("bind([[ALT+1]], [[Scar_DoString('Util_StartNIS(EVENTS.NIS01)')]])")		
	end
	
	if EGroup_IsEmpty(eg_practice1) == false then
		
	end
	
    t_practice = {
		fg_ax_all_dead 			= false,			-- flag to indicate that all the axis units are dead
		fg_ax_all_retreated 	= false,			-- flag to check whether all the axis units have retreated
		rally_point = mkr_chefRoad8,
		range = 40,
		able_arrive = false,
		baker_arrive = false,
		rally_point1 = mkr_railHMG_trig,
	}
	
	if EGroup_IsEmpty(eg_practice1) == false then
		t_practice.rally_point2 = EGroup_GetPosition(eg_practice1)
	end
	
	-- set up intel event tables
	t_practice.events = {
		A_intro = {
			{ACTOR.LA_FIERE.Wilson, 9410238}, -- There's the Manor up ahead . . .
			{ACTOR.LA_FIERE.Wilson, 9410239}, -- Where the Hell is Baker?
		},		
		A_moveOut = {
			{ACTOR.LA_FIERE.Wilson, 9410180}, -- Keep your eyes peeled for Baker squad.
		},		
		A_hmgSpotted = {
			{ACTOR.LA_FIERE.Binko, 9410231}, -- You think Baker Company even made the jump?
		},		
		A_hmgPinned = {
			{ACTOR.LA_FIERE.Wilson, 9410530}, -- Kraut ambush! Get down!
		},		
		B_intro = {
			{ACTOR.LA_FIERE.Craft, 9410540}, -- Machine gun fire. Keep low Baker. 
			{ACTOR.LA_FIERE.Craft, 9410550}, -- Oh shit! They got Able pinned down!
			
		},
		
		B_wilsonMad = {
			{ACTOR.LA_FIERE.Wilson, 9410560}, -- What the hell were you waitin’ for Craft, an invitation? Now get your squad together.
		
		},
		
		B_suppression = {
			{ACTOR.LA_FIERE.Craft, 9410730}, -- Suppressing fire.  Pour it on!
		
		},
	}

	-- call preset
	Practice_Preset()
	NIS02 = "sp/LaFiere/NIS/N01_02"
	nis_load(NIS02)

end

-- preset any units or events needed before the kickoff, but you do not
-- want them to occur at the outset of the map.
-- Example: Often units are needed to exist before the objective start (because they start the objective)
-- then spawn those units here when they need to be spawned
function Practice_Preset()

	-- spawn squads
	--[[ start Baker
	Util_CreateSquads(player1, sg_p1_baker, SBP.LA_FIERE.ALLIES.BAKER, mkr_p1_start, nil, 1, 6, false, dest_facing, nil, mkr_p1_goto)
	Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_baker, 1), 2)
	]]
	--Util_CreateSquads(player1, sg_p1_able, SBP.LA_FIERE.ALLIES.ABLE, mkr_able_start, nil, 1, 4, false, mkr_able_goto, nil, mkr_able_start)
	-- brw, vulnerability already modifies received damage, don't need to modify it twice
	--LaFiere_CompanyBias(sg_p1_able, 1, 1, 2.5, .65, 1)
	--Practice_StartWalking()
	
	-- start enemy behavior
	Practice_GermanMudSetup()
	
	-- do other cool things
	

end


	
function Practice_StartWalking()
	-- action that starts with the Obj being granted
	--Cmd_Move(sg_p1_baker, mkr_p1_goto, NO_QUEUE, NIL_DELETE, NIL_FACE, NIL_OFFSET, NIL_DIST, 5)
	Cmd_Move(sg_p1_able, mkr_able_goto, NO_QUEUE, NIL_DELETE, NIL_FACE, NIL_OFFSET, NIL_DIST, 5)
	-- Camera_FollowSGroup(sg_p1_able)
end

-- example of how to finish an Obj
function Practice_Rule_WinCheck()
	
	-- one of them must be set to true before the player can win or lose the objective
	if t_practice.rally_done then
		
		-- the player has just won
		Objective_Complete(OBJ_Practice)
		
		
		Rule_RemoveMe()
		
	elseif SGroup_IsEmpty(sg_p1_able) 
	--or (t_practice.able_arrive == true and (SGroup_IsEmpty(sg_p1_able) or SGroup_IsEmpty(sg_p1_baker))) then
	or ((t_practice.baker_arrive == true) and (SGroup_IsEmpty(sg_p1_able) or SGroup_IsEmpty(sg_p1_baker))) then
		-- the player has just failed
		Objective_Fail(OBJ_Practice)
		
		Rule_RemoveMe()
		
	end
	
end

function Practice_Debug()

	-- add in the necessary information that can automatically start this objective 
	-- with the press of a hotkey
	Objective_Start(OBJ_Practice)

end


-- start the related action
function Practice_Kickoff()

	Rule_AddDelayedInterval(Practice_Hint, 5, 1)
	

end


-----------------------------------------------------
--[[ OPELS STUCK IN THE MUD ]]
-----------------------------------------------------


function Practice_GermanMudSetup()
	if SGroup_IsEmpty(sg_mudOpelAll) == false then
		-- muck with the Opels speed?
		Modify_UnitSpeed(sg_mudOpelAll, .1)
		Modify_Vulnerability(sg_mudOpelAll, 10)
		-- create some volks to deal with the Opels
		local pos = {mkr_mudRoad1, mkr_mudRoad2, mkr_mudRoad3}
		for i = 1, 3 do 
			sgroup = sg_mudGuard[i]
			LaFiere_CreateVolks(player3, sgroup, mkr_mapEntry5)
			SGroup_AddGroup(sg_mudGuardAll, sgroup)
			LaFiere_MoveCover(sgroup, pos[i], 5)
			-- make them really fragile
			Modify_Vulnerability(sgroup, 3)
			Modify_WeaponAccuracy(sgroup, "hardpoint_01", .1)
		end
		
	end
end

-- issue the objective and hint direction 
function Practice_Hint()
	if Event_IsAnyRunning() == false then
		
		-- move out
		Rule_AddOneShot(Practice_MoveOutDelay, 2)
		
		Misc_SelectSquad(SGroup_GetSpawnedSquadAt(sg_p1_able, 1), true)
		Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_able, 1), 1)
		
		if SGroup_IsEmpty(sg_p1_able) == false then
			
			SGroup_AddGroup(sg_p1_overgroup, sg_p1_able)
			
		end
		
		RPGTracker_SetSGroup(sg_p1_overgroup) 
		
		
		-- hint
		OBJ_Practice.mapElementID = Objective_AddUIElements(OBJ_Practice, t_practice.rally_point1, true, 9419000, true) -- Rally With Baker 9390240 9419640
		Objective_SetAlwaysShowDetails(OBJ_Practice, true, true, false)
		
		Rule_AddDelayedInterval(Practice_MudAmbush1, 5, 1)
		Rule_RemoveMe()
	end
end

function Practice_MoveOutDelay()

	Util_AutoIntel(t_practice.events.A_moveOut)
	
end

function Practice_FOWreveal()
	for i = 1, 3 do 
		sgroup = sg_mudGuard[i]
		if SGroup_IsEmpty(sgroup) == false then
			FOW_RevealSGroup(sgroup, 60)
		end
	end
	Rule_RemoveMe()
end

-- track combat
function Practice_MudAmbush1()
	if Event_IsAnyRunning() == false then
		if SGroup_IsDoingAttack(sg_p1_able, false, 5) or SGroup_IsDoingAttack(sg_mudGuardAll, false, 5) then
			
			Practice_FOWreveal()
			DFireHintButtonID = HintPoint_AddToAbilityButton(ABILITY.SP.LA_FIERE.DIRECT_FIRE_ABLE, 6019501, true) 
			DFireFlashButtonID = UI_FlashAbilityButton(ABILITY.SP.LA_FIERE.DIRECT_FIRE_ABLE, true, BT_UI_Strong_AbilityBtn)
			Rule_AddOneShot(Practice_Remove_DFHint, 10)
			Rule_AddDelayedInterval(Practice_MudAmbush2, 15, 1) --15
			Rule_RemoveMe()
			
		end
	end
end

function Practice_MudAmbush2()
	local done = false
	if SGroup_IsEmpty(sg_mudGuardAll) then
		done = true
	elseif SGroup_IsUnderAttack(sg_mudGuardAll, false, 15) == false or SGroup_TotalMembersCount(sg_mudGuardAll) <= 4 then
		for i = 1, 3 do 
			sgroup = sg_mudGuard[i]
			if SGroup_IsEmpty(sgroup) == false then
				Cmd_Retreat(sgroup, Marker_GetPosition(mkr_mapEntry5), mkr_mapEntry5)
			end
		end
		done = true
	end
	if done == true then
		if t_practice.skip1 ~= true then
			Rule_AddDelayedInterval(Pratice_HMG1, 1, 1)
		end
		Rule_RemoveMe() 
	elseif t_practice.skip1 ~= true and Prox_ArePlayersNearMarker(player1, mkr_railHMG_trig, false) then
		Rule_AddDelayedInterval(Practice_HMG2, 1, 1)
		t_practice.skip1 = true
	end
end


function Practice_Remove_DFHint()
	HintPoint_Remove(DFireHintButtonID)
	UI_StopFlashing(DFireFlashButtonID)
end


-- when combat is done, move on
function Pratice_HMG1()
	if Event_IsAnyRunning() == false and SGroup_IsEmpty(sg_p1_able) == false then -- and SGroup_IsUnderAttack(sg_p1_able, ANY, 2) == false
		Rule_AddDelayedInterval(Practice_HMG2, 1, 1)
		
		Rule_RemoveMe() 
	end
end

-- near the corner
function Practice_HMG2()
	if Event_IsAnyRunning() == false then
		if Prox_ArePlayersNearMarker(player1, mkr_railHMG_trig, false) then
			-- letterbox
			Game_Letterbox(true, 2)
--			Game_FadeToBlack(FADE_OUT, 1)
			
			Util_AutoIntel(t_practice.events.A_hmgSpotted)
			-- pin Able
			SGroup_SetSelectable(sg_p1_able, false)
			Cmd_Stop(sg_p1_able)
			
			-- make Able invulnerable
			SGroup_SetInvulnerable(sg_p1_able, true)
			Camera_FollowSGroup(sg_p1_able)
			Cmd_Move(sg_p1_able, mkr_railHMG_trig)
			
			-- create the HMG
			Util_CreateSquads( player3, sg_railHMG, SBP.AXIS.HEAVYMG, mkr_railHMG_spawn, mkr_railHMG_goto, numsquads, loadout, attackmove, mkr_railHMG_trig, upgrades, spawn_facing )
			SGroup_SetTeamWeaponCapturable(sg_railHMG, false)
			Modify_WeaponRange(sg_railHMG, "hardpoint_01", 4)
			LaFiere_LogSyncW(sg_railHMG)
			
			--Rule_AddDelayedInterval(Practice_FadeIn, 1, 1)
			Rule_AddDelayedInterval(Practice_HMG3, 1, 1)
			FOW_Enable(false)
			Rule_RemoveMe() 
		end
	end
end

--~ function Practice_FadeIn()
--~ 	if Event_IsAnyRunning() == false then
--~ 		--Game_FadeToBlack(FADE_OUT, 1)
--~ 		Rule_AddDelayedInterval(Practice_HMG3, 1, 1)
--~ 		Rule_RemoveMe()
--~ 	end

--~ end

function Practice_HMG3()
	if Event_IsAnyRunning() == false then
		
		
		-- fix camera
		--Camera_SetDefault(5, 15, -140)
		--Camera_ResetToDefault()
		
		
		if SGroup_IsEmpty(sg_p1_able) == false then
			SGroup_Hide(sg_p1_able, true)
		end
		
		if SGroup_IsEmpty(sg_mudGuardAll) == false then
			SGroup_DestroyAllSquads(sg_mudGuardAll, true)
		end
		
		--Game_FadeToBlack(FADE_IN, 1)
		Util_StartNIS(NIS02)
		Camera_SetDefault( 30, 43, -40)
		
		if SGroup_IsEmpty(sg_railHMG) == false then
			SGroup_Hide(sg_railHMG, true)
		end

		--Camera_FocusOnPosition(Marker_GetPosition(mkr_railHMG_goto), true)
		
		Rule_AddDelayedInterval(Practice_Baker1, 0, 1)
		
		Rule_RemoveMe() 
	end
end

function Practice_Baker1()
	if SGroup_IsEmpty(sg_p1_baker) == false then
		
		-- remove hint 
		Objective_RemoveUIElements(OBJ_Practice, OBJ_Practice.mapElementID)
		-- create Baker
	--~ 	Util_CreateSquads(player1, sg_p1_baker, SBP.LA_FIERE.ALLIES.BAKER, mkr_p1_goto, nil, 1, 4, false, mkr_railHMG_spawn, nil, mkr_railHMG_spawn)
	--~ 	Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_baker, 1), 2)
		-- brw, vulnerability already modifies received damage, don't need to modify it twice
		LaFiere_CompanyBias(sg_p1_baker, 1, 1, .2, .65, 1)
		SGroup_SetCrushable(sg_p1_baker, false)
		Rule_AddDelayedInterval(Practice_Baker2, 0, 1)
		Rule_RemoveMe() 
	
	end
end

function Practice_Baker2()
	
	if SGroup_IsEmpty(sg_p1_baker) == false then
		t_practice.baker_arrive = true
		Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_baker, 1), 2)
		-- move Baker in
		Util_AutoIntel(t_practice.events.B_intro)
		-- fix camera
--~ 		Camera_SetDefault(30, 35, -40)
--~ 		Camera_ResetToDefault()
		
		LaFiere_MoveCover(sg_p1_baker, mkr_railHMG_spawn, 5)
		
		if SGroup_IsEmpty(sg_p1_able) == false then
			SGroup_Hide(sg_p1_able, false)
			SGroup_SetSuppression(sg_p1_able, 1.0)
			SGroup_WarpToMarker(sg_p1_able, mkr_railHMG_trig)
		end
		
		if SGroup_IsEmpty(sg_railHMG) == false then
			SGroup_Hide(sg_railHMG, false)
		end
		
		
		if SGroup_IsEmpty(sg_p1_baker) == false then
			
			SGroup_AddGroup(sg_p1_overgroup, sg_p1_baker)
			
		end
		
		if SGroup_IsEmpty(sg_p1_able) == false then
			
			SGroup_AddGroup(sg_p1_overgroup, sg_p1_able)
			
		end
		
		RPGTracker_SetSGroup(sg_p1_overgroup) 
			
		--Camera_FollowSGroup(sg_p1_baker)
		Misc_SelectSquad(SGroup_GetSpawnedSquadAt(sg_p1_baker, 1), true)
			
		Rule_AddDelayedInterval(Practice_Baker3, 0, 1)
		Rule_RemoveMe() 
	
	end
end

function Practice_Baker3()
	if Event_IsAnyRunning() == false then
		FOW_Enable(true)
		-- unletterbox
		Casualty_Force_EntityPopulate()
		if SGroup_IsEmpty(sg_p1_baker) == false then
			Danger_RPGMechanics_KickOff(sg_p1_baker)
		end
		Game_Letterbox(false, 1)
		Rule_AddDelayedInterval(Practice_HMG_Dead, 0, 1)
		Rule_AddDelayedInterval(Practice_SuppressionCycle, 1, 1)
		Rule_AddInterval(AbleBakerSurvivalStartCheck, 1)
		Rule_AddInterval(AbleBakerSurvivalMod, 1)
		Util_AutoAmbient(t_practice.events.B_suppression)
	
		Rule_AddInterval(Practice_SuppressHintAdd, 1)
				
		Rule_AddDelayedInterval(Practice_HMG_Pin, 0, 1)
		
		Game_LoadAtmosphere("data:art/scenarios/presets/atmosphere/LA_FIERE_MIDDAY_00.APS", 60*10)
		
		Rule_RemoveMe() 
	end
end


-- Until the HMG ambush squad is dead, this function will keep Able suppressed until it's time to 
-- go to Baker or until it's time to do its suicide charge
function Practice_SuppressionCycle()
	
	if SGroup_IsEmpty(sg_railHMG) or g_suicideRun == true then
		
		Rule_RemoveMe()
	else
		
		if SGroup_IsEmpty(sg_p1_able) == false and g_suicideRun == false then
			if SGroup_IsSuppressed(sg_p1_able, ANY) == false then
				SGroup_SetSuppression(sg_p1_able, 1.0)
			end
		end
	end
end

function Practice_HMG_Pin()
	
	-- supress/pin the HMG
	--Modify_Vulnerability(sg_railHMG, 10)
	Modify_ReceivedSuppression(sg_railHMG, 10)
	
	Rule_AddDelayedInterval(Practice_AbleKillsItself, 180,1) -- in 3 mins Able will suicide if the player does nothing
	SGroup_SetInvulnerable(sg_p1_able,false)
	
	Rule_RemoveMe() 
end


-- meant to make it so that Able can die if the player decides to just sit there and do nothing
function Practice_AbleKillsItself()

	if SGroup_IsEmpty(sg_railHMG) or SGroup_IsEmpty(sg_p1_able) == true or g_suicideRun == true then
		Rule_RemoveMe()
	elseif SGroup_IsEmpty(sg_railHMG) == false and g_suicideRun == false then
		
		if SGroup_IsEmpty(sg_railHMG) == false then
			
			Cmd_Attack(sg_railHMG, sg_p1_able, nil, true)
			
		end
		SGroup_SetSuppression(sg_p1_able, 0.0)
		Cmd_Move(sg_p1_able,mkr_railHMG_goto)
		g_ableReceiveDmg = Modify_ReceivedDamage(sg_p1_able, 5)
		g_suicideRun = true
		
	end
	
end	

function Practice_SuppressHintAdd()
	if Event_IsAnyRunning() == false then
		if SGroup_IsEmpty(sg_p1_baker) == false and Misc_IsSGroupSelected(sg_p1_baker, ANY) == true and SGroup_IsEmpty(sg_railHMG) == false then
			
			FlashSuppressID = UI_FlashAbilityButton(ABILITY.SP.LA_FIERE.BAKER_SUPPRESSION, true, BT_UI_Strong_AbilityBtn)
			HintSuppressID = HintPoint_AddToAbilityButton(ABILITY.SP.LA_FIERE.BAKER_SUPPRESSION, 9419131, true)
			
			Rule_AddDelayedInterval(Practice_SuppressHintRemove, 10, 1)
			
			Rule_RemoveMe()
			
		elseif SGroup_IsEmpty(sg_railHMG) == true then
		
			Rule_RemoveMe()
		
		end
	end
end


function Practice_SuppressHintRemove()

	if Event_IsAnyRunning() == false or SGroup_IsEmpty(sg_railHMG) then
		
		HintPoint_Remove(HintSuppressID)
		UI_StopFlashing(FlashSuppressID)
		
		--Rule_AddDelayedInterval(Practice_HMG_Dead, 1, 1)
		
		Rule_RemoveMe()
		
	end

end


function Practice_HMG_Dead()
	
	if SGroup_IsEmpty(sg_railHMG) and SGroup_IsEmpty(sg_p1_able) == false then
		-- reset Able
		SGroup_SetInvulnerable(sg_p1_able, false)
		SGroup_SetSelectable(sg_p1_able, true)
		SGroup_SetSuppression(sg_p1_able, 0.0)
		Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_able, 1), 1)
		-- initiate rally up 
		Cmd_Retreat(sg_p1_able, Marker_GetPosition(mkr_railHMG_goto))
		Util_AutoIntel(t_practice.events.B_wilsonMad)
		Rule_AddDelayedInterval(Practice_Complete, 3, 1)
		
		if g_ableReceiveDmg ~= nil or g_ableReceiveDmg ~= false then
			
			Modifier_Remove(g_ableRecieveDmg)
			
		end
		
		Rule_RemoveMe() 
		
	end
	
end	


function Practice_Complete()
	if Event_IsAnyRunning() == false then
		-- objective complete
		t_practice.rally_done = true
		
		if EGroup_IsEmpty(eg_retreat_point) == false then
			EGroup_DestroyAllEntities(eg_retreat_point)
		end
		Util_CreateEntities(player1, eg_retreat_point, EBP.SP.LA_FIERE.RETREAT_POINT, mkr_railHMG_spawn, 1)
		
		Rule_RemoveMe() 
	end
end

