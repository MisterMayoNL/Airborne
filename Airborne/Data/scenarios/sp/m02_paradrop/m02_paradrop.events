-- Barn
-------------------------------------------------------------------------------- 
EVENTS.Barn_IntroNIS = function()

	-- change up music
	Util_PlayMusic("Music/sp/m02_combat", 2, 0)
	
	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	
 	-- stop the guys and make invulnerable
 	Player_GetAll(player1)
 	Cmd_StopSquadsExcept(sg_allsquads, false, false)
	
	Util_HidePlayerForNIS(ALL, true)
	FOW_Enable(false)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

	CTRL.Scar_PlayNIS(NIS03)
	CTRL.WAIT()
	
	nis_stop()

	Camera_MoveToPosition(obmarker_barn, false)
	Camera_ResetToDefault()
	
	Util_HidePlayerForNIS(ALL, false)
	
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 220391) 
	CTRL.WAIT()
	
	CTRL.Event_Delay(1.5)
	CTRL.WAIT()
	
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 220392)
		Cmd_Move(sg_barnenemies1, Util_GetRandomPosition(mkr_barn_axisgoto1, 3))
		Cmd_Move(sg_barnenemies2, Util_GetRandomPosition(mkr_barn_axisgoto2, 3))
		Cmd_Move(sg_barnenemies3, Util_GetRandomPosition(mkr_barn_axisgoto3, 3))
		Cmd_Move(sg_barnenemies4, Util_GetRandomPosition(mkr_barn_axisgoto4, 3))
		Camera_MoveToPosition(mkr_barn_axisgoto4, true, SLOW_CAMERA_PANNING)
		--Camera_FocusOnPosition(Marker_GetPosition(mkr_barn_axisgoto4), true)
	CTRL.WAIT()
	
	CTRL.Event_Delay(2)
	CTRL.WAIT()
	
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 220393) 
		Camera_MoveToPosition(mkr_barn_paradrop_look, true, SLOW_CAMERA_PANNING)
		--Camera_FocusOnPosition(Marker_GetPosition(mkr_barn_paradrop), true)
		-- hint point
		hint_paradropID = HintPoint_Add( mkr_barn_paradrop, 30, 229106 )
	CTRL.WAIT()
	
	Game_Letterbox(false, 1)
	FOW_Enable(true)
	
--~ 	SGroup_SetInvulnerable(sg_barnenemiesall, false)
--~ 	SGroup_SetInvulnerable(sg_allsquads, false)
	-- for some reason if this is called earlier
	-- the squad retains their invulnerability
	Cmd_CaptureTeamWeapon(sg_barnenemies1, eg_barn_hmg)

end

