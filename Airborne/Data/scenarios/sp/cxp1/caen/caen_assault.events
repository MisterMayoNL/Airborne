----------------------------------------------------------------------------------------------------------
-- End Mission Speech

----------------------------------------------------------------------------------------------------------

EVENTS.End_Mission = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1352440) 	-- I'm showing all targets destoryed.  Good bloody show gents.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1352450) 	-- Major all targets neutralized.  
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1352460) 	-- The lads took a beatin' but they're in good spirits.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1352470) 	-- They did a bloody good job of it.  Pass it down the line.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1352471) 	-- Let's tend to the wounded and re-org' the troops.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1352480) 	-- We've only just started the battle for Caen.
	CTRL.WAIT()
end