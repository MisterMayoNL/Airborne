--[[ UTILITY FUNCTIONS ]]
---------------------------------

function GreyCastle_SpawnHeroes(marker)
	--Game_Letterbox(false, 0)
	Camera_FocusOnPosition(Marker_GetPosition(marker), false)
	
	Util_CreateSquads(player1, sg_p1_baker, SBP.LA_FIERE.ALLIES.BAKER, marker, nil, 1, 1, false, marker, nil, marker)
	Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_baker, 1), 2)
	GreyCastle_CompanyBias(sg_p1_baker, .75, 1, .2, .5, .5)
	
	if SGroup_IsEmpty(sg_p1_able) then
		Util_CreateSquads(player1, sg_p1_able, SBP.LA_FIERE.ALLIES.ABLE, marker, nil, 1, 1, false, marker, nil, marker)
		GreyCastle_CompanyBias(sg_p1_able, .5, 1, 2, .5, .5)
	else
		SGroup_WarpToMarker(sg_p1_able, marker)
	end
	Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_able, 1), 1)
	--[[]]
end

-- sets up biases for the two squads to be used any time they are created
function GreyCastle_CompanyBias(sgroup, range, sight, suppression, vulnerability, damage)
	Modify_WeaponRange(sgroup, "hardpoint_01", range)
	Modify_SightRadius(sgroup, sight)
	Modify_ReceivedSuppression(sgroup, suppression)
	Modify_Vulnerability(sgroup, vulnerability)
	Modify_ReceivedDamage(sgroup, damage)
end

function GreyCastle_MoveCover(sgroup, pos, cover)
	Cmd_Move(sgroup, pos, NO_QUEUE, NIL_DELETE, NIL_FACE, NIL_OFFSET, NIL_DIST, cover)
end


function LaFiere_CreateVolks(player, sgroup, spawn)
	Util_CreateSquads( player, sgroup, SBP.AXIS.VOLKSGRENADIER, spawn, destination, numsquads, loadout, attackmove, dest_facing, upgrades, spawn_facing )
end



function LaFiere_CreateVolksSmall(player, sgroup, spawn)
	
	local l_randomsize = World_GetRand(3, 4)
	
	Util_CreateSquads( player, sgroup, SBP.AXIS.VOLKSGRENADIER, spawn, destination, numsquads, l_randomsize, attackmove, dest_facing, upgrades, spawn_facing )
end

function LaFiere_CreateGren(player, sgroup, spawn)
	Util_CreateSquads( player, sgroup, SBP.AXIS.GRENADIER, spawn, destination, numsquads, loadout, attackmove, dest_facing, upgrades, spawn_facing )
end

function LaFiere_MoveCover(sgroup, pos, cover)
	Cmd_Move(sgroup, pos, NO_QUEUE, NIL_DELETE, NIL_FACE, NIL_OFFSET, NIL_DIST, cover)
end


function LaFiere_LogSyncW(sgroup)
	if _KillSyncW == nil then
		_KillSyncW = {}
	end
	
	local syncw = false
	if SGroup_IsEmpty(sgroup) == false then
		syncw = SyncWeapon_GetFromSGroup(sgroup)
	end
	
	if syncw ~= nil and syncw ~= false then
		table.insert(_KillSyncW, syncw)
		
		if Rule_Exists(LaFiere_KillSyncW) == false then
			Rule_AddInterval(LaFiere_KillSyncW, 1)
		end
	end
end

function LaFiere_LogEGSyncW(egroup)
	if _KillSyncW == nil then
		_KillSyncW = {}
	end
	
	local syncw = false
	if EGroup_IsEmpty(egroup) == false then
		syncw = SyncWeapon_GetFromEGroup(egroup)
	end
	
	if syncw ~= nil and syncw ~= false then
		table.insert(_KillSyncW, syncw)
		
		if Rule_Exists(LaFiere_KillSyncW) == false then
			Rule_AddInterval(LaFiere_KillSyncW, 1)
		end
	end
end

function LaFiere_KillSyncW()
	local count = table.getn(_KillSyncW)
	if count > 0 then
		for i = count, 1, -1 do 
			local syncw = _KillSyncW[i]
			if SyncWeapon_IsOwnedByPlayer(syncw, nil) then
				local entity = SyncWeapon_GetEntity(syncw)
				local egroup = EGroup_CreateIfNotFound("eg_killentity"..i)
				EGroup_Add(egroup, entity)
				EGroup_Kill(egroup)
				table.remove(_KillSyncW, i)
			end
		end
	end	
end



