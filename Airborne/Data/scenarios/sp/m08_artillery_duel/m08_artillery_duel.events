g_OBJ_DTS_Progression = 1
t_dts_progression = {281740, 281750, 281760, 281770}
EVENTS.OBJ_DTS_Progression = function()
	local text = t_dts_progression[g_OBJ_DTS_Progression]
	CTRL.Actor_PlaySpeech(ACTOR.Conti, text)
	CTRL.WAIT()
	if g_OBJ_DTS_Progression < table.getn(t_dts_progression) then
		g_OBJ_DTS_Progression = g_OBJ_DTS_Progression + 1
	end
end

