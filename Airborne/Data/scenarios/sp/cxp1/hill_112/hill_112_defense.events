EVENTS.Firefly_ApproachingTourmau = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Degnan, line = 1380920}		-- Hey you sorry lot! Did you miss us!
	choices[2] = {actor = ACTOR.CXP1.Degnan, line = 1380930}		-- Here comes the heavies!!!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
	
	if World_GetRand(1, 3) == 3 then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380940)	-- I never thought your ugly mug could look so good Degnan! It's about bloody fucking time...
		CTRL.WAIT()
	end


end


