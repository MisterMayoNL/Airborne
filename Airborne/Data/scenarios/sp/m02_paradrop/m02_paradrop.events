function NIS_Init()

	-- load NIS's
	NIS01 = "sp/M02_Paradrop/NIS/N02_01"
	nis_load(NIS01)
	NIS02 = "sp/M02_Paradrop/NIS/N02_02"
	nis_load(NIS02)
	NIS03 = "sp/M02_Paradrop/NIS/N02_03"
	nis_load(NIS03)
	-- NIS04 and NIS05 axed
	NIS06 = "sp/M02_Paradrop/NIS/N02_06"
	nis_load(NIS06)
	NIS07 = "sp/M02_Paradrop/NIS/N02_07"
	nis_load(NIS07)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)





EVENTS = {}


--------------------------------------------------------------------------------
-- Opening Cinematic
--------------------------------------------------------------------------------

EVENTS.NIS_NEWOPEN = function()

	Game_Letterbox(true, 0)
	Game_FadeToBlack(FADE_IN, 2)
	
	-- old NIS1
	SGroup_Hide(sg_hideNIS01, true)
	EGroup_Hide(eg_hideNIS01, true)
	SGroup_SetAutoTargetting(sg_hideNIS01, "hardpoint_01", false)
	ShootTheSky_RemoveSyncWeapon(sw_aagun1)
	-- old NIS2
	SGroup_Hide(sg_hideNIS02, true)
	EGroup_Hide(eg_hideNIS02, true)
	SGroup_SetAutoTargetting(sg_hideNIS02, "hardpoint_01", false)
	FOW_Enable(false)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)
	
	CTRL.Scar_PlayNIS2(NIS01, NIS02)
	CTRL.WAIT()
	
	nis_stop()

	FOW_Enable(true)
	-- old NIS1
	ShootTheSky_AddSyncWeapon(sw_aagun1, player2)
	SGroup_SetAutoTargetting(sg_hideNIS01, "hardpoint_01", true)
	EGroup_Hide(eg_hideNIS01, false)
	SGroup_Hide(sg_hideNIS01, false)
	SGroup_DestroyAllSquads(sg_nis)
	SGroup_DestroyAllSquads(sg_hideNIS02, false)
	--EGroup_Hide(eg_hideNIS02, false)
	SGroup_SetAutoTargetting(sg_hideNIS02, "hardpoint_01", true)
	
	Game_Letterbox(false, 0.75)
	Game_FadeToBlack(false, 0.75)
	--Camera_ResetToDefault()

end


EVENTS.PostNIS02Chatter = function()

	CTRL.Actor_PlaySpeech(ACTOR.Carota, 220290) -- Carl, Kenny? 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Lewis, 220298) -- Flakburst 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.GenericAlly, 220299) -- We managed to jump
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 220300) -- You're with us now - let's go.
	CTRL.WAIT()
	CTRL.Event_Delay(0.5)
	CTRL.WAIT()
end

EVENTS.PostNIS02Chatter_2 = function()
	CTRL.Event_Delay(0.5)
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 220200) -- That gun is well defended
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 220210) -- Williams, flank it from the right, we'll take the middle.
	CTRL.WAIT()
