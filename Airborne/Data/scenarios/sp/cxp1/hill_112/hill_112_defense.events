	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1380361}		-- Come on lads, capture that Victory point!
	choices[3] = {actor = ACTOR.CXP1.Wallis, line = 1380362}		-- Alright listen up, pull your thumbs out and get to taking that fucking point back or the mission is lost!!
	
