function NIS_Init()
	NIS01 = "sp/CXP1/Caen/NIS/N06_01"
	nis_load(NIS01)
	NIS01A = "sp/CXP1/Caen/NIS/N06_01A"
	nis_load(NIS01A)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)
end

Scar_AddInit(NIS_Init)

EVENTS = { }

EVENTS.NIS01 = function()

	CTRL.Game_Letterbox(true, 0.75)
	CTRL.WAIT()

	 
	-- pre-NIS fixups go here
	

	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()

	nis_stop()

	
	-- post-NIS fixups go here
	

	Game_Letterbox(false, 0.75)
	Game_FadeToBlack(false, 0.75)
	 
	 
end

EVENTS.GlennDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraGlenn, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
end

EVENTS.NIS01A = function()

--~ 	CTRL.Game_Letterbox(true, 0.75)
--~ 	CTRL.WAIT()

	 
	-- pre-NIS fixups go here
	
	Game_FadeToBlack(FADE_IN, 2)
	Game_Letterbox(true, 0)
	CTRL.Scar_PlayNIS(NIS01A)
	CTRL.WAIT()

	-- post-NIS fixups go here
	

	Game_Letterbox(false, 0.75)
	Game_FadeToBlack(false, 0.75)
	 
	 
end


----------------------------------------------------------------------------------------------------------
