-- Panicked Soldier 1
EVENTS.AMBI_Panick1 = function()
	if fg_darwin_dead == false then
		fg_darwin_dead = true
		CTRL.Actor_PlaySpeech (ACTOR.CXP1.GenericCommonwealth, 1371140)	-- Let's hand Jerry his arse.
		CTRL.WAIT()
	else

		local choices = {}
		choices[1] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371130} -- Fuckin' hell!  There's too many of 'em!
		choices[2] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371150} -- Where the fuck are all these Jerry's coming' from!?
		choices[3] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371160} -- We've got to pull back!
		choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371170} -- Steady mate!  Just keep bloody firing!
		choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371180} -- Covering fire!  I need covering fire over here!
		choices[6] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371190} -- Someone go for help!
		
		local rand = World_GetRand(1, table.getn(choices))
		
		CTRL.Event_Delay(0.5)
		
		CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
		CTRL.WAIT()	
	end
end

