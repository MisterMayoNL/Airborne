--------------------------------------------------------------------------------

-- Objective Event 
EVENTS.Hill_Start = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322000)		-- Listen up lads, that bloody hill is our objective!
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322010)		-- Use the walking barrage to support infantry on their way up. 
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322020)		-- Keep a look out for enemy emplacments, this place is covered. 
	CTRL.WAIT()	
end


-- Ambient Event 
EVENTS.Hill_FirstArtillery = function()

	CTRL.Event_Delay(3)
	CTRL.WAIT()

	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Dillingham, 1322120)		-- Holy shit! What the fuck was that?!
	CTRL.WAIT()	

	CTRL.Event_Delay(6)
	CTRL.WAIT()

	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Dillingham, 1322130)		-- Artillery incoming from the top of the hill!
	CTRL.WAIT()	

end


-- Ambient Event 
EVENTS.Hill_ArtilleryIncoming = function()

	CTRL.Event_Delay(3)
	CTRL.WAIT()
	
	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Dillingham, line = 1322140}
	choices[2] = {actor = ACTOR.CXP1.Dillingham, line = 1322150}
	choices[3] = {actor = ACTOR.CXP1.Dillingham, line = 1322160}
	choices[4] = {actor = ACTOR.CXP1.Dillingham, line = 1322170}
	choices[5] = {actor = ACTOR.CXP1.Dillingham, line = 1322180}
	
	local rand = choices[World_GetRand(1, table.getn(choices))]
	
	CTRL.Actor_PlaySpeechWithoutPortrait(rand.actor, rand.line)
	CTRL.WAIT()
	
end


-- Tactical Event
EVENTS.Hill_PanthersSpotted = function()

	Player_GetAllSquadsNearMarker(player1, sg_temp, sectorid_hilltop)
	SGroup_Filter(sg_temp, {SBP.CW.CHURCHILL, SBP.CW.CHURCHILL_AVRE, SBP.CW.CHURCHILL_CROC, SBP.CW.CROMWELL}, FILTER_KEEP)
	
	if SGroup_IsEmpty(sg_temp) then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322670)		-- Armor support needed on the hill, Pathers spotted. Repeat, Panthers spotted!
		CTRL.WAIT()	
	else
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322660)		-- Panthers! They've got Panthers!
		CTRL.WAIT()	
	end
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322680)		-- I'll say it again, Panthers on the hill!
	CTRL.WAIT()	
	
end


-- Tactical Event
EVENTS.Hill_EnemiesRetreating = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1322690)		-- Look at 'em run!
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1322700)		-- Jerry fell down an broke his crown, and we came tumbling after!
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1322710)		-- Looks like Jerry's got no balls at all! 
	CTRL.WAIT()	
end


-- Objective Event
EVENTS.Hill_Complete = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322720)		-- Hill 112 is finally ours, gentlemen, Bravo.
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322730)		-- Too much Allied blood has been shed for this hill.
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322740)		-- I get a message up the chain to the Major...
	CTRL.WAIT()	
end



