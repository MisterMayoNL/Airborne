EVENTS.NIS03 = function()
	
	FOW_Enable(false)
	CTRL.Game_Letterbox(true, 0.75)
	CTRL.WAIT()
		
	CTRL.Scar_PlayNIS(NIS03)
	CTRL.WAIT()
	Cmd_InstantUpgrade(AbleSherman1, UPG.ALLIES.SHERMAN_MG)
	Util_PlayMusic("Sound/music/sp/M04/M04_Ob4_ShermansArrive", 2, 0)
	FOW_Enable(true)
	CTRL.Game_Letterbox(false, 0.75)
	CTRL.WAIT()
	CTRL.Event_Delay(2)
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Joey, 260210) 					--Backup is here! Wooohooo!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 240540)						-- God Damn! Good to dsee some of our tanks for a change
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 240550)						-- Now move up and push the Germans our of Carentan. 
	CTRL.WAIT()
	
	Camera_ResetToDefault()
	Camera_ResetToDefault()
end

