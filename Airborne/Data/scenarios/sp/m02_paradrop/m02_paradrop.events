--------------------------------------------------------------------------------
-- CONVOY EVENTS
--------------------------------------------------------------------------------



-- NIS06: Convoy is on the map
EVENTS.NIS06 = function()
	
	CTRL.Game_Letterbox(true, 0.75)
	CTRL.WAIT()
	
	Util_HidePlayerForNIS(ALL, true)
	FOW_Enable(false)

--~ 	Player_GetAllSquadsNearMarker(player1, sg_nis, Marker_GetPosition(roadendnorth), 80)
--~ 	SGroup_Hide(sg_nis, true)

--~ 	Player_GetAllEntitiesNearMarker(player1, eg_nis, Marker_GetPosition(roadendnorth), 80)
--~ 	EGroup_Hide(eg_nis, true)
	
	if (captureNIS == true) then
		Scar_DebugConsoleExecute("app_fixedframerate(24)")
		Scar_DebugConsoleExecute("capturemoviestart(0)") -- 1 for small, 0 for large
		Scar_DebugConsoleExecute("nis_synchelp")
		CTRL.Event_Delay(0.5)
		CTRL.WAIT()
	end
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

	CTRL.Scar_PlayNIS(NIS06)
	CTRL.WAIT()
	
	if (captureNIS == true) then
		Scar_DebugConsoleExecute("capturemoviestop()")
		Scar_DebugConsoleExecute("app_fixedframerate(0)")
	end
	
--~ 	SGroup_Hide(sg_nis, false)
--~ 	EGroup_Hide(eg_nis, false)
	
	nis_stop()
	
	FOW_Enable(true)
	Util_HidePlayerForNIS(ALL, false)
	
	Game_Letterbox(false, 0.75)
	Game_FadeToBlack(false, 0.75)
	Camera_ResetToDefault()

end


