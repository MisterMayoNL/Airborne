		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.AXIS.RECRUIT_TIGER, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.AXIS.RECRUIT_TIGER_ACE, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.CW.GLIDER_TETRARCH, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.CW.RECRUIT_PRIEST, ITEM_REMOVED)
