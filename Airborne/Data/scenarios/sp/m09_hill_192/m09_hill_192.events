function NIS_Init()
	NIS01 = "sp/M09_Hill_192/NIS/N09_01"
	nis_load(NIS01)

	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)
end

Scar_AddInit(NIS_Init)

EVENTS = {}
	
EVENTS.NIS01 = function()
	-- set speech and sfx volume groups to 0 so we don't hear any audio in between NIS and Sit Rep.  Sit Rep transition out will re-set volume groups.
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)

	Game_Letterbox(true, 0)
	Game_FadeToBlack(FADE_IN, 2)
	FOW_Enable(false)
	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()
	nis_stop()
	--CTRL.Util_MissionTitle(299910)									--- Objective: Capture Hill 192
	--CTRL.WAIT()

	
	FOW_Enable(true)
--~ 	Game_Letterbox(false, 0.75)
--~ 	Game_FadeToBlack(false, 0.75)
--~ 	Game_FadeToBlack(FADE_IN, 2)
	Camera_ResetToDefault()
	Camera_FocusOnPosition(Marker_GetPosition(Marker_AbleStart1), false)
	--Scar_Autosave(299050) 
	
end


EVENTS.DozerUpgrade = function()
	 --Game_Letterbox(true, 0.75)
	--Camera_FocusOnTargetPos(SGroup_GetPosition_EVEN_IF_EMPTY(AbleCompanyBeta1))
	EventCue_Create(CUE.NORMAL, 299941, 299941, SGroup_GetPosition_EVEN_IF_EMPTY( AbleCompanyBeta1))
	CTRL.Actor_PlaySpeech(ACTOR.McKay, 290090)  -- Dam Shermans, it's about time! 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.McKay, 290100)  -- What the hell is that contraption on the Sherman.
	CTRL.WAIT()
	Util_MissionTitle(299105)									--- Sherman Dozer upgrade available. 
	CTRL.WAIT()
	--Game_Letterbox(false, 0.75)
	--Camera_MoveToPosition(cameraposdozer, true, 1)
end

EVENTS.FriendsDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraFriends, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
end

EVENTS.ArtilleryTowerStart = function()
	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	Camera_ResetToDefault()
	Camera_ResetToDefault()
	Camera_MoveToPosition(EGroup_GetPosition_EVEN_IF_EMPTY(Blg_ArtilleryTower), true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	--Camera_MoveToPosition(SGroup_GetPosition_EVEN_IF_EMPTY(NebelwerferAlpha1), true, 5)
	--Camera_FocusOnTargetPos(SGroup_GetPosition_EVEN_IF_EMPTY(AbleCompanyBeta1))
	FOW_RevealEGroup(Blg_ArtilleryTower, 10)
	CTRL.Actor_PlaySpeech( ACTOR.McKay, 290150)  -- 'The Germans are using a tower and are spotting our positions.  Take it out.  
	CTRL.Event_Delay(0.5)
	CTRL.WAIT()
	Camera_MoveToPosition(camerapostower, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	CTRL.Game_Letterbox(false, 1)
	CTRL.WAIT()
end
EVENTS.MGFiring = function()
	CTRL.Actor_PlaySpeech( ACTOR.Joey, 293020)  -- Lookout! HMG Firing all over the place.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 293005)  -- Lookout! HMG Firing all over the place.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 293006)  -- Down and fast, taking fire from the hedgerows
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 293007)  -- 'Damn Krauts are hiding in the bushes. Get down!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 293008)  -- Get a bulldozer and breach that hedgerow... We have to flank the Krauts!
	CTRL.WAIT()
end
