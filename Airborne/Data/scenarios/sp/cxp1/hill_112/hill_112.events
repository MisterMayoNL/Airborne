--------------------------------------------------------------------------------
-- MOVE HQ (Objective)
--------------------------------------------------------------------------------


-- Objective Event 
EVENTS.MoveHQ_CaptureDestination = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322750)		-- <First thing - secure the village sector in readiness for the HQ>
	CTRL.WAIT()	
end


-- Objective Event 
EVENTS.MoveHQ_GetDestinationInSupply = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322760)		-- <The destination won't have supply lines to the resources>
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322770)		-- <Capture all the in-between sectors>
	CTRL.WAIT()	

	if movehq_needsbridgerepaired == true then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322780)		-- <That bridge will need to be repaired as well>
		CTRL.WAIT()	
	end
	
end


-- Objective Event 
EVENTS.MoveHQ_Start = function()

	if movehq_destination_baron == true then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1321810)		-- Tennant, deploy the Mobile Command Post to Baron.
		CTRL.WAIT()	
	elseif movehq_destination_tourmau == true then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1321820)		-- Tennant, deploy the Mobile Command Post to Tourmauville.
		CTRL.WAIT()	
	end
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1321830)		-- We need to move our command post across the river.
	CTRL.WAIT()	
	
end


-- Ambient Event 
EVENTS.MoveHQ_PackUp = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321840)		-- Degnan, get those Service Battalion slackers to move their vehicle across the river!
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321850)		-- Corporal Dillingham.
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321860)		-- Get the circus battalion gits to move their lorry
	CTRL.WAIT()	
	
	flag_movehq_firststep = false
	
end


-- Objective Event 
EVENTS.MoveHQ_PackedUp = function()

	if flag_movehq_firststep == true then
		if movehq_destination_baron == true then
			CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321930)		-- What in the bloody hell are you waiting for?  Get that mobile command vehicle over to Baron.
			CTRL.WAIT()	
		elseif movehq_destination_tourmau == true then
			CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321920)		-- It's packed and good to go, get it over to Tourmauville.
			CTRL.WAIT()	
		end
		flag_movehq_firststep = false
	else
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321870)		-- That's right, get her moving!
		CTRL.WAIT()	
		if movehq_destination_baron == true then
			CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321900)		-- Get over to Baron and set up command area.
			CTRL.WAIT()
		elseif movehq_destination_tourmau == true then
			CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321890)		-- Set up command area over in Tourmauville.
			CTRL.WAIT()
		end
	end

end


-- Tactical Event 
EVENTS.MoveHQ_AtVillage = function()

	if flag_movehq_firststep == true then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321950)		-- Your HQ is already at the location, you just need to deploy it.
		CTRL.WAIT()	
		flag_movehq_firststep = false
	else
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321940)		-- Unpack HQ here, so we can plan the next phase of the mission.
		CTRL.WAIT()	
	end

end


-- Objective Event 
EVENTS.MoveHQ_Complete = function()

	if flag_movehq_firststep == true then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321970)		-- It's already there, Major.
		CTRL.WAIT()	
		flag_movehq_firststep = false
	else
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321960)		-- HQ is operational Major.
		CTRL.WAIT()	
	end
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321980)		-- 3rd Battalion in position.
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321990)		-- Awaiting orders.
	CTRL.WAIT()	

end




