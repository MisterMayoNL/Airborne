-------------------------------------------------------------------------
-------------------------------------------------------------------------
--
-- NIS File for Mission 6 - CHERBOURG
--
-------------------------------------------------------------------------
-------------------------------------------------------------------------

function NIS_Init()

	-- load NIS's
	NIS02 = "sp/M06_Cherbourg/NIS/N06_02"
	nis_load(NIS02)
	NIS03 = "sp/M06_Cherbourg/NIS/N06_03"
	nis_load(NIS03)
	NIS04 = "sp/M06_Cherbourg/NIS/N06_04"
	nis_load(NIS04)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)





EVENTS = {}


--------------------------------------------------------------------------------
-- NIS EVENTS
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- NIS02: SNIPER
--------------------------------------------------------------------------------

EVENTS.NIS02 = function()
	-- set speech and sfx volume groups to 0 so we don't hear any audio in between NIS and Sit Rep.  Sit Rep transition out will re-set volume groups.
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)
	
	if Misc_IsCommandLineOptionSet("-nosand") then
		CTRL.Scar_PlayNIS(NIS02)
			FOW_Enable(false)
			Game_FadeToBlack(FADE_IN, 1)
		CTRL.WAIT()
	else
		CTRL.Scar_PlayNIS(NIS02)
			FOW_Enable(false)
			Game_Letterbox(true, 0)
			Game_FadeToBlack(FADE_IN, 1)
		CTRL.WAIT()
	end
	
	nis_stop()
	
--	CTRL.Game_Letterbox(false, 1)
		--Game_FadeToBlack(true, 1)
		FOW_Enable(true)
	CTRL.WAIT()
		-- set view
		Camera_ResetToDefault()
		Camera_FocusOnTargetPos(Marker_GetPosition(mkr_player1_start2))
	
end




--------------------------------------------------------------------------------
-- NIS03: NAVAL BOMBARDMENT
--------------------------------------------------------------------------------

EVENTS.NIS03 = function()
	
	nis_setouttransitiontime(0)
	
	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	
	Util_HidePlayerForNIS(ALL, true)
	FOW_Enable(false)
	
	CTRL.Scar_PlayNIS(NIS03)
	CTRL.WAIT()

	nis_stop()
	
	FOW_Enable(true)
	Util_HidePlayerForNIS(ALL, false)
	
	if g_axishq_granted == true then
		CTRL.Game_Letterbox(false, 1)
	end
		Camera_ResetToDefault()
	CTRL.WAIT()
	
end






--------------------------------------------------------------------------------
-- NIS04: GERMAN POWs
--------------------------------------------------------------------------------

EVENTS.NIS04 = function()

	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	Game_FadeToBlack(FADE_OUT, 1.5)
	Sound_SetVolume("Speech", 0.0, 1.5)
	Sound_SetVolume("SFXmaster", 0.0, 1.5)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
	
	Util_ClearWrecksFromMarker(mkr_bridge_stugdef2)
	Util_HidePlayerForNIS(ALL, true)
	FOW_Enable(false)
	
	Game_FadeToBlack(FADE_IN, 1.5)
	
	World_ClearCasualties()
	CTRL.Scar_PlayNIS(NIS04)
	CTRL.WAIT()

	nis_stop()
	
	FOW_Enable(true)
	Util_HidePlayerForNIS(ALL, false)
	
--	CTRL.Game_Letterbox(false, 1)
		Camera_ResetToDefault()
	CTRL.WAIT()
	
end



--------------------------------------------------------------------------------
-- NIS - Mini
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- NIS: Show Motor Pool
--------------------------------------------------------------------------------

EVENTS.NIS_ShowMotorPool = function()

	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	
	FOW_Enable(false)
	
	CTRL.Event_Delay(5)
		_camera_pos = Camera_GetTargetPos()
		Camera_FocusOnPosition(EGroup_GetPosition_EVEN_IF_EMPTY(eg_2ndmotorpool), true)
	CTRL.WAIT()
	
	FOW_Enable(true)
	
	CTRL.Game_Letterbox(false, 1)
		Camera_FocusOnPosition(_camera_pos, true)
	CTRL.WAIT()
	
end


--------------------------------------------------------------------------------
-- NIS: Show Naval Guns
--------------------------------------------------------------------------------

EVENTS.NIS_ShowNavalGuns = function()

	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	
	FOW_Enable(false)
	
	CTRL.Event_Delay(5)
		_camera_pos = Camera_GetTargetPos()
		Camera_FocusOnPosition(EGroup_GetPosition_EVEN_IF_EMPTY(eg_navalguns_bunker), true)
	CTRL.WAIT()
	
	FOW_Enable(true)
	
	CTRL.Game_Letterbox(false, 1)
		Camera_FocusOnPosition(_camera_pos, true)
	CTRL.WAIT()
	
end


