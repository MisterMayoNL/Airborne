--------------------------------------------------------------------------------
-- WALKING BARRAGE (System)
--------------------------------------------------------------------------------

-- Objective Event
EVENTS.WalkingBarrage_Intro = function()

	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322260)			-- Arty Barrage is standing by, Major
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1322280)			-- The Walking Barrage will cover our advance as 3rd Batallion moves up the hill
	CTRL.WAIT()	

	if flag_walkingbarragetriggered ~= true then
		
		OBJ_Hill.BarragePingID = Objective_AddUIElements(OBJ_Hill, barrage_formupline, true, 1329202, true)
		
		if barrage_location == "Tourmau" then
			CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322290)		-- Form your units up in the area outside Tourmauville.
			CTRL.WAIT()	
		elseif barrage_location == "Baron" then
			CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322300)		-- Form your units up in the area outside Baron.
			CTRL.WAIT()	
		end
		
	end
	
end


-- Objective Event
EVENTS.WalkingBarrage_Reminder = function()
	if barrage_location == "Tourmau" then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322290)		-- Form your units up in the area outside Tourmauville.
		CTRL.WAIT()	
	elseif barrage_location == "Baron" then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322300)		-- Form your units up in the area outside Baron.
		CTRL.WAIT()	
	end
end


-- Objective Event
EVENTS.WalkingBarrage_Start = function()

	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322310)		-- Okay, get ready. The barrage should begin any minute now.
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1322320)		-- Wait for the signal. 
	CTRL.WAIT()	
	
end



-- Tactical Event 
EVENTS.WalkingBarrage_WarningSmoke = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Wallis, line = 1322390}
	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1322400}

	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1322370)
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
	
end


-- Tactical Event 
EVENTS.WalkingBarrage_Incoming = function()

	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1322410)
	CTRL.WAIT()
	
end


-- Tactical Event 
