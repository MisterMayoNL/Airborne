
function NIS_Init()
	NIS01 = "sp/M04_Carentan_Counterattack/NIS/N04_01"
	nis_load(NIS01)
	NIS02 = "sp/M04_Carentan_Counterattack/NIS/N04_02"
	nis_load(NIS02)	
	NIS03 = "sp/M04_Carentan_Counterattack/NIS/N04_03"
	nis_load(NIS03)	
	NIS04 = "sp/M04_Carentan_Counterattack/NIS/N04_04"
	nis_load(NIS04)

	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)
end
Scar_AddInit(NIS_Init)



