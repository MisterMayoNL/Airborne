--AXIS AMBIENT
EVENTS.FIRST_ENCOUNTER_DETECTION = function()
	
	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.GenericAxis, line = 1330502} -- Did you hear something? Shit!! The Brits are coming! 
	choices[2] = {actor = ACTOR.CXP1.GenericAxis, line = 1330503} -- Alarm!!
	choices[3] = {actor = ACTOR.CXP1.GenericAxis, line = 1330504} -- Don't let them through men!! Hold your ground!
	choices[4] = {actor = ACTOR.CXP1.GenericAxis, line = 1330505} -- Schultz, what are you doing out there?  Get back here at once!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Event_Delay(0.5)
	CTRL.WAIT()
	
	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)  --Actor_PlaySpeech
	CTRL.WAIT()

	
end
