-------------------------------------------------------------------------

-- [[ SETUP ]]

-------------------------------------------------------------------------

function OnGameSetup()
	-- string numbers should reference dat files
	-- "allies_commonwealth" "allies" "axis" "axis_panzer_elite"
	player1 = Setup_Player(1, 9419750, "allies", 1)
	player2 = Setup_Player(2, 9419755, "allies", 1)
	player3 = Setup_Player(3, 9419760, "axis", 2)
	player4 = Setup_Player(4, 9419766, "allies", 1)
	
	-- AI slot (ensure that the AI is on the same team as the other Axis player by setting the second parameter
--~  	player3 = Setup_Player(3, "$000000", "Axis Infantry Company", 2)
end

function OnGameRestore()
	player1 = World_GetPlayerAt(1)
	player2 = World_GetPlayerAt(2)
	player3 = World_GetPlayerAt(3)
	player4 = World_GetPlayerAt(4)
	
	-- function takes care of restoring all global mission parameters after a save/load
	Game_DefaultGameRestore()
end




-------------------------------------------------------------------------

-- [[ ONINIT ]]

-------------------------------------------------------------------------

function OnInit()
	
	-- a constant that stores the mission number for use with
	-- setting the global speech paths, tech tree setup, and 
	-- the player's starting resources
	MISSION_NUMBER = 0403
	
	--[[ PRESET GAME STATE ]]
	Setup_MissionPreset(MISSION_NUMBER)
	--[[ Pre-Cache Sound]]
	LaFiere_C_PrecacheSound()
	
	--[[ PRESET DEBUG CONDITIONS ]]
	if Misc_IsCommandLineOptionSet("mayo") then
		GreyCastle_Debug()
	end
	
	--[[ MOD INITIAL STATS ]]
	GreyCastle_ModifyStats()
	
	--[[ SET RESTRICTIONS ]]
	GreyCastle_Restrictions()
	
	--[[ SET AI ]]
	GreyCastle_CpuInit()
	
	--[[ SET DIFFICULTY ]]
	GreyCastle_Difficulty()
	
	--[[ MISSION PRESETS ]]
	GreyCastle_MissionPreset()
	
	--[[ GAME START CHECK ]]
	Rule_Add(GreyCastle_MissionStart)

end

Scar_AddInit(OnInit)

function GreyCastle_Debug()
	
	-- looks for the command line option [-debug]
	if Misc_IsCommandLineOptionSet("debug") then
		
		g_debug = true
		
		-- reveal FOW
		FOW_Enable(false)
		
	end
	
		-- set up bindings for NISes
		Scar_DebugConsoleExecute("bind([[ALT+1]], [[Scar_DoString('Util_StartNIS(NIS01)')]])")
 		Scar_DebugConsoleExecute("bind([[ALT+2]], [[Scar_DoString('Util_StartNIS(NIS_CLOSING)')]])")
		Scar_DebugConsoleExecute("bind([[ALT+3]], [[Scar_DoString('Util_StartNIS(NIS_CLOSING, LaFiere_C_PostEndNIS)')]])")
	
end

function GreyCastle_ModifyStats()
	
	--[[ saved as example - deg
	Player_SetDefaultSquadMoodMode(player1, MM_Auto)
	Player_SetDefaultSquadMoodMode(player2, MM_Auto)
	Player_SetDefaultSquadMoodMode(player3, MM_ForceTense)
	
	-- shorten vision ranges
	Modify_PlayerSightRadius(player1, 0.75)
	]]		
	-- mod resource rates
	t_player1_res_mods= {}
	t_player1_res_mods[1] = Modify_PlayerResourceRate(player1, RT_Manpower, 0)
	t_player1_res_mods[2] = Modify_PlayerResourceRate(player1, RT_Munition, 0)
	t_player1_res_mods[3] = Modify_PlayerResourceRate(player1, RT_Fuel, 0)
	

	
end

function GreyCastle_Restrictions()

	--[[ UN/RESTRICT UPGRADES ]]
	Cmd_InstantUpgrade(player1, UPG.ALLIES.STICKY_BOMB)
	
	
	--[[ RESOURCES ]]
	Player_SetResource(player1, RT_Manpower, 0)
	Player_SetResource(player1, RT_Munition, 300)
	Player_SetResource(player1, RT_Fuel, 0)
	
	
	--[[ UN/RESTRICT ABILITIES ]]
	Player_SetAbilityAvailability(player1, ABILITY.ALLIES.GRENADE, ITEM_UNLOCKED)
	Player_SetAbilityAvailability(player1, ABILITY.ALLIES.SATCHEL_CHARGE, ITEM_REMOVED)
	Player_SetUpgradeAvailability(player1, UPG.ALLIES.CONVERT_AMBIENT_BUILDING, ITEM_REMOVED)
	Player_SetUpgradeAvailability(player1, UPG.ALLIES.ENGINEER_FLAMETHROWER, ITEM_REMOVED)
	Player_SetUpgradeAvailability(player1, UPG.ALLIES.ENGINEER_MINESWEEPER, ITEM_REMOVED)
	Player_SetConstructionMenuAvailability(player1, TYPE.CONSTRUCT.ALLIES.ENGINEER_ADVANCED, ITEM_REMOVED)
	--Player_SetConstructionMenuAvailability(player1, TYPE.CONSTRUCT.ALLIES.ENGINEER_BASIC, ITEM_REMOVED)
	Player_SetAbilityAvailability(player3, ABILITY.AXIS.GRENADE, ITEM_UNLOCKED)
	
	
	-- UN/RESTRICT POP CAP
	Player_SetPopCapOverride(player1, 20)

	--[[ UN/RESTRICT UI 
	UI_BindingSetEnabled("company_commander", false)
	UI_BindingSetEnabled("squadcap", false)
	]]
	
	--[[ UN/RESTRICT EBPS ]]
	local ebps = {EBP.ALLIES.ARMORY, EBP.ALLIES.BARRACKS, EBP.ALLIES.MEDIC_STATION, EBP.ALLIES.MG_NEST, EBP.ALLIES.MOTORPOOL, EBP.ALLIES.OBSERVATION_POST,
	EBP.ALLIES.QUARTER_MASTER, EBP.ALLIES.TANK_DEPOT, EBP.ALLIES.TRIAGE, EBP.ALLIES.TANK_TRAP }
	for i = 1, #(ebps) do
		Player_SetEntityProductionAvailability(player1, ebps[i], ITEM_REMOVED)
	end
end



function GreyCastle_CpuInit()

	--[[ left as an example
	
	-- set up Player3 AI  
	Util_AI_Setup(player3, {Util_DifVar({10, 15, 20, 30}), 5}, player3, Game_GetSPDifficulty(), 7, Util_DifVar({1, 2, 3, 5}), 2, 3)
	
	-- Set up AI's resources
	Player_SetResource(player3, RT_Manpower, 1000)
	Player_SetResource(player3, RT_Munition, 100)
	Player_SetResource(player3, RT_Fuel, 100)
	
	-- tell AI to go after strongest threat instead of the weakest
	AI_DoString( player3, "s_personality.attack_prefer_threat = true" )
	AI_DoString( player3, "s_personality.defend_prefer_threat = true" )

	-- tell AI not to "defend" territories outside of the ring around its base
	AI_EnableComponent(player3, false, COMPONENT_ForwardDefending)
	
	-- disable use of comapny commander menu and abilities
	AI_DoString( player3, "s_commandtree_enabled = false" )
	AI_DoString( player3, "s_playerabilities_enabled = false" )
	
	AI_EnableComponent(player3, false, COMPONENT_Attacking)
	
	]]

end



function GreyCastle_Difficulty()

	--[[ left as an example ]]
	
	-- get the difficulty
	g_difficulty = Game_GetSPDifficulty()  -- set a global difficulty variable
	print("********* DIFFICULTY: "..g_difficulty)
	
	-- set health bonus for player 1
	Setup_Difficulty(player1, g_difficulty) -- pass the player and difficulty global variable into the Set Health function
	Setup_Difficulty(player2, g_difficulty) -- do it for each player that you have defined
	
	t_difficulty = {
		base_def_spawn 			= Util_DifVar( {2*60, 1.5*60, 1*60, 0.75*60} ),
	}
	
	if g_difficulty == GD_EXPERT then
		Player_SetAbilityAvailability( player1, ABILITY.SP.LA_FIERE.MEDICAL_SUPPLIES, ITEM_REMOVED)
	end
	
end


-------------------------------------------------------------------------

-- MISSION Preset 

-------------------------------------------------------------------------

function GreyCastle_MissionPreset()

	-- create the temporary starting units for player 1
	--[[ this is an example of what you might do - sgroup and marker must exist
	local sbps = {SBP.ALLIES.RIFLEMEN, SBP.ALLIES.ENGINEER, SBP.ALLIES.JEEP, SBP.ALLIES.RIFLEMEN}
	for i = 1, 5 do
		Util_CreateSquadsAtMarker(player1, sg_player1[i], sbps[i], mkr_marker[1], 1)
	end
	]]
	-- if areas of your script need to be kicked off early
	local control = {eg_control_east, eg_control_manor}
	for i = 1, #(control) do 
		if EGroup_IsCapturedByPlayer(control[i], player1, true) == false then
			EGroup_InstantCaptureStrategicPoint(control[i], player1)
		end
	end
	
	sg_p1_baker = SGroup_CreateIfNotFound("sg_p1_baker")
	sg_p1_able = SGroup_CreateIfNotFound("sg_p1_able")
	sg_p3cleanup = SGroup_CreateIfNotFound("sg_p3cleanup")
	sg_p1cleanup = SGroup_CreateIfNotFound("sg_p1cleanup")
	sg_p2cleanup = SGroup_CreateIfNotFound("sg_p2cleanup")
	sg_p4cleanup = SGroup_CreateIfNotFound("sg_p4cleanup")
	
	sg_p1_overgroup = SGroup_CreateIfNotFound("sg_p1_overgroup")
	
	eg_chef3 = EGroup_CreateIfNotFound("eg_chef3")
	
	g_ableVulModID = false
	g_bakerVulModID = false
	g_ableVulModAdded = false
	g_bakerVulModAdded = false
	
	
	if SGroup_IsEmpty(sg_p3cleanup) == false then
		SGroup_DestroyAllSquads(sg_p3cleanup)
	end
	if SGroup_IsEmpty(sg_p1cleanup) == false then
		SGroup_DestroyAllSquads(sg_p1cleanup)
	end
	
	if EGroup_IsEmpty(eg_chef3) == false then
		
		EGroup_Kill(eg_chef3)
		
	end
	
	
	EGroup_SetInvulnerable(eg_bridge, 0.5) -- bridge is now invulnerable at 50% health
	--Survive_CausewayRun()
	
	--fix camera
	FOW_Enable(false)
	Camera_SetDefault(30, 43, -123)
	Camera_ResetToDefault()	
	
	-- if areas of your script need to be kicked off early
	Camera_FocusOnPosition(Marker_GetPosition(mkr_causeway_East), false)
	
	--[[ LOAD NIS FILES ]]
	NIS01 = "sp/LaFiere/NIS/N03_01"
	nis_load(NIS01)

	if SGroup_IsEmpty(sg_p1_baker) == false then
		
		SGroup_AddGroup(sg_p1_overgroup, sg_p1_baker)
		
	end
	
	if SGroup_IsEmpty(sg_p1_able) == false then
		
		SGroup_AddGroup(sg_p1_overgroup, sg_p1_able)
		
	end
	
	RPGTracker_SetSGroup(sg_p1_overgroup) 
	
	RPGTracker_UpdateCommandPointLimit()
	
	if IsCounterattackMission() == false then
		
		Player_AddResource(player1, RT_Command, 10)
		
        if g_commandPointLimit ~= nil then
			
            g_commandPointLimit = g_commandPointLimit + 10
			
        end
		
    end
	
end

