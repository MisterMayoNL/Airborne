joey_dead = {212037, 212040, 212053, 212065}
EVENTS.JoeyDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraJoey, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(0.65)
	CTRL.WAIT()
	local text = joey_dead[World_GetRand(1, table.getn(joey_dead))]
	CTRL.Actor_PlaySpeech(ACTOR.Lewis, text)
	CTRL.WAIT()
	CTRL.Event_Delay(0.25)
	CTRL.WAIT()
end

--niels_dead = {272190, 272200, 273100, 273200, 273300, 273400}
niels_deadJ = {272190, 272200}
niels_deadJ2 = {272180, 272210, 272220, 272230}
niels_deadL = {273100, 273200, 273300, 273400}
niels_deadL2 = {273410, 273420}
EVENTS.NielsDead = function()
    UI_EnableEventSkip(false)
    CTRL.Event_Delay(1)
    CTRL.WAIT()
    Game_Letterbox(true, 0)
    UI_EnableEventSkip(true)
    Camera_MoveToPosition(cameraNiels, true, SLOW_CAMERA_PANNING)
    CTRL.Event_Delay(0.65)
    CTRL.WAIT()
    local text = World_GetRand(1, 2)
        if text == 1 then
            local textJ = niels_deadJ[World_GetRand(1, table.getn(niels_deadJ))]
            CTRL.Actor_PlaySpeech(ACTOR.Joey, textJ)
            CTRL.WAIT()
            if textJ == 272190 then
                local textJ2 = niels_deadJ2[World_GetRand(1, table.getn(niels_deadJ2))]
                CTRL.Actor_PlaySpeech(ACTOR.Joey, textJ2)
                CTRL.WAIT()
            end
        elseif text == 2 then
            local textL = niels_deadL[World_GetRand(1, table.getn(niels_deadL))]
            CTRL.Actor_PlaySpeech(ACTOR.Carota, textL)
            CTRL.WAIT()
            if textL == 273400 then
                local textL2 = niels_deadL2[World_GetRand(1, table.getn(niels_deadL2))]
                CTRL.Actor_PlaySpeech(ACTOR.Carota, textL2)
                CTRL.WAIT()
            else
                local textL2 = textL + 10
                CTRL.Actor_PlaySpeech(ACTOR.Carota, textL2)
                CTRL.WAIT()
            end
        end
    CTRL.Event_Delay(0.25)
    CTRL.WAIT()
end
