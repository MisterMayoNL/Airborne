		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ELITE.RECRUIT_JAGDPANTHER, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ELITE.RECRUIT_HETZER, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ELITE.WIRBLE_WIND, ITEM_REMOVED)
		 --Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ELITE.HENSCHEL, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ELITE.WIRBLE_WIND, ITEM_REMOVED)
