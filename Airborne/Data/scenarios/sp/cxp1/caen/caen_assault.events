EVENTS.Bridgehead_Charge = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1350600) 	-- Right, BAILEY get your men moving and secure the area!  Move!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Cutting, 1350610) 	-- No gagglefucking, get in there quick and establish a foothold.
	CTRL.WAIT()
end


EVENTS.Mortars = function()
	
	local choices = {}

	choices[1] = {actor = ACTOR.CXP1.Degnan, line = 1350620}	-- Get the Canadian's on those positions!
	choices[2] = {actor = ACTOR.CXP1.Degnan, line = 1350630}	-- Mortars!  On the bloody flanks!  Get your sections over there!
	choices[3] = {actor = ACTOR.CXP1.Degnan, line = 1350640}	-- They've got us zeroed with mortars!  

	local rand = World_GetRand(1, table.getn(choices))

	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
end


EVENTS.Bridgehead_MortarsDead = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1350730) 	-- Chateau has been secured. Mobile command HQs on my position.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1350740) 	-- Right, good bloody work 3rd Battalion.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1350750) 	-- Re-org the troops.  We need to keep the momentum if we want to capture the city.
	CTRL.WAIT()
end






