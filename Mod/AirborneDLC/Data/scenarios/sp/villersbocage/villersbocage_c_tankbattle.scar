-------------------------------------------------------------------------
-- Objective Name 
-------------------------------------------------------------------------
-- Short descriptive name of what the player is cht_eventsed to do
-- give a brief description of win conditions and loose conditions if any 
-- also describe the kind of challenges the player will face
-------------------------------------------------------------------------
function Initialize_OBJ_TankBattle()

	OBJ_TankBattle = {
		
		SetupUI = function() 
			-- mark a point or position
			-- OBJ_TankBattle.mapElementID = Objective_AddUIElements(OBJ_TankBattle, mkr_marker, true, 000000, true)
		end,
		
		OnStart = function()
			
			-- announce the goal
			Util_AutoIntel(t_TB.t_Speech.objStart)
			
			-- win/lose check
			Rule_AddInterval(TankBattle_Rule_WinCheck, 5)
			
			-- start related action
			TankBattle_Kickoff()
			-- EncounterName_Kickoff()
			
		end,
		
		OnComplete = function()
			
			-- tell the player they did good
			Util_AutoIntel(t_TB.t_Speech.objComplete)
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 6049100,
		Description = 6049110,
		TitleEnd = 6049120,
		Type = OT_Primary,
		
--~ 		SitRep = {}, -- only needed once the SitRep is created and there are lines of dialogue.
	}
	
	-- Register Objective
	Objective_Register(OBJ_TankBattle)
	-- Initialize Data
	TankBattle_Init()
	
end

Scar_AddInit(Initialize_OBJ_TankBattle)

-------------------------------------------------------------------------
-- Tank Battle - Functions 
-------------------------------------------------------------------------
function TankBattle_Init()

	-- define sgroups, egroups, etc associated with this obj
	tmkr_TB_SpTank = Marker_GetTable("mkr_TB_SpTank%d")
	
	tsg_CPTank = SGroup_CreateTable("sg_CPTank%d", table.getn(tmkr_TB_SpTank))
	sg_CPUITank = SGroup_CreateIfNotFound("sg_CPUITank")
	
	t_TB = {
		squadSet				= 1,				-- the current set that has already been spawned
		t_CombatPlansTank = {
			COMBAT_PLAN.GENERIC.VEHICLE.MaximizeRange,		
			COMBAT_PLAN.GENERIC.VEHICLE.FlankLeftFront,		
			COMBAT_PLAN.GENERIC.VEHICLE.FlankRightFront,		
			COMBAT_PLAN.GENERIC.VEHICLE.FlankLeftBehind,		
			COMBAT_PLAN.GENERIC.VEHICLE.FlankRightBehind,		
		},
		
		t_CombatPlansInf = {
			COMBAT_PLAN.GENERIC.INFANTRY.FindCoverAndAttack,
			COMBAT_PLAN.GENERIC.INFANTRY.UngarrisonAndFanOutLeft,
			COMBAT_PLAN.GENERIC.INFANTRY.UngarrisonAndFanOutRight,
		},
		FirstAttack 			= true,
		sg_attacker				= SGroup_CreateIfNotFound("sg_CPAttacker"),
		SecondWaveCount 		= 0,
		ObjUI					= nil,
		
		tmrSpawn				= "TB SPAWN TIMER",
		tmrSpawnAmt				= 20,
		
	}
	
	t_TB.t_Squads = {
		{
			sbp			= SBP.CW.STUART,
			set			= 1,
			infantry 	= false,
		},
		{
			sbp			= SBP.CW.CROMWELL,
			set			= 1,
			infantry 	= false,
		},
		{
			sbp			= SBP.CW.FIREFLY,
			set			= 2,
			infantry 	= false,
			combatPlan	= COMBAT_PLAN.GENERIC.VEHICLE.MaximizeRange,
		},
		{
			sbp			= SBP.CW.CROMWELL,
			set			= 3,
			upg			= UPG.CW.TANKCOMMANDER,
			infantry 	= false,
		},
		{
			sbp			= SBP.CW.FIREFLY,
			set			= 3,
			infantry 	= false,
			combatPlan	= COMBAT_PLAN.GENERIC.VEHICLE.MaximizeRange,
		},	
	}
	
	for i,this in pairs(t_TB.t_Squads) do
		
		this.sgroup 			= tsg_CPTank[i]
		this.posSpawn			= tmkr_TB_SpTank[i]
		this.sg_attacker		= SGroup_CreateIfNotFound("sg_CPTankAttacker"..i)
		this.spawned			= false
			
		this.tmrWait			= "TANK WAIT TIMER"..i
		this.tmrWaitAmount		= 30
		this.tmrWaitStarted 	= true
		
	end
	
	TankBattle_Preset()
	TankBattle_SpeechInit()
	
end

voss_openfire = {6040580, 6040590, 6040600}
voss_objUpdate = {6040610, 6040620}
voss_objComplete = {6040630, 6040640, 6040650, 6040660}
function TankBattle_SpeechInit()
	t_TB.t_Speech = {
		
		objStart = {
			{ACTOR.VILLERS_BOCAGE.GenericWehrmacht, 6030610},
			{ACTOR.VILLERS_BOCAGE.Voss, 6040560},
		},
		
		bFirstContact = false,
		firstContact = {
			{ACTOR.VILLERS_BOCAGE.Berndt, 6030640},
			{ACTOR.VILLERS_BOCAGE.Voss, 6040570},
			{ACTOR.VILLERS_BOCAGE.Litzke, 6030660},
			{ACTOR.VILLERS_BOCAGE.Shultz, 6030670},
			{ACTOR.VILLERS_BOCAGE.Voss, voss_openfire[World_GetRand(1, table.getn(voss_openfire))]},
		},
		
		bObjUpdate = false,
		objUpdate = {
			{ACTOR.VILLERS_BOCAGE.GenericWehrmacht, 6030740},
			{ACTOR.VILLERS_BOCAGE.Voss, voss_objUpdate[World_GetRand(1, table.getn(voss_objUpdate))]},
		},
		
		objComplete = {
			{ACTOR.VILLERS_BOCAGE.Voss, voss_objComplete[World_GetRand(1, table.getn(voss_objComplete))]},
			{ACTOR.VILLERS_BOCAGE.Shultz, 6030811},
--~ 			{ACTOR.VILLERS_BOCAGE.Voss, 6040670},
		},
		
	}
	
end


function TankBattle_Preset()
	-- spawn initial attack squads
	for k, this in pairs(t_TB.t_Squads) do
		if this.set == 1 then
--~ 		Util_CreateSquads(player, sgroup, sbp, spawn_point[, destination, numsquads, loadout, attackmove, dest_facing, upgrades, spawn_facing]
			Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn, nil, nil, nil, nil, nil, this.upg)
			this.spawned = true
			Timer_Start( t_TB.tmrSpawn, t_TB.tmrSpawnAmt )
		end
	end
	
end

function TankBattle_Rule_ManageTanks()

	if Objective_IsComplete(OBJ_TankBattle) == true then
		Rule_RemoveMe()
		return
	end
	
	-- check if the timer for the next set of squads should be spawned,
	-- and if so then mark that spawning show occur when looping through squads
	local spawn = false
	if Timer_GetRemaining(t_TB.tmrSpawn) == 0 then
		spawn = true
		Timer_Start(t_TB.tmrSpawn, t_TB.tmrSpawnAmt)
		t_TB.squadSet = t_TB.squadSet + 1
	end

	for k, this in pairs(t_TB.t_Squads) do 
		if SGroup_IsEmpty(this.sgroup) == false then
			
			if SGroup_IsUnderAttack(this.sgroup, ANY, 15) == true then
				if t_TB.t_Speech.bFirstContact == false then
					Util_AutoIntel(t_TB.t_Speech.firstContact)
					t_TB.t_Speech.bFirstContact = true
				end
				
				if SGroup_IsEmpty(this.sg_attacker) == true then
					Player_GetAll(player1, sg_temp)
					if SGroup_IsEmpty(sg_temp) == false then
						SGroup_Add(this.sg_attacker, SGroup_GetRandomSpawnedSquad(sg_temp))
					end
				end
				
				if CombatPlan_IsExecuting(this.CombatPlanId) == false
				and SGroup_IsEmpty(this.sg_attacker) == false then
					local cPlan = this.combatPlan
					if cPlan == nil then
						cPlan = t_TB.t_CombatPlansTank[World_GetRand(1, table.getn(t_TB.t_CombatPlansTank))]
						if this.infantry == true then
							cPlan = t_TB.t_CombatPlansInf[World_GetRand(1, table.getn(t_TB.t_CombatPlansInf))]
						end
					end
					this.CombatPlanId = CombatPlan_Add(this.sgroup, cPlan, this.sg_attacker)
				end
			else
				
				Player_GetAll(player1, sg_temp)
				if SGroup_IsEmpty(sg_temp) == false then
					Cmd_AttackMove(this.sgroup, sg_temp)
				end
				
			end
		elseif spawn == true 
		and this.spawned == false 
		and this.set == t_TB.squadSet then
			
--~ 			Util_CreateSquads(player, sgroup, sbp, spawn_point[, destination, numsquads, loadout, attackmove, dest_facing, upgrades, spawn_facing]
			Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn, nil, nil, nil, nil, nil, this.upg)
			this.spawned = true
			
			
		end		
		
	end

end


function TankBattle_Rule_WinCheck()

	local count = 0
	local all_dead = true
	for k, this in pairs(t_TB.t_Squads) do
		if SGroup_IsEmpty(this.sgroup) == false then
			all_dead = false
			
			-- update the UI to give the player some guidance at finding a specific location for the tanks.
			if SGroup_IsEmpty(sg_CPUITank) == true then
				if t_TB.ObjUI ~= false then
					Objective_RemoveUIElements(OBJ_TankBattle, t_TB.ObjUI)
				end
				SGroup_AddGroup(sg_CPUITank, this.sgroup)
				t_TB.ObjUI = Objective_AddUIElements(OBJ_TankBattle, sg_CPUITank, true, nil, true)
			end
		elseif this.spawned == true then
			-- count the total number of squads to ensure that all have been spawned before ending the objective
			count = count + 1
		end
	end
	

	
	if count == table.getn(t_TB.t_Squads)
	and all_dead == true then
		Objective_Complete(OBJ_TankBattle)
		Rule_RemoveMe()
	end
	
end

function TankBattle_Debug()

	-- add in the necessary information that can automatically start this objective 
	-- with the press of a hotkey
	if Objective_IsStarted(OBJ_TankBattle) == false then
		Objective_Start(OBJ_TankBattle)
		return
	end
	
	if Objective_IsComplete(OBJ_TankBattle) == false then
		for k, this in pairs(t_TB.t_Squads) do
			SGroup_DestroyAllSquads(this.sgroup)
		end
		return
	end

end


-- start the related action
function TankBattle_Kickoff()

	-- action that starts with the Obj being granted
	Rule_AddInterval(TankBattle_Rule_ManageTanks, 2)
	Rule_AddDelayedInterval(TankBattle_ForceSitrep, 25, 1)

end

function TankBattle_ForceSitrep()

	Player_GetAll(player1, sg_temp)

	if SGroup_IsUnderAttack(sg_temp, ANY, 5) == false 
	and SGroup_IsDoingAttack(sg_temp, ANY, 5) == false
	and Event_IsAnyRunning() == false then
	
		local t_sitrep_timing = {}
		t_sitrep_timing[1] = 3
		t_sitrep_timing[2] = 2
		t_sitrep_timing[3] = 3
		t_sitrep_timing[4] = 5
		t_sitrep_timing[5] = 4
		
	
		-- surreptitiously add in the sitrep and pretend it was always there
		OBJ_TankBattle.OnStart = function() end
		
		OBJ_TankBattle.SitRep = {
			Movie = "SR_VillersBocage_C_01",
			Force = false,
			SpeechTiming =
			{
				{ 1,	ACTOR.VILLERS_BOCAGE.Voss, 6040500 },
				{ 5,	ACTOR.VILLERS_BOCAGE.Voss, 6040510 },
				{ 9,	ACTOR.VILLERS_BOCAGE.Voss, 6040520 },
				{ 12,	ACTOR.VILLERS_BOCAGE.Voss, 6040530 },
				{ 18.5,	ACTOR.VILLERS_BOCAGE.Voss, 6040540 },
				{ 21.5,	ACTOR.VILLERS_BOCAGE.Voss, 6040550 },
			},
			
			PrologueEvent = function()
				
			end,
			
			EpilogueEvent = function()
--~ 				if t_TB.t_Speech.bObjUpdate == true then
					Util_AutoIntel(t_TB.t_Speech.objUpdate)
--~ 					t_TB.t_Speech.bObjUpdate = false
--~ 				end
			end,
		}
		
		-- and force the sitrep to play
--~ 		Objective_UpdateText(OBJ_TankBattle, 1449050, 1449051, true)
		Obj_SetObjectiveFunction(OBJ_TankBattle.ID, FN_OnActivate, __ObjectiveOnActivateCallback)
		Objective_ForceSitRep(OBJ_TankBattle)
		
--~ 		Rule_Add(KR_PostSitRep)
		Rule_RemoveMe()
	end


end
