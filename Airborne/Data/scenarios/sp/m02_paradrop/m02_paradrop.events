-- Secure the Road
-------------------------------------------------------------------------------- 

-- First patrol comes down the road
EVENTS.GetBackSomethingsComing_NIS = function()

	CTRL.Game_Letterbox(true, 1)
		FOW_Enable(false)
	CTRL.WAIT()
	
	-- stop the guys and make invulnerable
	Player_GetAll(player1)
	Cmd_StopSquadsExcept(sg_allsquads, false, false)
	SGroup_SetInvulnerable(sg_allsquads, true)

	CTRL.Actor_PlaySpeech(ACTOR.Carota, 220510) -- Find cover! Kraut patrol!
		
		CTRL.SUB()
			
			CTRL.Event_Delay(1.5)
			CTRL.WAIT()
			
			pos_prebarnCamera = Camera_GetTargetPos()
			Camera_ResetToDefault()
			Camera_ResetToDefault()
			Camera_MoveToPosition(patrol_reveal_a, true, SLOW_CAMERA_PANNING)
			--Camera_FocusOnPosition(Marker_GetPosition(patrol_reveal_a), true)
			
			CTRL.Event_Delay(1.5)
			CTRL.WAIT()
			
		CTRL.END()
		
	CTRL.WAIT()
	
	CTRL.Event_Delay(1.5)
	CTRL.WAIT()
	
	Objective_Start(OBJECTIVE_SECUREROAD)
--	Objective_ForceSitRep(OBJECTIVE_SECUREROAD)
	
--~ 	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 220520) -- Wait until they've passed...
--~ 	CTRL.WAIT()
--~ 	
--~ 	CTRL.Event_Delay(3.5)
--~ 	CTRL.WAIT()
--~ 	
--~ 	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 220530) -- ...wait...
--~ 	CTRL.WAIT()
--~ 	
--~ 	CTRL.Event_Delay(3)
--~ 	CTRL.WAIT()
--~ 	
--~ 	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 220540) -- ...hold it...
--~ 	CTRL.WAIT()
--~ 	
--~ 	CTRL.Event_Delay(2)
--~ 	CTRL.WAIT()
--~ 	
--~ 	Objective_Start(OBJECTIVE_SECUREROAD)
--~ 	
--~ 	CTRL.Event_Delay(3)
--~ 	CTRL.WAIT()

--~ 	Objective_ForceSitRep(OBJECTIVE_SECUREROAD)
	
end


