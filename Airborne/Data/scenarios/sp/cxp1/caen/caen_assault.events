EVENTS.Ambient_Bombing_Runs = function()
	local choices = {}

	choices[1] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352380}	-- Right bloody on Boudica's boys!  Stick it to 'em your sorry fucks!
	choices[2] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352390}	-- Only the RAF flies like that! Bloody brilliant CRAB Air!
	choices[3] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352400}	-- Cracked it right open gents!  That's the gen.
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352401}	-- Keep it dropping! Jeery needs some love!
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352402}	-- That's it!  That's it!  Keep it comin' you beautiful CRAB bastards!
	choices[6] = {actor = ACTOR.CXP1.Degnan, line = 1352410}	-- Fuckin' hell.  Wouldn't want to be on the receiving' end of that eh mate.

	local rand = World_GetRand(1, table.getn(choices))

	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
end


