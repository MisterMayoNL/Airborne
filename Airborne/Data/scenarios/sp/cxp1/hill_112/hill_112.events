--------------------------------------------------------------------------------
-- BRIDGES
--------------------------------------------------------------------------------

-- Tactical Event
EVENTS.Bridge_BridgeIsWired = function()

	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1321030)			-- Bloody hell! The bridge is wired!
	CTRL.WAIT()
	if Prox_ArePlayerMembersNearMarker(player1, mkr_bridge_baron, ANY) or Prox_ArePlayerMembersNearMarker(player1, mkr_bridge_tourmau, ANY) then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1321040)		-- It's fuckin' wired!  Get off, move!
		CTRL.WAIT()
	else
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1321050)		-- Get off the bridge, its wired! Move, move!
		CTRL.WAIT()
	end

end


-- Objective Event
EVENTS.Bridge_Blown = function()

	CTRL.Actor_PlaySpeech(ACTOR.CXP1.GenericCommonwealth, 1321140)		-- I guess the recce's finished here!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.GenericCommonwealth, 1321150)		-- Fallback!  We need to make another crossing!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.GenericCommonwealth, 1321160)		-- Let Battalion know the bridge is blown!
	CTRL.WAIT()
	
end


-- Ambient Event
EVENTS.BridgeSiteVisited = function()

	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1321170)		-- I think that fuckin' massive explosion gave it away!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1321180)		-- No fuckin' shit!
	CTRL.WAIT()
	
	if bridge_blown_killedplayer == true then
		CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1321130)		-- Help the wounded!  We need to find another way across!
		CTRL.WAIT()
		CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1321190)		-- I think Darwin was on the bridge!
		CTRL.WAIT()
	end
	
end


-- Objective Event 
EVENTS.Bridge_RecceSecondBridge = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321240)			-- Get the bloody men onto that other crossing Degnan!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321250)			-- I don't care what you do but secure that remaining bridge!
	CTRL.WAIT()
end





