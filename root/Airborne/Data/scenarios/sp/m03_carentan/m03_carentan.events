EVENTS.AbleReinforcement = function()

	if 	g_AbleCompany == 1 then 
		CTRL.Game_PlaySpeech( "InGame\\portraits\\portrait_conti", 205060, false, "" )		-- Able Company first platoon arriving.	
		CTRL.WAIT()
	end
	if 	g_AbleCompany == 2 then 
		CTRL.Game_PlaySpeech( "InGame\\portraits\\portrait_conti", 205061, false, "" )		-- Able Company second platoon arriving.	
		CTRL.WAIT()
	end
	if 	g_AbleCompany == 3 then 
		CTRL.Game_PlaySpeech( "InGame\\portraits\\portrait_conti", 205062, false, "" )		-- Able Company third platoon arriving.	
		CTRL.WAIT()
	end
	if 	g_AbleCompany == 4 then 
		CTRL.Game_PlaySpeech( "InGame\\portraits\\portrait_conti", 205063, false, "" )		-- Able Company fourth platoon arriving.	
		CTRL.WAIT()
	end
	if 	g_AbleCompany == 5 then 
		CTRL.Game_PlaySpeech( "InGame\\portraits\\portrait_conti", 205064, false, "" )		-- Able Company fifth platoon arriving.	
		CTRL.WAIT()
	end
	if 	g_AbleCompany > 5 then 
		CTRL.Game_PlaySpeech( "InGame\\portraits\\portrait_conti", 205065, false, "" )		-- Able Company platoon has arrived.	
		CTRL.WAIT()
	end
end
