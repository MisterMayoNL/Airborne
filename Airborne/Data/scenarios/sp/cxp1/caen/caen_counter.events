	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Bailey, line = 1370960} -- We've got movement.  Steady up lads.
	choices[2] = {actor = ACTOR.CXP1.Bailey, line = 1370970} -- Stand to.  We have Jerry on the move. 
	
	local rand = World_GetRand(1, table.getn(choices))
	
