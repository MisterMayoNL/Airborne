--------------------------------------------------------------------------------
-- Sector Clear Messages
--------------------------------------------------------------------------------

EVENTS.Cleared_Sector = function()

	if g_SectorName_LastCaptured == eg_caen_pt3 or g_SectorName_LastCaptured == eg_caen_cathedralVP
		then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361700) 	-- The Cathedral and surrounding street is secured sir.
		if t_clear.fg_allCaptured == true then CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361780)	-- Sigs, get this message up the line - All Sectors secure. Caen is in Allied Hands!
		else CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361710) 	-- Keep up the intensity lads.*
		end
		
	elseif g_SectorName_LastCaptured == eg_caen_pt4 or g_SectorName_LastCaptured == eg_caen_crossroadsVP
		then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361720) 	-- Crossroads Secure.
		if t_clear.fg_allCaptured == true then CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361780)	-- Sigs, get this message up the line - All Sectors secure. Caen is in Allied Hands!
		else CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361721) 	-- Proceeding to next objective.*
		end
		
	elseif g_SectorName_LastCaptured == eg_caen_pt5 or g_SectorName_LastCaptured == eg_caen_courtyardVP
		then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361722) 	-- Sigs, send this out - courtyard secured.
		if t_clear.fg_allCaptured == true then CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361780)	-- Sigs, get this message up the line - All Sectors secure. Caen is in Allied Hands!
		else CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361750) 	-- Moving on next objective*
		end	
		
	elseif g_SectorName_LastCaptured == eg_caen_pt7 or g_SectorName_LastCaptured == eg_caen_islandVP
		then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361760) 	-- Let Battalion know the island is secure.
		if t_clear.fg_allCaptured == true then CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361780)	-- Sigs, get this message up the line - All Sectors secure. Caen is in Allied Hands!
		else CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1361770) 	-- Advancing on the next objective*
		end
	end
	
end


