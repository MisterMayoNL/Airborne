EVENTS.ResourcePoint1Start = function()
	if Player_OwnsEGroup(player1, ResourcePoint3) == false and Player_OwnsEGroup(player1, ResourcePoint1) == false then
		CTRL.Actor_PlaySpeech(ACTOR.Thompson, 230950)						-- We need supplies.
		CTRL.WAIT()
		Objective_Start(OBJECTIVESECONDARY)
		CTRL.Actor_PlaySpeech(ACTOR.Thompson, 230960)						-- Pannell, take a squad and capture that supply poing
		CTRL.WAIT()
		CTRL.Actor_PlaySpeech(ACTOR.Carota, 240160)						-- Let's go ladies.
		CTRL.WAIT()
		CTRL.Actor_PlaySpeech(ACTOR.Lewis, 230021)						--    Come on, Carota. Will you spare us just this one time?
		CTRL.WAIT()
	end
	--CTRL.Util_MissionTitle(239913)										-- OBJECTIVE: Secure the Resource Point
	--CTRL.WAIT()
end

