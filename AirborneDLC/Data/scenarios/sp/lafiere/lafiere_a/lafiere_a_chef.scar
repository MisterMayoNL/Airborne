-- Causeway Watch
-- DOES NOT REMOVE UNTIL THEY DIE
function Chef_Action8_Causeway()
	local sgroup1 = sg_chef_def[8]
	if SGroup_IsEmpty(sgroup1) then
		Rule_RemoveMe()
	elseif t_chef.def8sight == nil then
		t_chef.def8sight = Modify_SightRadius(sgroup1, 2)
	elseif SGroup_IsUnderAttack(sgroup1, false, 5) or SGroup_IsDoingAttack(sgroup1, false, 5) then
		SGroup_GetLastAttacker(sgroup1, sg_lastAttacker)
		World_GetSquadsNearMarker(player1, sg_lastAttacker, mkr_causeway2, OT_Player)
		World_GetSquadsNearMarker(player2, sg_lastAttacker, mkr_causeway2, OT_Player)
		
			if SGroup_IsEmpty(sg_lastAttacker) == false then
				Cmd_Attack(sgroup1, sg_lastAttacker)
			end
		if t_chef.def8range == nil and t_chef.prox30 ~= true
		and ( Prox_ArePlayersNearMarker(player1, mkr_causeway2, false, 60) or Prox_ArePlayersNearMarker(player2, mkr_causeway2, false, 60) ) then
			-- attacking from there rear
			--DLC2_Achievement(9419190) -- Unconventional Tactics: Attacking from the West
			Modify_WeaponRange(sgroup1, "hardpoint_01", 1.5)
			t_chef.def8range = true
		end
	end
end


----------------------------
function Chef_ActionCauqAttack()

	for k, this in pairs(t_chef.counterdata) do  
		if SGroup_IsEmpty(this.sgroup) and this.appear ~= true then
			if Player_CanSeePosition(player1, Marker_GetPosition(this.spawn)) == false then
			
				local pos = World_GetHiddenPositionOnPath(player1, this.spawn, this.dest, CHECK_OFFCAMERA)
				if pos == nil then
					pos = Marker_GetPosition(this.entry)
				end
				Util_CreateSquads(player3, this.sgroup, this.blueprint, pos, this.dest, 1, World_GetRand(4, 5))
				Cmd_Ability(player3, ABILITY.SP.SINGLE_MORTAR_SMOKE, pos, nil, true)
				
			else
				
				Util_CreateSquads(player3, this.sgroup, this.blueprint, this.entry, this.dest, 1, World_GetRand(4, 5))
				Cmd_Ability(player3, ABILITY.SP.SINGLE_MORTAR_SMOKE, Marker_GetPosition(this.entry), nil, true)
				
			end
			this.appear = true
			break
		end
	end
end

function Chef_ScareArty1()
	
	if Objective_IsFailed(OBJ_Chef) or Objective_IsComplete(OBJ_Chef) then
		
		Rule_RemoveMe()
		
	else
		local done = true
		for k,this in pairs(tmkr_randCauqArty) do
			if this.shot ~= true then
				Cmd_Ability(player3, ABILITY.SP.SINGLE_HOWITZER, Util_GetRandomPosition(Table_GetRandomItem(tmkr_randCauqArty), 3), nil, true) --this.target
				this.shot = true
				done = false
				break
			end
		end
		if done == true then 
			Rule_RemoveMe() 
			
		end
	end
end

