--------------------------------------------------------------------------------
-- END MISSION
--------------------------------------------------------------------------------

function Rule_EndMission()
	
	if Objective_IsComplete(OBJ_Defend) then
		
		Rule_RemoveMe()
		
		Rule_AddDelayedInterval(Rule_EndMissionWinDelay, 5, 1)
		
	elseif Objective_IsFailed(OBJ_Defend) then
		
		Rule_RemoveMe()
		
		Util_StartIntel(EVENTS.Hill_MissionFailed)
		
		Rule_AddDelayedInterval(Rule_EndMissionLose, 5, 1)
		
	end
	
end


function Rule_EndMissionWinDelay() -- for medal
	if Event_IsAnyRunning() == false then
		
		
		if Objective_IsFailed(OBJ_Medal_Bridge) == false then
		
			Objective_Complete(OBJ_Medal_Bridge)
		
		end
		
		
		Rule_AddDelayedInterval(Rule_EndMissionWin, 5, 1)
		Rule_RemoveMe()
		
	end
end

function Rule_EndMissionWin()
	if Event_IsAnyRunning() == false then
		Rule_RemoveIfExist(Rule_Glenn)
		Game_EndSP(true)
	end
end



function Rule_EndMissionLose()
	if Event_IsAnyRunning() == false then
		Game_EndSP(false)
	end
end






--------------------------------------------------------------------------------
-- UTILITY FUNCTIONS
--------------------------------------------------------------------------------

-- this function updates the variables that indicate if the bridges are intact (and puts bridges back into groups)
function Bridges_CheckStatus()
	
	-- Baron Bridge
	if EGroup_Count(eg_bridge_baron) == 0 then
		World_GetNeutralEntitiesNearMarker(eg_bridge_baron, mkr_bridge_baron)
		EGroup_Filter(eg_bridge_baron, {EBP.BRIDGE_25.NORMAL, EBP.BRIDGE_25.WRECKED, EBP.BRIDGE_25.REBUILT}, FILTER_KEEP)
	end
	
	if EGroup_ContainsBlueprints(eg_bridge_baron, {EBP.BRIDGE_25.NORMAL, EBP.BRIDGE_25.REBUILT}, ANY) then
		bridge_baron = true
	else
		bridge_baron = false
	end
	
	
	-- Tourmauville Bridge
	if EGroup_Count(eg_bridge_tourmau) == 0 then
		World_GetNeutralEntitiesNearMarker(eg_bridge_tourmau, mkr_bridge_tourmau)
		EGroup_Filter(eg_bridge_tourmau, {EBP.BRIDGE_25.NORMAL, EBP.BRIDGE_25.WRECKED, EBP.BRIDGE_25.REBUILT}, FILTER_KEEP)
	end
	
	if EGroup_ContainsBlueprints(eg_bridge_tourmau, {EBP.BRIDGE_25.NORMAL, EBP.BRIDGE_25.REBUILT}, ANY) then
		bridge_tourmau = true
	else
		bridge_tourmau = false
	end
	
	
	-- Wooden Bailey Bridge
	if EGroup_Count(eg_bridge_wooden) == 0 then
		World_GetNeutralEntitiesNearMarker(eg_bridge_wooden, mkr_bridge_wooden)
		EGroup_Filter(eg_bridge_wooden, {EBP.BRIDGE_BAILEY_25.NORMAL, EBP.BRIDGE_BAILEY_25.WRECKED}, FILTER_KEEP)
	end
	
	if EGroup_ContainsBlueprints(eg_bridge_wooden, {EBP.BRIDGE_BAILEY_25.NORMAL}, ANY) then
		bridge_wooden = true
	else
		bridge_wooden = false
	end
	
	
	-- Hidden Bailey Bridge
	if EGroup_Count(eg_bridge_hidden) == 0 then
		World_GetNeutralEntitiesNearMarker(eg_bridge_hidden, mkr_bridge_hidden)
		EGroup_Filter(eg_bridge_hidden, {EBP.BRIDGE_BAILEY_25.NORMAL, EBP.BRIDGE_BAILEY_25.WRECKED}, FILTER_KEEP)
	end
	
	if EGroup_ContainsBlueprints(eg_bridge_hidden, {EBP.BRIDGE_BAILEY_25.NORMAL}, ANY) then
		bridge_hidden = true
	else
		bridge_hidden = false
	end
	
end	



-- this system ensures that when P2 captures an edge territory, they get supply from that area (and it disappears when P1 recaptures it)
function FakeSupply_Init()

	t_supplyterritories = {}
	t_supplyterritories[1] = {player2owned = false, flag = eg_flags_baron}
	t_supplyterritories[2] = {player2owned = false, flag = eg_flags_baron_across}
	t_supplyterritories[3] = {player2owned = false, flag = eg_flags_tourmau}
	t_supplyterritories[4] = {player2owned = false, flag = eg_flags_tourmau_across}
	t_supplyterritories[5] = {player2owned = false, flag = eg_hill_flag1}
	t_supplyterritories[6] = {player2owned = false, flag = eg_hill_flag2}
	t_supplyterritories[7] = {player2owned = false, flag = eg_hill_flag4}
	t_supplyterritories[8] = {player2owned = false, flag = eg_hill_flag5}
	
	Rule_Add(FakeSupply_Manager)
	
end


function FakeSupply_Manager()
	
	for n = 1, table.getn(t_supplyterritories) do
		
		local this = t_supplyterritories[n]
		
		if this.player2owned == false and Player_OwnsEGroup(player2, this.flag) == true then
			this.player2owned = true
			World_SetDesignerSupply(EGroup_GetPosition(this.flag), true)
		elseif this.player2owned == true and Player_OwnsEGroup(player2, this.flag) == false then
			this.player2owned = false
			World_SetDesignerSupply(EGroup_GetPosition(this.flag), false)
		end
		
	end
	
end




-- checks if the points to keep the Firefly routes open are taken by the enemy and adds hints, also checks if bridges are destroyed
function Check_Bridge_Points()
	
	if Objective_IsComplete(OBJ_Medal_Bridge) or Objective_IsFailed(OBJ_Medal_Bridge) then -- Objective_IsComplete(OBJ_Defend)
			Rule_RemoveMe()
		
	else
	
		Bridges_CheckStatus()
	
		-- put hintpoints on any points not captured by the player
		if EGroup_IsCapturedByPlayer(eg_flags_baron, player1, ANY) == false and medal_ui_baron == false then --and hpid_baron == false then
			--hpid_baron = HintPoint_Add(EGroup_GetPosition(eg_flags_baron), true, 1389122)
			--pingid_baron = Objective_AddPing(OBJ_Defend, Util_GetPosition(eg_flags_baron), 1)
			
			medal_ui_baron = Objective_AddUIElements(OBJ_Medal_Bridge, eg_flags_baron, true, 1389122, true, 2.3)
			
			
		elseif EGroup_IsCapturedByPlayer(eg_flags_baron, player1, ANY) and medal_ui_baron ~= false then --hpid_baron ~= false then
			--HintPoint_Remove(hpid_baron)
			--hpid_baron = false		
			--Objective_RemovePing(OBJ_Defend, pingid_baron)
			
			Objective_RemoveUIElements(OBJ_Medal_Bridge, medal_ui_baron)
			medal_ui_baron = false
			
		end
		
		if EGroup_IsCapturedByPlayer(eg_flags_baron_across, player1, ANY) == false and medal_ui_baron_across == false then --and hpid_baron_across == false then
			--hpid_baron_across = HintPoint_Add(EGroup_GetPosition(eg_flags_baron_across), true, 1389122)
			--pingid_baron_across = Objective_AddPing(OBJ_Defend, Util_GetPosition(eg_flags_baron_across), 1)
			
