		fg_ax_all_retreated 	= false,			-- flag to check whether all the axis units have retreated
		trap = {mkr_c_trap1, mkr_c_trap2,mkr_c_trap3, mkr_c_trap4, mkr_c_trap5, 
		mkr_c_trap6, mkr_c_trap7, mkr_c_trap8, mkr_c_trap9, mkr_c_trap10, mkr_c_trap11, 
		mkr_c_trap12, mkr_c_trap13, mkr_c_trap14, mkr_c_trap15, mkr_c_trap16, mkr_c_trap17, 
		mkr_c_trap18, mkr_c_trap19, mkr_c_trap20, mkr_c_trap21, mkr_c_trap22, mkr_c_trap23, 
		mkr_c_trap24, mkr_c_trap25, mkr_c_trap26, mkr_c_trap27, mkr_c_trap28, mkr_c_trap29, 
		mkr_c_trap30, mkr_c_trap31, mkr_c_trap32, mkr_c_trap33, mkr_c_trap34, mkr_c_trap35, 
		mkr_c_trap36, mkr_c_trap37},
		def = {
			{sgroup = sg_surv_def[1], goto = mkr_pathA_3, spawn = mkr_mapEntry9},
			{sgroup = sg_surv_def[2], goto = mkr_LostDest2, spawn = mkr_mapEntry9},
			{sgroup = sg_surv_def[3], goto = mkr_cauq_FUP1, spawn = mkr_mapEntry8},
			{sgroup = sg_surv_def[4], goto = mkr_approach5, spawn = mkr_mapEntry8},
