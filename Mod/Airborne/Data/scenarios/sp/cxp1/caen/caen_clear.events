EVENTS.PostNIS01_Chatter = function()
	
--~ 	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360500)	-- B Coy has been ambushed
--~ 	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360510)	-- Caen is not clear, I say again, Caen is not clear.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360520)	-- Encountering heavy resistance, over.
	CTRL.WAIT()
--~ 	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360530)	-- Jerries using a delaying action to hold us back.  Clear them out.
--~ 	CTRL.WAIT()
	
end

EVENTS.PreSitRep_Chatter = function()
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360540)	-- Good job lads.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360550)	-- Grab some ground and sort yourselves out.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360560)	-- Good old BAILEY has gone back to the CP to get instructions.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360570)	-- I suspect Blackmore will give 'm another shite load of work for us.
	CTRL.WAIT()
	
end

EVENTS.PostSitRep_Chatter = function()
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360540)	-- Good job lads.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360550)	-- Grab some ground and sort yourselves out.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360560)	-- Good old BAILEY has gone back to the CP to get instructions.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360570)	-- I suspect Blackmore will give 'm another shite load of work for us.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360690)	-- Corporal Degnan.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360700)	-- Set up an O group and pass on the following.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360710)	-- Combat teams of Sappers and Rifle sections are needed for clearing action.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360720)	-- Armor will be in support.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360730)	-- We can be sure Jerry knows we're coming so expect mines and A-T emplacements. 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360740)	-- Have the Infantry Command Post deploy Sappers.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1360760)	-- Clear?
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360770)	-- Couldn't be clearer.
	CTRL.WAIT()
	
end

--------------------------------------------------------------------------------
-- Player starts moving troops
--------------------------------------------------------------------------------

EVENTS.PlayerActive = function()

	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360771) 	-- Right you sorry lot.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360772)	-- We've got house keeping to take care of.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360773)	-- Jerries dug himself in and doesn't want to leave.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360774)	-- He's also peppered the area with mines and other nasties.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360775)	-- So, if you don't want to get your arse blown off, make sure you keep our Sapper mates alive.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360776)	-- We have 3rd Battalion armour to support us but in these tight streets we need to provide them security against anti-tank teams.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360777)	-- To top it all off, there are snipers out there trying to send you home feet first.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1360778)	-- Keep your wits about you and don't cock this up.
	CTRL.WAIT()
	
end

