--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- NIS File for Caen Counter Mission
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

function NIS_Init()

	-- load NIS's
	NIS01 = "sp/CXP1/Caen/NIS/N08_01"
	nis_load(NIS01)
	NIS02 = "sp/CXP1/Caen/NIS/N08_02"
	nis_load(NIS02)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)





EVENTS = {}


--------------------------------------------------------------------------------
-- Opening Cinematic (NIS01)
--------------------------------------------------------------------------------

EVENTS.NIS01 = function()

	Game_Letterbox(true, 2)
	
	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()
	
	nis_stop()
	
	Game_FadeToBlack(false, 2)
	Game_Letterbox(false, 2)
	FOW_Enable(true)
	
end

EVENTS.GlennDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraGlenn, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
end


--------------------------------------------------------------------------------
-- Closing Cinematic (NIS02)
--------------------------------------------------------------------------------

EVENTS.NIS02 = function()

	CTRL.Game_Letterbox(true, 2)
	CTRL.WAIT()
	
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()
	
	nis_stop()
	
end




--------------------------------------------------------------------------------
-- Mission Start
--------------------------------------------------------------------------------

-- Played at mission start
EVENTS.OBJ_AllIsQuiet = function()

	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Bailey, 1370530)	-- Right. The major wants the Battalion to shake out and reorg before pulling out in the morning.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Bailey, 1370540)	-- Get the Command Posts into position and establish a defensive perimeter around the Cathedral.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Bailey, 1370550)	-- Rain or shine we've got a bloody job to do.
	CTRL.WAIT()

end

-- Quiet moment to reflect on Caen
EVENTS.AMBI_BloodyRain = function()

	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1370560)	-- Leave it to the officers to have us waiting around in the fucking rain.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Dillingham, 1370570)	-- Shut your gob.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Dillingham, 1370580)	-- Blackmore's never done anything to cock us over.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Dillingham, 1370590)	-- He's got a plan.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Dillingham, 1370600)	-- We just have to hold tight, that's all.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1370610)	-- Tell that to Degnan as his grave fills with water.
	CTRL.WAIT()
end 

EVENTS.AMBI_ItsWet = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370620} -- All my fuckin' kit's wet.  You got an extra pair of socks mate?
	choices[2] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370630} -- Fuckin' me.  This cold's getting' right to the bone.  
	choices[3] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370640} -- Some fuckin' wanker stole my umbrella.
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370650} -- Oy, I think them Canadian's have rain gear.  They're never complaining' about shite.
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370660} -- Steady up lads.  It's just a bit of rain.  
	choices[6] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370670} -- Mother natures taken a piss of us lads.  (beat)  Literally.
	choices[7] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370680} -- I betcha Gladstone's kilt is soak right through to his arse!
	choices[8] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370690} -- Reminds me of my walk-about back in the highlands.  
	choices[9] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370700} -- This rain cut's right to the bone eh' Keegan?
	choices[10] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370710} -- Soldier on you fuckin' wanker.  It's only a wee Scottish mist.
	choices[11] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370720} -- This ain't rain!  Rain cuts through your skin and peels the meat off your bones.  Now that's real rain you puffer.
	choices[12] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370730} -- Quit being such a wee little school girl.  Look at them Canadian's…not a fuckin' word about the rain.
	
	choices[13] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370740} -- Just like fuckin' rainy Vancouver eh' troops?
	choices[14] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370750} -- At least Smithy won't fuckin' smell so bad!
	choices[15] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370760} -- Look at what I stole from one of the Brits!  A fuckin' umbrella!
	choices[16] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370770} -- No wonder your wet.  Use your shelter half as a cover you dumb fuck.
	choices[17] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370780} -- I betcha Jerry's sitting' cozy in some dry fuckin' bunker eating wieners and sauerkraut!
	choices[18] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1370790} -- Use your ground sheet to keep your kit dry boys.
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Event_Delay(0.5)
	
	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
	
	CTRL.WAIT()

end

