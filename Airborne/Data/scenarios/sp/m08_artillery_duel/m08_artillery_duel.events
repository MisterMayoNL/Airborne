EVENTS = {}

function NIS_Init()

	-- load NIS's
	NIS01 = "sp/M08_Artillery_Duel/NIS/N08_01"
	nis_load(NIS01)
	NIS02 = "sp/M08_Artillery_Duel/NIS/N08_02"
	nis_load(NIS02)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)






