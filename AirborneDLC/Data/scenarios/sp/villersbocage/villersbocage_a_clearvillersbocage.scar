--~ 	Util_CreateSquads(player, sgroup, sbp, location[, destination, numsquads, loadout, attackmove, facing, upgrades] )

-------------------------------------------------------------------------
-- Clear Villers-Bocage
-------------------------------------------------------------------------
-- Player's job is to find all the armor in the city and destroy it.
-- Climactic moment battling the fireflies at the end.
-------------------------------------------------------------------------
function Initialize_OBJ_ClearVillersBocage()

	OBJ_ClearVillersBocage = {
		
		SetupUI = function() 
			-- mark a point or position
			-- OBJ_ClearVillersBocage.mapElementID = Objective_AddUIElements(OBJ_ClearVillersBocage, mkr_marker, true, 000000, true)
			Objective_SetAlwaysShowDetails(OBJ_ClearVillersBocage, false, true, false)
		end,
		
		OnStart = function()
			
			-- announce the goal
			-- Util_AutoIntel(t_obj_title.EventStart)
			
			-- win/lose check
			Rule_AddInterval(ClearVillersBocage_WinCheck, 5)
			Util_AutoIntel(t_CVB.t_Speech.objStart)
			
			-- start related action
			ClearVillersBocage_Kickoff()
			
		end,
		
		OnComplete = function()
			
			-- tell the player they did good
			Util_AutoIntel(t_CVB.t_Speech.objComplete)
			SGroup_SetInvulnerable(sg_Tiger,true)
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 6019200,
		Description = 6019210,
		TitleEnd = 6019220,
		Type = OT_Primary,
		
		SitRep = {
			Movie = "SR_VillersBocage_A_01",
			Force = true,
			SpeechTiming =
			{
				{ 1,	ACTOR.CXP2.Voss, 6010501 },
				{ 4,	ACTOR.CXP2.Voss, 6010511 },
				{ 5,	ACTOR.CXP2.Voss, 6010521 },
				{ 8,	ACTOR.CXP2.Voss, 6010531 },
				{ 11,	ACTOR.CXP2.Voss, 6010532 },
				{ 14,	ACTOR.CXP2.Voss, 6010534 },
				{ 16,	ACTOR.CXP2.Voss, 6010536 },
			},
			
			PrologueEvent = function()
				
			end,
			
			EpilogueEvent = function()
				-- grant the player the command point if they have completed the objective
				-- if they haven't acquired a point yet
				if t_DC.bGrantResource ~= false then
					local num = 60 - Player_GetResource(player1, RT_Action)
					Player_AddResource(player1, RT_Action, num * 4)
				end
				
			end,
			
		},
	}
	
	-- Register Objective
	Objective_Register(OBJ_ClearVillersBocage)
	-- Initialize Data
	ClearVillersBocage_Init()
	
end

Scar_AddInit(Initialize_OBJ_ClearVillersBocage)

-------------------------------------------------------------------------
-- Clear Villers-Bocage - Functions 
-------------------------------------------------------------------------

function ClearVillersBocage_Init()

	-- markers
	tmkr_SpTank = Marker_GetTable("mkr_SpTank%d")
	tmkr_SpInf = Marker_GetTable("mkr_SpInf%d")
	tmkr_SpFirefly = Marker_GetTable("mkr_SpFirefly%d")

	-- define sgroups, egroups, etc associated with this obj
	tsg_CVBTank = SGroup_CreateTable("sg_CVBTank%d", table.getn(tmkr_SpTank))
	tsg_CVBTankAttacker = SGroup_CreateTable("sg_CVBTankAttacker%d", table.getn(tmkr_SpTank))
	tsg_CVBInf = SGroup_CreateTable("sg_CVBInf%d", table.getn(tmkr_SpInf))
	tsg_CVBInfAttacker = SGroup_CreateTable("sg_CVBInfAttacker%d", table.getn(tmkr_SpInf))
	tsg_CVBFirefly = SGroup_CreateTable("sg_CVBFirefly%d", table.getn(tmkr_SpFirefly))
	sg_CVBAllFireflies =  SGroup_CreateIfNotFound("sg_CVBAllFireflies")
	sg_CVBAllTanks	= SGroup_CreateIfNotFound("sg_CVBAllTanks")
	sg_FireflyAttacker = SGroup_CreateIfNotFound("sg_FireflyAttacker")
	sg_CVBUI = SGroup_CreateIfNotFound("sg_CVBUI")
	
	t_CVB = {
		t_tanks 			= {},
		t_inf 				= {},
		objUI				= false,
		sg_ObjUI			= sg_CVBUI,
		breakdownCount		= 4,		-- the required number of tanks to kill to start the breakdown event
		totalTanks			= table.getn(tmkr_SpTank),
		
		t_PrimaryTargets = {
			SBP.CW.CROMWELL,
			SBP.CW.STUART,
		},
		activateCritical	= false,
	}


	for i=1, table.getn(tmkr_SpTank) do 
		
		local sbp = SBP.CW.CROMWELL
		if math.mod(i, 4) == 0 then
			sbp = SBP.CW.STAGHOUND
		elseif math.mod (i, 8) == 0 then
			sbp = SBP.CW.STUART
		end	
		
		t_CVB.t_tanks[i] = {
			sgroup 			= tsg_CVBTank[i],
			sbp 			= sbp,
			posSpawn		= tmkr_SpTank[i],
			sg_attacker		= tsg_CVBTankAttacker[i],
			combatPlan		= CVB_GetRandomTankCombatPlan(sbp),
		}
		
	end
	
	t_CVB.t_tanks[6].combatPlan = COMBAT_PLAN.GENERIC.ALL.DoNothing
	t_CVB.t_tanks[2].combatPlan = COMBAT_PLAN.GENERIC.ALL.DoNothing
	
	for i=1, table.getn(tmkr_SpInf) do 
		
		local sbp = SBP.CW.TOMMIES
		local upg
		local loadout = World_GetRand(2, 5)
		local num = Marker_GetNumberAttribute(tmkr_SpInf[i], "CustomNumber")
		local cp = CVB_GetRandomInfCombatPlan()
		
		if num == 1 then
			sbp = SBP.CW.VICKERS_MG_SP
			loadout = nil
		elseif num == 3 then
			sbp = SBP.CW.SAPPER
			upg = UPG.SP.VILLERS_BOCAGE.PIAT
			cp = COMBAT_PLAN.GENERIC.INFANTRY.CloseDistance
		end
		
		t_CVB.t_inf[i] = {
			sgroup 			= tsg_CVBInf[i],
			sbp 			= sbp,
			posSpawn		= tmkr_SpInf[i],
			combatPlan		= cp,
			sg_attacker		= tsg_CVBInfAttacker[i],
			upg				= upg,
			loadout			= loadout,
			delayedSpawn	= false,
			bSpawned		= false,
		}
		
	end
	
	local difficulty = Game_GetSPDifficulty()
	if difficulty == GD_EXPERT then
		t_CVB.t_inf[5].upg = UPG.SP.VILLERS_BOCAGE.PIAT
		t_CVB.t_inf[3].upg = UPG.SP.VILLERS_BOCAGE.PIAT
		t_CVB.t_inf[6].upg = UPG.SP.VILLERS_BOCAGE.PIAT
	elseif difficulty == GD_HARD then
		t_CVB.t_inf[5].upg = UPG.SP.VILLERS_BOCAGE.PIAT
		t_CVB.t_inf[3].upg = UPG.SP.VILLERS_BOCAGE.PIAT
		t_CVB.t_inf[6].upg = UPG.SP.VILLERS_BOCAGE.BOYS_RIFLE
	else
		t_CVB.t_inf[5].upg = UPG.SP.VILLERS_BOCAGE.BOYS_RIFLE
		t_CVB.t_inf[3].upg = UPG.SP.VILLERS_BOCAGE.BOYS_RIFLE
		t_CVB.t_inf[6].upg = UPG.SP.VILLERS_BOCAGE.BOYS_RIFLE
	end
	
	t_CVB.t_inf[6].delayedSpawn = true
	t_CVB.t_inf[8].delayedSpawn = true
	t_CVB.t_inf[4].delayedSpawn = true
	t_CVB.t_inf[3].delayedSpawn = true
	t_CVB.t_inf[1].delayedSpawn = true
	
	
	----------------------------------------------------------------------------------
	-- ************************   FIREFLIES   ************************************* --
	----------------------------------------------------------------------------------
	
	t_CVB.t_firefly = {
		combatPlan			= CVB_GetRandomTankCombatPlan(sbp),
		t_Squads 			= {},
		bSpawned			= false,
		tanksLeft			= 2,		-- number of tanks left that will start the firefly attack event
		bSpotted			= false,
		numFireflies		= 2,		-- difficulty modifier to change the number of fireflies spawned (Max 3)
	}
	
	t_CVB.t_firefly.t_Inf = {
		{
			sbp				= SBP.CW.TOMMIES,
			upg				= UPG.CW.RIFLE_GRENADE,
			loadout			= nil,
			sg_tank			= tsg_CVBFirefly[1],
			posSpawn		= tmkr_SpFirefly[1],
			offset			= OFFSET_RIGHT,
		},
		{
			sbp				= SBP.CW.TOMMIES,
			upg				= nil,
			loadout			= 3,
			sg_tank			= tsg_CVBFirefly[1],
			posSpawn		= tmkr_SpFirefly[1],
			offset			= OFFSET_RIGHT,
		},
		{
			sbp				= SBP.CW.SAPPER,
			upg				= UPG.SP.VILLERS_BOCAGE.PIAT,
			loadout			= nil,
			sg_tank			= tsg_CVBFirefly[2],
			posSpawn		= tmkr_SpFirefly[2],
			offset			= OFFSET_RIGHT,
		},
		{
			sbp				= SBP.CW.TOMMIES,
			upg				= nil,
			loadout			= 3,
			sg_tank			= tsg_CVBFirefly[2],
			posSpawn		= tmkr_SpFirefly[2],
			offset			= OFFSET_LEFT,
		},
	}
	
	tsg_FireflyInf = SGroup_CreateTable("sg_FireflyInf%d", table.getn(t_CVB.t_firefly.t_Inf))
	
	for k, this in pairs(t_CVB.t_firefly.t_Inf) do 
		
		this.sgroup			= tsg_FireflyInf[k]
		this.offset_dist	= 10
		this.mkr_retreat	= mkr_ConvoyRetreatDelete
		
	end
	
	for i=1, t_CVB.t_firefly.numFireflies do 
		t_CVB.t_firefly.t_Squads[i] = {
			sgroup		= tsg_CVBFirefly[i],
			sbp			= SBP.CW.FIREFLY,
			posSpawn	= tmkr_SpFirefly[i],
			sg_attacker = sg_FireflyAttacker,		-- all the Fireflies share the attacker
			vulnMod		= 0.8						-- modifier for the vulnerabilty of the fireflies
		}
	end
	
	Cmd_InstantUpgrade(player2, UPG.SP.VILLERS_BOCAGE.FIREFLY_SMOKE)

	ClearVillersBocage_InitBreakdown()
	ClearVillersBocage_InitSpeech()
	ClearVillersBocage_Preset()

end

function ClearVillersBocage_InitBreakdown()
	----------------------------------------------------------------------------------
	-- ************************ TANK BREAKDOWN ************************************ --
	----------------------------------------------------------------------------------
	t_CVB.t_Breakdown = {
		tmrEvents 			= "TANK BREAKDOWN TIMER",
		tmrEventsAmt		= 1.25 * 60,
		count				= 5, 			-- number of tanks that need to be destroyed before the breakdown event will occur
		bStarted			= false,
	}
	
	t_CVB.t_Breakdown.t_Squads = {
		{
			sbp				= SBP.CW.BREN_CARRIER,
			upg				= UPG.CW.BREN_CARRIER_MMG,
			arrivalTime		= t_CVB.t_Breakdown.tmrEventsAmt - 10,
			combatPlan		= COMBAT_PLAN.GENERIC.VEHICLE.FlankLeftBehind,
			combatPlanId 	= false,
			offset			= OFFSET_FRONT
		},
		{
			sbp				= SBP.CW.STUART,
			upg				= nil,
			arrivalTime		= t_CVB.t_Breakdown.tmrEventsAmt - 20,
			combatPlan		= COMBAT_PLAN.GENERIC.VEHICLE.FlankRightBehind,
			combatPlanId 	= false,
			offset			= OFFSET_FRONT_RIGHT
		},
		{
			sbp				= SBP.CW.CROMWELL,
			arrivalTime		= t_CVB.t_Breakdown.tmrEventsAmt - 35,
			upg				= nil,
			combatPlan		= COMBAT_PLAN.GENERIC.ALL.Attack,
			combatPlanId 	= false,
			offset			= OFFSET_FRONT_RIGHT
		},
		{
			sbp				= SBP.CW.STAGHOUND,
			arrivalTime		= t_CVB.t_Breakdown.tmrEventsAmt - 45,
			upg				= nil,
			combatPlan		= COMBAT_PLAN.GENERIC.ALL.Attack,
			combatPlanId 	= false,
			offset			= OFFSET_FRONT_LEFT
		},
		{
			sbp				= SBP.CW.CROMWELL,
			arrivalTime		= t_CVB.t_Breakdown.tmrEventsAmt - 60,
			upg				= UPG.CW.TANKCOMMANDER,
			combatPlan		= COMBAT_PLAN.GENERIC.VEHICLE.FlankLeftBehind,
			combatPlanId 	= false,
			offset			= OFFSET_FRONT
		},
	}
	
	schroif_fuelfilter = {6011220, 6011230}
	local schroiftext = schroif_fuelfilter[World_GetRand(1, table.getn(schroif_fuelfilter))] 
	t_CVB.t_Breakdown.t_Events = {
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 1,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Starts Breaking Down")
				if SGroup_IsMoving(sg_Tiger, ANY) == false then
					Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
--~ 					UI_CreateSGroupKickerMessage(player1, sg_Tiger, LOC("Sputter"))
				end
				SGroup_OverrideCriticalDisplay(sg_Tiger, CT_VehicleEngineYellow, true, true)
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "grinding_long")
			end,
			speech = false
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 3,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Voss Requests Status Report")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss,  6012019 },
			}
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 4,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Tank Lurches")
				Cmd_Stop(sg_Tiger)
--~ 				UI_CreateSGroupKickerMessage(player1, sg_Tiger, LOC("Sputter"))
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6012000 },
			}
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 5,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Speech About Getting Fixed")
				Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
--~ 				UI_CreateSGroupKickerMessage(player1, sg_Tiger, LOC("Cough"))
			end,
			speech = false
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 6,
			execFunc 		= function()
				Cmd_Stop(sg_Tiger)
--~ 				UI_CreateSGroupKickerMessage(player1, sg_Tiger, LOC("Cough"))
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss, 6011170 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 7,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Checking Tank")
				Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
--~ 				UI_CreateSGroupKickerMessage(player1, sg_Tiger, LOC("Sputter, Cough, Groan"))
			end,
			speech = false
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 8,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Tank Breaks Down")
--~ 				Cmd_CriticalHit(player2, sg_Tiger, CRIT.VEH.MOBILITY_MAJOR, CRIT.DAMAGE_YELLOW)
				SGroup_SetAvgHealth( sg_Tiger, 0.3)
				t_CVB.t_Breakdown.bRepairing = true
				Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.SLOW_TURRET)
				SGroup_OverrideCriticalDisplay(sg_Tiger, CT_VehicleEngineYellow, false, true)
				SGroup_OverrideCriticalDisplay(sg_Tiger, CT_VehicleEngineRed, true, true)
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Shultz, 6011181 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 13,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Starting Repairs")
				Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR)
				SGroup_SetAnimatorState(sg_Tiger, "engine_backfire", "trouble")
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "fixing_bg")
				Rule_AddInterval(TankHeal_Rule_Continuous, 1)
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011160 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 23,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Checking Tank")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011190 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 28,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Smoke Defense")
				Misc_SelectSquad(SGroup_GetSpawnedSquadAt(sg_Tiger, 1), true)
				t_CVB.t_Breakdown.buttonID = HintPoint_AddToAbilityButton(ABILITY.SP.VILLERS_BOCAGE.TIGER_SMOKE, 6019509, true)
				t_CVB.t_Breakdown.flashID = UI_FlashAbilityButton(ABILITY.SP.VILLERS_BOCAGE.TIGER_SMOKE, true, BT_UI_Strong_AbilityBtn)
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss, 6031510 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 35,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Checking Tank")
				
				-- have the fireflies start attacking the player
				Rule_AddDelayedInterval(CVB_ManageFirefly, 1, 0.5)
				
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, schroiftext },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 47,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Fixed, Starting Engine")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss, 6011120 },
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011210 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 50,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Fixed, Starting Engine")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011260 },
				{ ACTOR.VILLERS_BOCAGE.Voss, 6011250 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 55,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Revving")
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "startup_long")
				t_CVB.t_Breakdown.bRepairing = false
				SGroup_OverrideCriticalDisplay(sg_Tiger, CT_VehicleEngineRed, false, true)
				Rule_Remove(TankHeal_Rule_Continuous)
				SGroup_SetAnimatorState(sg_Tiger, "blowtorch_state", "inactive")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011270 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 60,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Tank Starts Moving")
				Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.SLOW_TURRET)
				Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
				SGroup_SetAnimatorState(sg_Tiger, "engine_backfire", "healthy")
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "healthy")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011280 },
			},
		},
		{
			execTime 		= t_CVB.t_Breakdown.tmrEventsAmt - 65,
			execFunc 		= function()
				print("t_CVB.t_Breakdown.t_Events >> Tank Starts Moving")
				if SGroup_GetAvgHealth( sg_Tiger ) < 0.75 then
					SGroup_SetAvgHealth(sg_Tiger, 0.75)
				end
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss, 6011290 },
			},
		},
	}
	
	for k, this in pairs(t_CVB.t_Breakdown.t_Squads) do
		this.sgroup = SGroup_CreateIfNotFound("sg_Breakdown"..k)
		this.bSpawned = false
	end

end

function ClearVillersBocage_InitSpeech()

	
	t_CVB.t_Speech = {
		objStart = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010630 },
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010640 },
		},
		
		bProgressUpdate1 = false,
		progressUpdate1 = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010650 },
		},	
		
		bProgressUpdate2 = false,
		progressUpdate2 = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010660 },
		},
		
		bProgressUpdate3 = false,
		progressUpdate3 = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010670 },
		},
		
		fireflySpotted = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6011030 },
			{ ACTOR.VILLERS_BOCAGE.Schroif, 6011040 },
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6011050 },
		},
		
		bInfCombat	= false,
		tmrInfCombat = "CV TIMER INFANTRY COMBAT",
		infCombatRand = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6012034 },
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6012035 },
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6012036 },
		},
		
		objComplete = {
			{ ACTOR.VILLERS_BOCAGE.Shultz, 	6011060 },
		}	
	}

end


function ClearVillersBocage_Preset()

	-- spawn squads
	for k,this in pairs(t_CVB.t_tanks) do 
		Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn)
		SGroup_AddGroup(sg_CVBAllTanks, this.sgroup)
	end
	
	for k,this in pairs(t_CVB.t_inf) do 
		if this.delayedSpawn == false then
--~ 		Util_CreateSquads(player, sgroup, sbp, location[, destination, numsquads, loadout, attackmove, facing, upgrades] )
			Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn, nil, nil, this.loadout, nil, nil, this.upg)
			Util_GarrisonNearbyBuilding(this.sgroup, Util_GetPosition(this.posSpawn), 5)
			this.swid = SyncWeapon_GetFromSGroup(this.sgroup)
			this.bSpawned = true
		end
	end
	
	Rule_AddInterval(CVB_DelayStart, 1)

end

function CVB_DelayStart()

	-- start enemy behavior
	if Event_IsAnyRunning() == false then
		Rule_AddInterval(CVB_Rule_ManageTanks, 3)
		Rule_AddInterval(CVB_Rule_ManageInfantry, 5)
		Rule_RemoveMe()
	end
	
end

function CVB_ManageFirefly()

	-- runs the first time the rule is started to spawn the firefly ONLY once.
	if t_CVB.t_firefly.bSpawned == false then		
		
		for k, this in pairs(t_CVB.t_firefly.t_Squads) do
			Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn)
			SGroup_AddGroup(sg_CVBAllFireflies, this.sgroup)
			SGroup_AddGroup(sg_CVBAllTanks, this.sgroup)
			
			if k == 2 then
				Modify_ReceivedDamage(this.sgroup, 0.8)
				Cmd_InstantUpgrade(this.sgroup, UPG.CW.TANKCOMMANDER)
			else
				Modify_Vulnerability(this.sgroup, this.vulnMod)
			end
			
			Modify_WeaponAccuracy( this.sgroup, "hardpoint_01", 0.85 )
			
		end
		
		for k, this in pairs(t_CVB.t_firefly.t_Inf) do 
			Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn, nil, nil, this.loadout, nil, nil, this.upg)
		end
		
		t_CVB.t_firefly.bSpawned = true
	end
	
	for k, this in pairs(t_CVB.t_firefly.t_Inf) do 
		
		if SGroup_IsEmpty(this.sgroup) == false then
			if SGroup_IsEmpty(this.sg_tank) == true then
				Cmd_Retreat(this.sgroup, this.mkr_retreat)
			elseif SGroup_IsDoingAttack(this.sgroup, ANY, 15) == false
			and SGroup_IsMoving(this.sgroup, ANY) == false then
				local pos =  SGroup_GetOffsetPosition(this.sg_tank, this.offset, this.offset_dist)
				Cmd_AttackMove(this.sgroup, pos)
			end
		end
		
	end

	local all_dead = true
	for k, this in pairs(t_CVB.t_firefly.t_Squads) do 
		if SGroup_IsEmpty(this.sgroup) == false then
			
			if t_CVB.t_firefly.bSpotted == true then
				if this.objUI == nil then
					this.objUI = Objective_AddUIElements(OBJ_ClearVillersBocage, this.sgroup, true, nil, true)
					SGroup_AddGroup( t_CVB.sg_ObjUI, this.sgroup)
				end
			end
			
			if Player_CanSeeSGroup(player1, this.sgroup, ANY) == true
			and t_CVB.t_firefly.bSpotted == false then
				Objective_RemoveUIElements(OBJ_ClearVillersBocage, t_CVB.objUI)
				Objective_UpdateText(OBJ_ClearVillersBocage, 6019230)
				Util_AutoIntel(t_CVB.t_Speech.fireflySpotted)
				t_CVB.t_firefly.bSpotted = true
			end
			
			-- this is code that is countering a bug where the tank doesn't always die when
			-- it receives a red critical hit, so it can take 3+ shots to destroy a take completely.
			if SGroup_GetAvgHealth(this.sgroup) <= 0.1 then
--~ 				if SGroup_IsMoving(this.sgroup, ANY) then
--~ 					Cmd_CriticalHit(player2, this.sgroup, CRIT.VEH.CONTROL_FAST, CRIT.DAMAGE_RED)
--~ 				else
--~ 					SGroup_Kill(this.sgroup)
--~ 				end
			end
			
			-- perform two different maneuvers for each of the firefly tanks
			all_dead = false
			if k == 1 or table.getn(t_CVB.t_firefly.t_Squads) == 1 then
				
				
				if SGroup_IsUnderAttack(this.sgroup, ANY, 5) == true then
					Cmd_Ability(this.sgroup, ABILITY.SP.VILLERS_BOCAGE.FIREFLY_SMOKE, nil, nil, true)
				end
				
				if Prox_AreSquadsNearMarker(this.sgroup, mkr_VillersA_FireflyStandoff, ANY, 50) == false then
					Cmd_AttackMove(this.sgroup, mkr_VillersA_FireflyStandoff) 
				elseif CombatPlan_IsExecuting(this.combatPlanId) == false then
					if SGroup_GetAvgHealth(this.sgroup) <= 0.4 then
						t_CVB.t_firefly.combatPlan = COMBAT_PLAN.GENERIC.VEHICLE.MaximizeRange
					end
					
					if SGroup_IsUnderAttack(this.sgroup, ANY, 15) == true then
						SGroup_GetLastAttacker(this.sgroup, this.sg_attacker)
						
						if SGroup_IsEmpty(this.sg_attacker) == false then
							this.combatPlanId = CombatPlan_Add(this.sgroup, CVB_GetRandomTankCombatPlan(), this.sg_attacker)
						end
					elseif SGroup_IsEmpty(sg_Tiger) == false then
						local rand = World_GetRand(1, 6)
						
						if rand == 1 then
							SGroup_FacePosition(this.sgroup, SGroup_GetPosition(sg_Tiger))
						end
					end
				end
				
			else
				-- first check if the Tiger is anywhere near the other firefly, if not then hangout near the other Firefly
				if SGroup_IsEmpty( sg_Tiger ) == false
				and Prox_AreSquadsNearMarker( sg_Tiger, mkr_VillersA_FireflyStandoff, ANY, 175) == false then
					
					local rand = World_GetRand(1, 2)
					if rand == 1 then
						Cmd_Stop( this.sgroup )
					else
						SGroup_FacePosition(this.sgroup, SGroup_GetPosition(sg_Tiger))
					end
				-- otherwise check if the firefly is performing a combat maneuver, then tell him to attack	
				elseif CombatPlan_IsExecuting(this.combatPlanId) == false then
					if SGroup_GetAvgHealth(this.sgroup) <= 0.4 then
						t_CVB.t_firefly.combatPlan = COMBAT_PLAN.GENERIC.VEHICLE.MaximizeRange
					end
					
					if SGroup_IsEmpty(this.sg_attacker) == false then
						this.combatPlanId = CombatPlan_Add(this.sgroup, CVB_GetRandomTankCombatPlan(), this.sg_attacker)
					elseif SGroup_IsUnderAttack(this.sgroup, ANY, 15) == true then
						SGroup_GetLastAttacker(this.sgroup, this.sg_attacker)
						
						
						if SGroup_IsEmpty(this.sg_attacker) == false then
							this.combatPlanId = CombatPlan_Add(this.sgroup, CVB_GetRandomTankCombatPlan(), this.sg_attacker)
						end
					elseif SGroup_IsMoving(this.sgroup, ANY) == false then
						if SGroup_IsEmpty( sg_Tiger ) == false then
							Cmd_AttackMove(this.sgroup, sg_Tiger)
						end
					end
				end
			end
		else
			table.remove( t_CVB.t_firefly.t_Squads, k )
			
		end
	end
	
	if table.getn(t_CVB.t_firefly.t_Squads) == 0 then
		Rule_RemoveMe()
		return
	end


end

function CVB_GetRandomInfCombatPlan()
	
	local plans = {
		COMBAT_PLAN.GENERIC.ALL.DoNothing,
		COMBAT_PLAN.GENERIC.INFANTRY.FindCoverAndAttack,
		COMBAT_PLAN.GENERIC.INFANTRY.FightingWithdrawalToBuilding,
		COMBAT_PLAN.GENERIC.INFANTRY.CloseDistance,
		COMBAT_PLAN.GENERIC.INFANTRY.GarrisonNearTarget,
		t_DC.t_CombatPlanInf[1],			-- a combat plan to have the infantry retreat to a specific location on the map
	}
	
	local rand = World_GetRand(1, table.getn(plans)) 
	return plans[rand]

end

function CVB_GetRandomTankCombatPlan(sbp)

	local plans = {
		COMBAT_PLAN.GENERIC.ALL.Attack,
		COMBAT_PLAN.GENERIC.VEHICLE.FlankLeftBehind,
		COMBAT_PLAN.GENERIC.VEHICLE.FlankRightBehind,
		COMBAT_PLAN.GENERIC.VEHICLE.FlankRightFront,
		COMBAT_PLAN.GENERIC.VEHICLE.FlankLeftFront,
		COMBAT_PLAN.GENERIC.TANK.FlankingDoubleAttack,
		COMBAT_PLAN.GENERIC.VEHICLE.Withdraw,
		COMBAT_PLAN.GENERIC.VEHICLE.MaximizeRange,
	}
	
	if sbp == SBP.CW.CROMWELL then
		table.insert(plans, COMBAT_PLAN.CW.CROMWELL.RetreatAndFlankLeft)
		table.insert(plans, COMBAT_PLAN.CW.CROMWELL.RetreatAndFlankRight)
		table.insert(plans, COMBAT_PLAN.GENERIC.ALL.DoNothing)
	end
	
	if sbp == SBP.CW.STUART
	or sbp == SBP.CW.STAGHOUND then
		table.insert(plans, COMBAT_PLAN.GENERIC.ALL.DoNothing)
	end
	
	local rand = World_GetRand(1, table.getn(plans)) 
	return plans[rand]

end


function ClearVillersBocage_WinCheck()
	
	-- update the UI
	if SGroup_IsEmpty(t_CVB.sg_ObjUI)
	and SGroup_IsEmpty(sg_Tiger) == false then
		Player_GetAllSquadsNearMarker(player2, sg_temp, SGroup_GetPosition(sg_Tiger), 150)
		SGroup_Filter(sg_temp, t_CVB.t_PrimaryTargets, FILTER_KEEP)
		if SGroup_IsEmpty(sg_temp) == false then
			SGroup_Add(t_CVB.sg_ObjUI, SGroup_GetRandomSpawnedSquad(sg_temp))
		elseif SGroup_IsEmpty(sg_CVBAllTanks) == false then
			SGroup_Add(t_CVB.sg_ObjUI, SGroup_GetRandomSpawnedSquad(sg_CVBAllTanks))
		end
		
		t_CVB.objUI = Objective_AddUIElements(OBJ_ClearVillersBocage, t_CVB.sg_ObjUI, true, nil, true)
	end
	
	if t_CVB.t_Speech.bProgressUpdate1 == false
	and SGroup_CountSpawned(sg_CVBAllTanks) <= (t_CVB.totalTanks * 0.75) then
		Util_AutoIntel(t_CVB.t_Speech.progressUpdate1)
		t_CVB.t_Speech.bProgressUpdate1 = true
	elseif t_CVB.t_Speech.bProgressUpdate2 == false
	and SGroup_CountSpawned(sg_CVBAllTanks) <= (t_CVB.totalTanks * 0.5) then
		Util_AutoIntel(t_CVB.t_Speech.progressUpdate2)
		t_CVB.t_Speech.bProgressUpdate2 = true
	elseif t_CVB.t_Speech.bProgressUpdate3 == false
	and SGroup_CountSpawned(sg_CVBAllTanks) <= (t_CVB.totalTanks * 0.25) then
		Util_AutoIntel(t_CVB.t_Speech.progressUpdate3)
		t_CVB.t_Speech.bProgressUpdate3 = true
	end
	
	-- insert breakdown delay
	if SGroup_CountSpawned(sg_CVBAllTanks) <= (t_CVB.totalTanks - t_CVB.t_Breakdown.count)
	and t_CVB.t_Breakdown.bStarted == false 
	and t_CVB.t_firefly.bTriggered == true then -- see below
		if Rule_Exists(CVB_StartBreakdown) == false then
			Rule_AddDelayedInterval(CVB_StartBreakdown, 15, 2)
		end
		t_CVB.t_Breakdown.bStarted = true
	end
	
	-- trigger for the breakdown delay
	if SGroup_CountSpawned(sg_CVBAllTanks) <= t_CVB.t_firefly.tanksLeft
	and Rule_Exists(CVB_ManageFirefly) == false 
	and t_CVB.t_firefly.bSpawned == false then
		-- adding a delay to the fireflies to give time for the breakdown
		-- see above
		t_CVB.t_firefly.bTriggered = true
		-- Rule_AddInterval(CVB_ManageFirefly, 0.5)
	end
	
	if t_CVB.t_firefly.bSpawned == true
	and SGroup_IsEmpty(sg_CVBAllFireflies) == true then
		Objective_Complete(OBJ_ClearVillersBocage, false)
		Rule_RemoveMe()
		return
	end
	
end

function ClearVillersBocage_Debug()

	-- add in the necessary information that can automatically start this objective 
	-- with the press of a hotkey
	if Objective_IsStarted(OBJ_ClearVillersBocage) == false then
		Objective_Start(OBJ_ClearVillersBocage)
	else
		SGroup_DestroyAllSquads(sg_CVBAllTanks)
		t_CVB.t_firefly.bSpawned = true
	end
	

end



function ClearVillersBocage_Kickoff()

	
end

function CVB_Rule_ManageTanks()

	-- Adding additional data for the AT Guns to the tank management code

	for k,this in pairs(t_CVB.t_tanks) do 
		if SGroup_IsEmpty(this.sgroup) == false then
			
			-- this is code that is countering a bug where the tank doesn't always die when
			-- it receives a red critical hit, so it can take 3+ shots to destroy a take completely.
			if SGroup_GetAvgHealth(this.sgroup) <= 0.1 then
--~ 				if SGroup_IsMoving(this.sgroup, ANY) then
--~ 					Cmd_CriticalHit(player2, this.sgroup, CRIT.VEH.CONTROL_FAST, CRIT.DAMAGE_RED)
--~ 				else
--~ 					SGroup_Kill(this.sgroup)
--~ 				end
			
			elseif CombatPlan_IsExecuting(this.combatPlanId) == false then
				
				if this.combatPlan == COMBAT_PLAN.GENERIC.ALL.DoNothing
				and SGroup_IsDoingAbility(this.sgroup, ABILITY.COMMANDER_TREE.CW.HULL_DOWN, ANY) == false then
					Cmd_Ability( this.sgroup, ABILITY.COMMANDER_TREE.CW.HULL_DOWN)
				end
				
				-- check if the Tiger is near the tank or whether the tank is actually under attack
				-- or whether or not the fireflies have spawned, then attack the player
				-- get spotted
				if this.spotted == nil and
					(SGroup_IsEmpty(sg_Tiger) == false 
					and Player_CanSeeSGroup(player1, this.sgroup, ANY)
					and SGroup_IsOnScreen(player1, this.sgroup, ANY, 0.85) == true) then
					this.spotted = World_GetRand(1,5) -- this value = 3-15 secs (rule is called every 3)
				end
				-- delay action
				if scartype(this.spotted) == ST_NUMBER then
					if this.spotted <= 0 then
						this.spotted = true
					else
						this.spotted = this.spotted-1
					end
				end
				-- spotted or under attack?
				if this.spotted == true
				or SGroup_IsUnderAttack(this.sgroup, ANY, 15) == true 
				or t_CVB.t_firefly.bSpawned == true then
					SGroup_GetLastAttacker(this.sgroup, this.sg_attacker)
					if SGroup_IsEmpty(this.sg_attacker) == true then
						SGroup_AddGroup(this.sg_attacker, sg_Tiger)
					end
					
					if t_CVB.t_firefly.bSpawned == true 
					and this.combatPlan == COMBAT_PLAN.GENERIC.ALL.DoNothing then
						this.combatPlan = COMBAT_PLAN.GENERIC.ALL.Attack
					end
					
					if SGroup_IsEmpty(this.sg_attacker) == false then
						this.combatPlanId = CombatPlan_Add(this.sgroup, this.combatPlan, this.sg_attacker)
					end
					
				end
			end
		else
			table.remove(t_CVB.t_tanks, k)
		end
	end

end

function CVB_Rule_ManageInfantry()

	-- code to tell the player to stop attacking the infantry 
	if Event_IsAnyRunning() == false
	and Objective_IsComplete( OBJ_DestroyConvoy ) == true
	and SGroup_IsEmpty( sg_Tiger ) == false then
		if SGroup_IsDoingAttack( sg_Tiger, ANY, 10) == true
		or SGroup_IsUnderAttack( sg_Tiger, ANY, 10) == true then
			SGroup_GetLastAttacker( sg_Tiger, sg_temp)
			
			-- check the number of squads attacking the player
			local size = SGroup_CountSpawned( sg_temp )
			-- remove anything but the infantry
			SGroup_Filter( sg_temp, {SBP.CW.SAPPER, SBP.CW.TOMMIES, SBP.CW.VICKERS_MG_SP}, FILTER_KEEP )
			-- if the number of squads has not changed after the filter, then let's assume that the player is only 
			-- battling infantry
			if size ~= 0 
			and size == SGroup_CountSpawned(sg_temp)
			and SGroup_IsEmpty( sg_temp ) == false  then
				-- play speech telling the player he needs to move on and start battling the tanks
				if Timer_Exists( t_CVB.t_Speech.tmrInfCombat ) == false
				or Timer_GetRemaining( t_CVB.t_Speech.tmrInfCombat ) <= 0 then
					if t_CVB.t_Speech.bInfCombat == false then
						Util_AutoIntel(t_CVB.t_Speech.infCombatRand, true)
					end
					Timer_Start( t_CVB.t_Speech.tmrInfCombat, 60)
					t_CVB.t_Speech.bInfCombat = true
				end
			elseif Timer_Exists( t_CVB.t_Speech.tmrInfCombat ) == false
			or Timer_GetRemaining(t_CVB.t_Speech.tmrInfCombat) == 0 then
				Timer_Start( t_CVB.t_Speech.tmrInfCombat, 60)
				t_CVB.t_Speech.bInfCombat = false
			end
		end
	end


	for k, this in pairs(t_CVB.t_inf) do 
		if this.bSpawned == false then
			if Prox_AreSquadsNearMarker(sg_Tiger, this.posSpawn, ANY, 40) then
				local pos = World_GetHiddenPositionOnPath(player1, Util_GetOffsetPosition(this.posSpawn, OFFSET_BACK, 100), this.posSpawn, CHECK_OFFCAMERA)
				if pos ~= nil then
					Util_CreateSquads(player2, this.sgroup, this.sbp, pos, nil, nil, this.loadout, nil, nil, this.upg)
					Util_GarrisonNearbyBuilding(this.sgroup, Util_GetPosition(this.posSpawn), 15)
					this.bSpawned = true
				end
			end
		elseif SGroup_IsEmpty(this.sgroup) == false
		and SGroup_IsUnderAttack(this.sgroup, ANY, 15) == true then
			SGroup_GetLastAttacker(this.sgroup, this.sg_attacker)
			if SGroup_IsEmpty(this.sg_attacker) == false then
				if CombatPlan_IsExecuting(this.combatPlanId) == false then
					this.combatPlanId = CombatPlan_Add(this.sgroup, this.combatPlan, this.sg_attacker)
				end
			end
		end
	end

end










function CVB_StartBreakdown()

	if SGroup_IsUnderAttack(sg_Tiger, ANY, 5) == false then
		if Rule_Exists(CVB_RuleBreakdown) == false then
			Rule_AddInterval(CVB_RuleBreakdown, 1)
		end
		TankHeal_Stop()
		
		Timer_Start(t_CVB.t_Breakdown.tmrEvents, t_CVB.t_Breakdown.tmrEventsAmt)
		Rule_RemoveMe()
	end

end


function CVB_RuleBreakdown()

	if Timer_GetRemaining(t_CVB.t_Breakdown.tmrEvents) == 0 then
		CVB_FinishBreakdown()
		Rule_RemoveMe()
		return
	end
	
	-- don't try to run this rule if the tiger has died
	if SGroup_IsEmpty(sg_Tiger) == true then
		return
	end
	
	if t_CVB.t_Breakdown.bRepairing == true
	and g_difficulty ~= GD_EXPERT
	and SGroup_IsDoingAbility(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR, ANY) == false then
		Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR)
	end
	
	local remain = Timer_GetRemaining(t_CVB.t_Breakdown.tmrEvents)
	for k, this in pairs(t_CVB.t_Breakdown.t_Squads) do
		
		if this.bSpawned == false 
		and remain <= this.arrivalTime then
			local posSpawn = Util_GetOffsetPosition(sg_Tiger, this.offset, 60)
--~ 		Util_CreateSquads( player, sgroup, 	sbp, 	spawn_point[, destination, numsquads, loadout, attackmove, dest_facing, upgrades, spawn_facing] )
			Util_CreateSquads(player2, this.sgroup, this.sbp, posSpawn, nil, nil, this.loadout, nil, nil, this.upg, SGroup_GetPosition(sg_Tiger))
			this.combatPlanId = CombatPlan_Add(this.sgroup, this.combatPlan, sg_Tiger)
			this.bSpawned = true
			break
		elseif SGroup_IsEmpty(this.sgroup) == false then
			Cmd_AttackMove(this.sgroup, sg_Tiger)
--~ 			if CombatPlan_IsExecuting(this.combatPlanId) == false then
--~ 				this.combatPlanId = CombatPlan_Add(this.sgroup, this.combatPlan, sg_Tiger)
--~ 			end
		end
	end
	
	for k, this in pairs(t_CVB.t_Breakdown.t_Events) do
		
		if remain <= this.execTime then
			this.execFunc()
			table.remove(t_CVB.t_Breakdown.t_Events, k)
			if scartype(this.speech) == ST_TABLE then
				Util_AutoIntel(this.speech)
			end
		end
	end

end


function CVB_FinishBreakdown()
	
	UI_StopFlashing( t_CVB.t_Breakdown.flashID )
	HintPoint_Remove( t_CVB.t_Breakdown.buttonID )
	TankHeal_AddSGroup(sg_Tiger)
	Modifier_Remove(g_StopTank)

end