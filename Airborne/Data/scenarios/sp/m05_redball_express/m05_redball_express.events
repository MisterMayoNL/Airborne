--
-- NIS File for Mission 5 - REDBALL EXPRESS
--
-------------------------------------------------------------------------
-------------------------------------------------------------------------

function NIS_Init()

	-- load NIS's
	NIS01 = "SP/M05_Redball_Express/NIS/N05_01"
	nis_load(NIS01)
	NIS02 = "SP/M05_Redball_Express/NIS/N05_02"
	nis_load(NIS02)
	NIS03 = "SP/M05_Redball_Express/NIS/N05_03"
	nis_load(NIS03)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)





EVENTS = {}


--------------------------------------------------------------------------------
-- NIS EVENTS
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- NIS01: RESCUE DOG COMPANY
--------------------------------------------------------------------------------

EVENTS.NIS01 = function()
	-- set speech and sfx volume groups to 0 so we don't hear any audio in between NIS and Sit Rep.  Sit Rep transition out will re-set volume groups.
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)

	CTRL.Game_Letterbox(true, 1)
		Game_FadeToBlack(FADE_IN, 1)
		FOW_Enable(false)
	CTRL.WAIT()
	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()

	nis_stop()
	
--	CTRL.Game_Letterbox(false, 1)
--	Game_SetMode(UI_Fullscreen)
--	Game_FadeToBlack(FADE_OUT, 1.5)
	CTRL.WAIT()
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	FOW_Enable(true)
	CTRL.WAIT()
	
end




--------------------------------------------------------------------------------
-- NIS02: PANZERS ARRIVE
--------------------------------------------------------------------------------

EVENTS.NIS02 = function()

	CTRL.Game_Letterbox(true, 1)
		FOW_Enable(false)
		g_NISpanzCam = Camera_GetTargetPos()
	CTRL.WAIT()
	
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()

	nis_stop()
	
	CTRL.Game_Letterbox(false, 1)
		FOW_Enable(true)
		local pos = Marker_GetPosition(mkr_panzer_trigger)
		FOW_RevealArea(pos, 40, 60)
	CTRL.WAIT()
	
end






--------------------------------------------------------------------------------
-- NIS03: ON TO CHERBOURG
--------------------------------------------------------------------------------

EVENTS.NIS03 = function()

	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()
	Game_FadeToBlack(FADE_OUT, 2)
	Sound_SetVolume("Speech", 0.0, 1.5)
	Sound_SetVolume("SFXmaster", 0.0, 1.5)
	CTRL.Event_Delay(2)
	CTRL.WAIT()
	FOW_Enable(false)
	
	CTRL.Event_Delay(1)
	CTRL.WAIT()

	Game_FadeToBlack(FADE_IN, 1)
	
	Util_ClearWrecksFromMarker(Marker_LeftJunction)
	World_ClearCasualties()
	CTRL.Scar_PlayNIS(NIS03)
	CTRL.WAIT()
	
	nis_stop()
	
--	CTRL.Game_Letterbox(false, 1)
		FOW_Enable(true)
	CTRL.WAIT()

	--[[ set view ]]
	Camera_ResetToDefault()
	Camera_FocusOnTargetPos(Marker_GetPosition(mkr_player1_start1))
	
end



