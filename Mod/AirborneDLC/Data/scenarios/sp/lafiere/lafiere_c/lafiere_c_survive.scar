-------------------------------------------------------------------------
-- Survive
-------------------------------------------------------------------------
-- Short descriptive name of what the player is cht_eventsed to do
-- give a brief description of win conditions and loose conditions if any 
-- also describe the kind of challenges the player will face
-------------------------------------------------------------------------
function Initialize_OBJ_Survive()

	OBJ_Survive = {
		
		SetupUI = function() 
			-- mark a point or position
			-- OBJ_Survive.mapElementID = Objective_AddUIElements(OBJ_Survive, mkr_marker, true, 000000, true)
			OBJ_Survive.mapElementID = Objective_AddUIElements(OBJ_Survive, mkr_causeway3, true, 9439000, true)
			Objective_SetAlwaysShowDetails(OBJ_Survive, true, true, false)
		end,
		
		OnStart = function()
			
			-- announce the goal
			
			-- win/lose check
			Rule_AddInterval(Survive_Rule_WinCheck, 5)
			
			-- start related action
			Survive_Kickoff()
			-- EncounterName_Kickoff()
			SGroup_SetCrushable(sg_p1_craft, false)
		end,
		
		OnComplete = function()
			
			Player_AddResource(player1, RT_Munition, 300)
			
			-- move ABLE and BAKER in 
			Survive_AbleBakerArrive()
			
			-- shermans move up 
			Sherman_Kickoff()
			
			Rule_AddInterval(Survive_CauquinyTaken, 5)
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
--~ 		Title = 9439020, -- Destroy the HMG Emplacements
--~ 		Description = 9439030, -- Neutralize the HMG bunkers to inspire your men enough to charge across the Causeway and join you in battle.

		Title = 9439000, -- Cross the Causeway
		Description = 9439010, -- In order to take back Cauquigny, you must cross the Causeway. Order the paratroopers to make the charge.
		Type = OT_Primary,
		
--~ 		SitRep = {}, -- only needed once the SitRep is created and there are lines of dialogue.
	}
	
	-- Register Objective
	Objective_Register(OBJ_Survive)
	
	-- Initialize Data
	Survive_Init()
	
end

function Survive_CauquinyTaken()
	if Prox_ArePlayersNearMarker(player3, mkr_cauq2, false) == false then
		-- capture the territory
		if EGroup_IsCapturedByPlayer(eg_control_west, player1, true) == false then
			EGroup_InstantCaptureStrategicPoint(eg_control_west, player1)
		end
		Util_AutoIntel(t_survive.events.CauqTaken)
		
		-- change retreat point to Cauqinay 
		if EGroup_IsEmpty(eg_retreat_point) == false then
			EGroup_DestroyAllEntities(eg_retreat_point)
		end
		Util_CreateEntities(player1, eg_retreat_point, EBP.SP.LA_FIERE.RETREAT_POINT, mkr_cauq2, 1)
		
		Rule_RemoveMe()
	end
end

Scar_AddInit(Initialize_OBJ_Survive)

