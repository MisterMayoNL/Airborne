g_ACTIVE_SECTOR = 1
t_roof_reactions = {271750, 271760, 271770, 271695}
EVENTS.M07_BD_NearSector = function()
	if g_ACTIVE_SECTOR == 8 then
		local text = t_roof_reactions[World_GetRand(1, table.getn(t_roof_reactions))]
		CTRL.Actor_PlaySpeech(ACTOR.GenericAxis, text)
		CTRL.WAIT()
	else
		CTRL.Actor_PlaySpeech(ACTOR.GenericAxis, t_sector_text[g_ACTIVE_SECTOR])
		CTRL.WAIT()
	end
end

