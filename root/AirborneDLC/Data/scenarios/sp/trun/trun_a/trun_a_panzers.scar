-- 'Init()' is used to initialize the Obj data
-- anything that needs to be there for the Obj to work
-- does not need to be called at 'OnInit()'
function Panzers_Init()

	-- define sgroups, egroups, etc associated with this obj
	sg_panzers_A = SGroup_CreateTable("sg_panzers_A%d", 5)
	sg_panzers_B = SGroup_CreateTable("sg_panzers_B%d", 5)
	sg_panzersA_All = SGroup_CreateIfNotFound("sg_panzersA_All")
	sg_panzersB_All = SGroup_CreateIfNotFound("sg_panzersB_All")
	sg_panzers_lead = SGroup_CreateIfNotFound("sg_panzers_lead")
	-- phase I
	sg_p4_all = SGroup_CreateIfNotFound("sg_p4_all")
	sg_p1_all = SGroup_CreateIfNotFound("sg_p1_all")
	sg_p4_para = SGroup_CreateTable("sg_p4_para%d", 10)
	sg_p4_parasAll = SGroup_CreateIfNotFound("sg_p4_parasAll")
	sg_temp = SGroup_CreateIfNotFound("sg_temp")
	-- phase II
	sg_p4_reconInf = SGroup_CreateTable("sg_p4_reconInf%d", 5)
	sg_p4_hound = SGroup_CreateTable("sg_p4_hound%d", 3)
	sg_p4_houndAll = SGroup_CreateIfNotFound("sg_p4_houndAll")
	
	if Misc_IsCommandLineOptionSet("test_objectives") then
--~ 		Scar_DebugConsoleExecute("bind([[ALT+1]], [[Scar_DoString('Util_StartNIS(EVENTS.NIS01)')]])")		
	end

