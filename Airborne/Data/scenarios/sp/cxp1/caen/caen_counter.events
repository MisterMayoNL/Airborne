	choices[2] = {actor = ACTOR.CXP1.Chubb, line = 1371210} -- Stand fast men!  Don't let them through!
	choices[3] = {actor = ACTOR.CXP1.Chubb, line = 1371220} -- Get fire on those assholes!  Come on!  Let 'em have it!
	
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371230} -- There's too many of 'em!
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1371240} -- We're gonna get over run!
