EVENTS.NIS02 = function()

	CTRL.Game_Letterbox(true, 1)
	CTRL.WAIT()	
	
	Game_FadeToBlack(FADE_OUT, 1.5)
	CTRL.Event_Delay(2)
	CTRL.WAIT()

	Util_HidePlayerForNIS(player1, true)
	FOW_Enable(false)

	Game_FadeToBlack(FADE_IN, 1)
	
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()

	FOW_Enable(true)
	Util_HidePlayerForNIS(player1, false)

	FOW_RevealSGroupOnly(PanzerAlpha1, -1)
	FOW_RevealSGroupOnly(WehrmachtAlpha1, -1)
	FOW_RevealSGroupOnly(WehrmachtAlpha2, -1)
	Cmd_Move(WehrmachtAlpha1, ResourcePoint5)
	Cmd_Move(WehrmachtAlpha2, ResourcePoint5)
	Cmd_Move(PanzerAlpha1, EGroup_GetPosition_EVEN_IF_EMPTY(ResourcePoint5), nil, nil, nil, OFFSET_FRONT, 10)

	CTRL.Game_Letterbox(false, 0.75)
	CTRL.WAIT()

	Objective_SetAlwaysShowDetails(OBJECTIVE2, false, true)
	
end

