		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.ELITE.PANTHER_BATTLEGROUP, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.ALLIES.ARMOR, ITEM_LOCKED)
		 --Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.ALLIES.INFANTRY_02, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.AXIS.PROPAGANDA_02, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.AXIS.BLITZKRIEG_01, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.AXIS.BLITZKRIEG_02, ITEM_REMOVED)
