function NIS_Init()

	-- load NIS's
	NIS01 = "sp/M12_Death_Of_A_Division/NIS/N12_01"
	nis_load(NIS01)
	NIS02 = "sp/M12_Death_Of_A_Division/NIS/N12_02"
	nis_load(NIS02)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)




