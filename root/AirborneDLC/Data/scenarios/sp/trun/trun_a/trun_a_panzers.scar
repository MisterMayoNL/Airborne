-------------------------------------------------------------------------
-- Protect Panzers
-------------------------------------------------------------------------
-- Short descriptive name of what the player is cht_eventsed to do
-- give a brief description of win conditions and loose conditions if any 
-- also describe the kind of challenges the player will face
-------------------------------------------------------------------------
function Initialize_OBJ_Panzers()

	OBJ_Panzers = {
		
		SetupUI = function() 
			-- mark a point or position
			-- OBJ_Panzers.mapElementID = Objective_AddUIElements(OBJ_Panzers, mkr_marker, true, 000000, true)
			Objective_SetAlwaysShowDetails(OBJ_Panzers, true, true, true)
		end,
		
		OnStart = function()
			-- because of the mid-mission sitrep 
			if t_panzers.started ~= true then
				t_panzers.started = true
				-- announce the goal
				-- Util_AutoIntel(t_panzers.events.Start)
				
				-- win/lose check
				Rule_AddInterval(Panzers_Rule_WinCheck, 5)
				
				-- start related action
				Panzers_Kickoff()
				-- EncounterName_Kickoff()
			end
		end,
		
		OnComplete = function()
			
			-- tell the player they did good
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 9394516,
		Description = 9394517,
		TitleEnd = 9394518,
		Type = OT_Primary,
		
		SitRep_DoNotGrantYet = {
			Movie = "SR_Trun_A",
			Force = true,
			--[[]]SpeechTiming =
			{
				{ 1,	ACTOR.TRUN.Funke, 9390520 },
				{ 3,	ACTOR.TRUN.Funke, 9390530 },
				{ 5,	ACTOR.TRUN.Funke, 9390531 },
				{ 8,	ACTOR.TRUN.Funke, 9390540 },
			},
			
			PrologueEvent = function()
				
			end,
			
			EpilogueEvent = function()
				
			end,
			
		},
	}
	
	-- Register Objective
	Objective_Register(OBJ_Panzers)
	
	-- Initialize Data
	Panzers_Init()
	
end

Scar_AddInit(Initialize_OBJ_Panzers)

