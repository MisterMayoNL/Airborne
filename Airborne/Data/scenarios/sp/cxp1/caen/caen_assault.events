EVENTS.Ambient_Help_Ally = function()
	local choices = {}

	choices[1] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351240}	-- Covering fire on the flank!  They're tryin' to swing 'round mate!
	choices[2] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351241}	-- Cuntybuggeryfucktoleybumshite! Kill those fuckers lads!
	choices[3] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351250}	-- We've lost 2 section! All bloody hell!
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351260}	-- Grant Justin's fuckin'hit!  He's fucked mate!  
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351261}	-- Where the bloody hell is 3rd Battalion?!
	choices[6] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351262}	-- Come on Boudica's boys we need you!
	choices[7] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351263}	-- Get another message up the chain!  We need the 3rd over here right bloody now!
	choices[8] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351264}	-- We've lost a fuckin' section there! 
	choices[9] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351265}	-- There's a whole other fuckin company! 
	choices[10] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351266}	-- Watch 'em there, wha?!  They're tryin' to flank us!
	choices[11] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351267}	-- We've lost the RSM!
	choices[12] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351268}	-- Where's the OC, what?  We need to get a message out to headquarters!
	choices[13] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351270}	-- We're on the way lads!  Hold on! 
	choices[14] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351280}	-- Fuckin' hell!  We need to get over there!
	choices[15] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1351281}	-- Shite! Shite! They killed little Darwin!
	choices[16] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352190}	-- Kill those blummin sheep shagging bastards, for Darwin lads!
	choices[17] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352191}	-- Creeping bloody Huns put up a good fight!
	choices[18] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1352192}	-- Get the balance of the men!  We need to get over there!


	local rand = World_GetRand(1, table.getn(choices))

	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
end


