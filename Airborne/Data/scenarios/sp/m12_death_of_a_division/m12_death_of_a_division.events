g_OBJ_DP_Tactics = 1
t_dp_tactics = {320550, 320560, 320570, 320580}
EVENTS.OBJ_DP_PantherTactics = function()
	if g_OBJ_DP_Tactics < table.getn(t_dp_tactics) then
		local text = t_dp_tactics[g_OBJ_DP_Tactics]
		CTRL.Actor_PlaySpeech(ACTOR.Conti, text)
		CTRL.WAIT()
		g_OBJ_DP_Tactics = g_OBJ_DP_Tactics + 1
	end
end

