		 Player_SetSquadProductionAvailability(World_GetPlayerAt(i),SBP.CW.FIREFLY, ITEM_REMOVED)
		 Player_SetSquadProductionAvailability(World_GetPlayerAt(i),SBP.ELITE.ARMOURCAR_222, ITEM_REMOVED)
		 Player_SetSquadProductionAvailability(World_GetPlayerAt(i),SBP.ELITE.ARMOURCAR_223, ITEM_REMOVED)
		 Player_SetSquadProductionAvailability(World_GetPlayerAt(i),SBP.ELITE.HALFTRACK_250, ITEM_REMOVED)
		 Player_SetSquadProductionAvailability(World_GetPlayerAt(i),SBP.ELITE.HALFTRACK_MORTAR, ITEM_REMOVED)
		 Player_SetSquadProductionAvailability(World_GetPlayerAt(i),SBP.ELITE.HALFTRACK_SNIPER, ITEM_REMOVED)
