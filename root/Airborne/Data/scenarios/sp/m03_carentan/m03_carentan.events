EVENTS.NIS02 = function()
	
	CTRL.Game_Letterbox( true, 1.5 ) 
	CTRL.WAIT()
	
	Game_FadeToBlack(FADE_OUT, 1.5)
	Sound_SetVolume("Speech", 0.0, 1.5)
	Sound_SetVolume("SFXmaster", 0.0, 1.5)
	CTRL.Event_Delay(2)
	CTRL.WAIT()
	Modifier_Remove(modifymanpower)
	SGroup_DestroyAllSquads(sg_AxisTownHall)
	SGroup_DestroyAllSquads(sg_AxisResourcePoint5)
	SGroup_Hide(sg_AllyTownHall, true)
	
--	Camera_MoveToPosition(Marker_D18, 5)
	FOW_Enable(false)
	Game_FadeToBlack(FADE_IN, 1.5)
	World_ClearCasualties()
	CTRL.Scar_PlayNIS(NIS02)									-- KIll the running Axis
	CTRL.WAIT()
--	Game_FadeToBlack(FADE_OUT, 0)
	FOW_Enable(true)

end

