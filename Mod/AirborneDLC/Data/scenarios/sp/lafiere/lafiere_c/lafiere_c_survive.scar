-- preset any units or events needed before the kickoff, but you do not
-- want them to occur at the outset of the map.
-- Example: Often units are needed to exist before the objective start (because they start the objective)
-- then spawn those units here when they need to be spawned

function Survive_FireForEffect()

	if g_stopFire == true then
		Rule_RemoveMe()
	else
		local t_artysplash = {mkr_fireForEffect1, mkr_fireForEffect2, mkr_fireForEffect3, mkr_fireForEffect4, mkr_fireForEffect5, mkr_fireForEffect6}
		Table_GetRandomItem(t_artysplash)
		Cmd_Ability(player3, ABILITY.SP.SINGLE_HOWITZER, Util_GetRandomPosition(Table_GetRandomItem(t_artysplash), 5), nil, true)
	end
end


function Survive_CausewayRun()
	if t_survive.beginParas ~= nil then
		Survive_OrderstoRunCreate()
		
		local player1_fortifications = EGroup_CreateIfNotFound("player1_fortifications")
		
		Player_GetAllEntitiesNearMarker(player1, player1_fortifications, mkr_cauq2)
		
		if player1_fortifications ~= nil and EGroup_IsEmpty(player1_fortifications) == false then
			EGroup_DestroyAllEntities(player1_fortifications)
		end
		
		Util_ClearWrecksFromMarker(mkr_cauq2)
		
		Player_GetAllEntitiesNearMarker(player1, player1_fortifications, mkr_causeway2)
		
		if player1_fortifications ~= nil and EGroup_IsEmpty(player1_fortifications) == false then
			EGroup_DestroyAllEntities(player1_fortifications)
		end
		
		Util_ClearWrecksFromMarker(mkr_causeway2)
		
		Rule_AddDelayedInterval(Survive_FireForEffect, 2, 2)
		
		Rule_RemoveMe()
	end
end

function Survive_OrderstoRunCreate()
-- Create the initial squads for the Causeway run, add them to their respective Sgroups
-- Also have them run up to the front lines and find cover

	for k,v in pairs(t_survive.beginParas) do
		
		Util_CreateSquads(player2, v.name, v.sbp, v.spawn, v.dest, v.squads, v.num) 
		SGroup_SetSelectable(v.name, false)
		SGroup_SetMoveType(v.name, MOVETYPE.FAST)
		SGroup_EnableUIDecorator(v.name, false)
	end

	if SGroup_IsEmpty(t_survive.beginParas[1].name) == false then
		Camera_FollowSGroup(t_survive.beginParas[1].name)
		
	end


	Util_CreateSquads(player2, sg_p1_craft, SBP.LA_FIERE.ALLIES.CRAFT, mkr_chef_stageLCraft, nil, 1, 1) --mkr_chef_stageL2
	SGroup_EnableUIDecorator(sg_p1_craft, false)
	SGroup_SetSelectable(sg_p1_craft, false)
	Timer_Start(t_survive.UniversalTimer, 60)
	
	Rule_AddInterval(Survive_OrderstoRunCheck1, 1)
	
	-- Creates initial retreat point
	if EGroup_IsEmpty(eg_retreat_point) == false then
		EGroup_DestroyAllEntities(eg_retreat_point)
	end
	Util_CreateEntities(player1, eg_retreat_point, EBP.SP.LA_FIERE.RETREAT_POINT, mkr_causeway_East, 1)
	

end

function Survive_OrderstoRunCheck1()
-- Start the timer for the run speech
-- once timer and flag for speeches have been activated, then call next sequence of speech

	if math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 59 and t_survive.TimerFlag1 == false then
		
		Util_AutoAmbient(t_survive.events.OrderstoRun)
		Util_AutoIntel(t_survive.events.Intro)
		t_survive.TimerFlag1 = true
		
	elseif math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 55 and t_survive.TimerFlag1 == true and t_survive.TimerFlag2 == false then
		
		Util_AutoAmbient(t_survive.events.OrderstoRun2)
		t_survive.TimerFlag2 = true
		Rule_AddInterval(Survive_OrderstoRunCheck2,1)
			
		Rule_RemoveMe()
	end
end


-- makes units run into artillery after a certain point	
function Survive_OrderstoRunCheck2()

	if SGroup_IsEmpty(t_survive.beginParas[1].name) == false then
		
		if t_survive.beginParas[1].moved == false 
			or  math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 50 then
			
			Cmd_AttackMove(t_survive.beginParas[1].name, mkr_causeway3)
			Util_AutoAmbient(t_survive.events.OrderstoRun3)
			
			t_survive.beginParas[1].moved = true
			
		end
	elseif SGroup_IsEmpty(t_survive.beginParas[1].name) == true then
		
		t_survive.beginParas[1].moved = true
		
	end
	
	if SGroup_IsEmpty(t_survive.beginParas[2].name) == false then
		
		if t_survive.beginParas[2].moved == false
			or  math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 49 then
			
			Cmd_AttackMove(t_survive.beginParas[2].name, mkr_causeway3)
			--Util_AutoAmbient(t_survive.events.OrderstoRun4)
			
			t_survive.beginParas[2].moved = true
			
		end
	elseif SGroup_IsEmpty(t_survive.beginParas[2].name) == true then
		
		t_survive.beginParas[2].moved = true
		
	end
	
	if t_survive.beginParas[1].moved == true and t_survive.beginParas[2].moved == true then
		
		
		if Rule_Exists(Survive_OrderstoRunCheck3) == false then
			
			Rule_AddInterval(Survive_OrderstoRunCheck3,1)
			Rule_AddOneShot(Survive_FuntimeArtillery, 10)
			Rule_RemoveMe()
			
		end
	end
end

function Survive_FuntimeArtillery()
	
	if SGroup_IsEmpty(t_survive.beginParas[1].name) == false then
	
		local l_hitpos = SGroup_GetPosition(t_survive.beginParas[1].name)
		
		Cmd_Ability(player3, ABILITY.SP.SINGLE_HOWITZER, t_survive.beginParas[1].name, nil, true)
		
		Rule_AddOneShot(Rule_Survive_FuntimeArtilleryReset, 1)
		
	elseif SGroup_IsEmpty(t_survive.beginParas[2].name) == false then
		
		local l_hitpos = SGroup_GetPosition(t_survive.beginParas[2].name)
		
		Cmd_Ability(player3, ABILITY.SP.SINGLE_HOWITZER, t_survive.beginParas[2].name, nil, true)
		
		Rule_AddOneShot(Rule_Survive_FuntimeArtilleryReset, 1)
		
	end

end

function Rule_Survive_FuntimeArtilleryReset()

	if g_funtime <= 4 then
		
		Rule_AddOneShot(Survive_FuntimeArtillery, World_GetRand(1, 4))
		
		g_funtime = g_funtime + 1
		
	elseif g_funtime >= 5 then
		
		Rule_RemoveMe()
		
	end
	
end
-- makes units 1 and 2 suppressed easily
function Survive_OrderstoRunCheck3()
	if SGroup_IsEmpty(t_survive.beginParas[1].name) == false and SGroup_IsUnderAttack(t_survive.beginParas[1].name,ANY,10) == true and t_survive.Suppression1 == false then 
		
		--SGroup_SetSuppression(t_survive.beginParas[1].name,1)
		Modify_ReceivedSuppression(t_survive.beginParas[1].name, 0.80)
		t_survive.Suppression1 = true
		
	elseif SGroup_IsEmpty(t_survive.beginParas[1].name) == true then
		
		t_survive.Suppression1 = true
		
	elseif SGroup_IsEmpty(t_survive.beginParas[2].name) == false and SGroup_IsUnderAttack(t_survive.beginParas[2].name,ANY,10) == true and t_survive.Suppression2 == false then
		
		--SGroup_SetSuppression(t_survive.beginParas[2].name,1)
		Modify_ReceivedSuppression(t_survive.beginParas[2].name, 0.80)
		t_survive.Suppression2 = true
		
	elseif SGroup_IsEmpty(t_survive.beginParas[2].name) == true then
		
		t_survive.Suppression2 = true
		
	end
	
	if ((t_survive.Suppression1 == true and t_survive.Suppression2 == true) or math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 40) and Rule_Exists(Survive_OrderstoRunCheck4) == false then
		Timer_End(t_survive.UniversalTimer)
		Rule_AddInterval(Survive_OrderstoRunCheck4,1)
		Rule_RemoveMe()
	end
end

-- resets things for Craft
function Survive_OrderstoRunCheck4()
	
	Timer_Start(t_survive.UniversalTimer, 60)
	Rule_AddInterval(Survive_OrderstoRunCheck5,1)
	t_survive.TimerFlag1 = false
	t_survive.TimerFlag2 = false
	t_survive.Suppression1 = false
	t_survive.Suppression2 = false
	Rule_RemoveMe()
	
end

function Survive_OrderstoRunCheck5()
-- now it's craft's turn to say things then run across

	if math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 55 and t_survive.TimerFlag1 == false then

		Util_AutoAmbient(t_survive.events.OrderstoRun8)
		t_survive.TimerFlag1 = true
		
		
	elseif math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 45 and t_survive.TimerFlag1 == true and t_survive.TimerFlag2 == false then
		
		--Util_AutoAmbient(t_survive.events.OrderstoRun9)
		Util_AutoIntel(t_survive.events.Intro2)
		
		
		t_survive.TimerFlag2 = true
		
		Rule_AddDelayedInterval(Survive_OrderstoRunCheck7,5, 1)
		Camera_FocusOnPosition(SGroup_GetPosition(sg_p1_craft), true)
		
		Rule_RemoveMe()
	end
end

-- makes it so that Craft runs across if the player doesn't select him anyway
function Survive_OrderstoRunCheck7()
	if SGroup_IsMoving(sg_p1_craft,ANY) == true or math.floor(Timer_GetRemaining(t_survive.UniversalTimer)) <= 40 then
		Timer_End(t_survive.UniversalTimer)
		
		--Game_Letterbox(true, 2)
		
		Camera_FollowSGroup(sg_p1_craft)
		--Timer_Start(t_survive.CraftTimer, 0) 
		Cmd_AttackMove(sg_p1_craft,mkr_causeway3)
		SGroup_SetMoveType(sg_p1_craft, MOVETYPE.FAST)
		--Util_AutoAmbient(t_survive.events.OrderstoRun10)
		Rule_AddDelayedInterval(Survive_OrderstoRunCheck8, 5 ,1)
		Rule_RemoveMe()
	end
end	
		
function Survive_OrderstoRunCheck8()
	SGroup_Hide(sg_p1_craft, true)
	Game_FadeToWhite(FADE_OUT,1)
	Util_StartNIS(NIS01)
	g_stopFire = true
	Rule_AddInterval(Survive_RemoveExtraCraft, 1)
	Rule_AddInterval(Survive_CameraReturn, 1)
	SGroup_SetMoveType(sg_p1_craft, MOVETYPE.NORMAL)
	SGroup_EnableUIDecorator(sg_p1_craft, true)
	-- returns modifiers back to normal 
	for k,this in pairs(t_survive.para) do 
		if this.longrange ~=nil or this.longsight ~= nil or this.longdamage ~= nil then
			Modifier_RemoveAllFromSGroup(this.sgroup)
			SGroup_SetSelectable(this.sgroup, true)
			SGroup_SetMoveType(this.sgroup, MOVETYPE.NORMAL)
			
		end
		
		SGroup_EnableUIDecorator(this.sgroup, true)
		
	end
	
	
	for k,v in pairs(t_survive.beginParas) do
	
		if SGroup_IsEmpty(v.name) == false then
			SGroup_SetMoveType(v.name, MOVETYPE.NORMAL)
			SGroup_SetSelectable(v.name, true)
			SGroup_EnableUIDecorator(v.name, true)
		end
	end
	Rule_RemoveMe()
		
	
end


function Survive_CameraReturn()
	if Event_IsAnyRunning()== false then
		--Camera_SetDefault(30, 43, -123)
 		--Camera_ResetToDefault()	
		
		
		Game_Letterbox(false, 2)
		
		Rule_RemoveMe()
	end

end


function Survive_RemoveExtraCraft()
	
	if Event_IsAnyRunning()== false then
	
		if SGroup_IsEmpty(sg_p1_craft) == false then
			SGroup_Hide(sg_p1_craft, false)
			local _CheckCraft = function( sgroupid, itemindex, squadID )
				print("checking craft")
				if Player_OwnsSquad(player1, squadID) == false then
					Squad_Destroy(squadID)
				end
			end
			
			SGroup_ForEach(sg_p1_craft, _CheckCraft)
			
		end
		
		if SGroup_IsEmpty(sg_p1_craft) == false then
			
			Modify_Vulnerability(sg_p1_craft, 0.50)
			Modify_ReceivedSuppression(sg_p1_craft, 0.50)
			SGroup_SetPlayerOwner(sg_p1_craft, player1)
			SGroup_SetSelectable(sg_p1_craft, true)
			
			-- best looking place to add this - deg
			Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sg_p1_craft, 1), 1)
			
		end
		
		-- also add sgroups to tracker if applicable
		if SGroup_IsEmpty(sg_p1_baker) == false then
			
			SGroup_AddGroup(sg_p1_overgroup, sg_p1_baker)
			
		end
		
		if SGroup_IsEmpty(sg_p1_able) == false then
			
			SGroup_AddGroup(sg_p1_overgroup, sg_p1_able)
			
		end
		
		RPGTracker_SetSGroup(sg_p1_overgroup) 
		
		for k,this in pairs(t_survive.hmg) do 
			this.mapElementID = Objective_AddUIElements(OBJ_Survive, this.sgroup, true, 9439020, true)
		end
		
		Objective_RemoveUIElements(OBJ_Survive, OBJ_Survive.mapElementID) 
		Objective_UpdateText(OBJ_Survive, 9439020, 9439030, true)
		Game_LoadAtmosphere("data:art/scenarios/presets/atmosphere/LA_FIERE_DAY2_MIDDAY_STORM_00.APS", 60*15)
		Rule_RemoveMe()
		Util_AutoAmbient(t_survive.events.Across)
	end

	

end


function Survive_Preset()
	
	
	for i = 1, #(t_survive.trap) do 
		-- create bunkers
		Util_CreateEntities(player3, eg_surv_traps, EBP.ALLIES.TANK_TRAP, t_survive.trap[i], 1)
		
	end

	-- start enemy behavior
	for k,this in pairs(t_survive.hmg) do 
		-- create bunkers
		if k == 1 then
			
			Util_CreateEntities(player3, this.egroup, EBP.CW.SLITTRENCH_NEST, this.spawn, 1)
			Modify_SightRadius(this.egroup, 5)
			-- put soldiers in them
			Util_CreateSquads(player3, this.sgroup, SBP.ELITE.PANZERGRENADIER, this.egroup, nil, 1, World_GetRand(2, 3), false, nil, {UPG.AXIS.GREN_MG42})
			SGroup_SetTeamWeaponCapturable(this.sgroup, false)
			LaFiere_LogSyncW(this.sgroup)
			
			SGroup_AddGroup(sg_surv_hmgAll, this.sgroup)
		else
			Modify_SightRadius(this.egroup, 5)
			-- put soldiers in them
			Util_CreateSquads(player3, this.sgroup, SBP.AXIS.HEAVYMG, this.spawn)
			SGroup_SetTeamWeaponCapturable(this.sgroup, false)
			LaFiere_LogSyncW(this.sgroup)
			
			SGroup_AddGroup(sg_surv_hmgAll, this.sgroup)
		end
		
		Modify_WeaponRange(this.sgroup, "hardpoint_01", 2.5)
		Modify_WeaponAccuracy(this.sgroup, "hardpoint_01", .1)
		Modify_SightRadius(this.sgroup, 4)
	end
	
	-- do other cool things
	for k,this in pairs(t_survive.para) do 
		Util_CreateSquads(player2, this.sgroup, SBP.ALLIES.PARATROOPER, this.spawn, nil, 1, World_GetRand(2, 3))
		SGroup_AddGroup(sg_surv_paraAll, this.sgroup)
		if this.longrange == false and this.longsight == false and this.longdamage == false then
			this.longrange = Modify_WeaponRange(this.sgroup, "hardpoint_01", 100)
			this.longsight = Modify_SightRadius(this.sgroup, 100)
			this.longdamage = Modify_WeaponDamage(this.sgroup, "hardpoint_01", 0.1)
			
			SGroup_SetSelectable(this.sgroup, false)
			SGroup_SetMoveType(this.sgroup, MOVETYPE.FAST)
			
		end
		
		this.accMod = Modify_ReceivedAccuracy(this.sgroup, 3)
		this.damMod = Modify_ReceivedDamage(this.sgroup, 1.5)
		this.supMod = Modify_ReceivedSuppression(this.sgroup, 0.1)
		SGroup_EnableUIDecorator(this.sgroup, false)
		
		
	end

	-- add in the defenders
	Rule_AddInterval(Survive_Defenders, 4)
	Rule_AddInterval(Survive_Craft_InvOn,1)
end

-- example of how to finish an Obj
function Survive_Rule_WinCheck()
	
	-- one of them must be set to true before the player can win or lose the objective
	if SGroup_IsEmpty(sg_surv_hmgAll) then
		
		-- the player has just won
		Objective_Complete(OBJ_Survive)
		
		Rule_RemoveMe()
		
--~ 	elseif SGroup_IsEmpty(sg_p1_craft) then
--~ 		
--~ 		-- the player has just failed
--~ 		Objective_Fail(OBJ_Survive)
--~ 		
--~ 		Rule_RemoveMe()
--~ 		
	end
	
end

function Survive_Craft_InvOn()
	
	if SGroup_IsEmpty(sg_p1_craft) == false then
		
		SGroup_SetInvulnerable(sg_p1_craft, 0.5) -- invulnerable if Craft gets hurt to half health
	
		Rule_AddOneShot(Survive_Craft_InvOff, 50) -- turns off temporary invulnerability
		
		Rule_RemoveMe()
	
	end

end


function Survive_Craft_InvOff()
	
	if SGroup_IsEmpty(sg_p1_craft) == false then
		SGroup_SetInvulnerable(sg_p1_craft, false)
		-- start craft survival check which will kick in once his health is < 50%
		Rule_AddInterval(CraftSurvivalStartCheck, 1)
	end
	
end


function Survive_Debug()

	-- add in the necessary information that can automatically start this objective 
	-- with the press of a hotkey
	Objective_Start(OBJ_Survive)

end


-- start the related action
function Survive_Kickoff()

	-- action that starts with the Obj being granted
	Rule_AddDelayedInterval(Survive_PlayerStart, 27, 2)
	
	-- enemy
	Survive_SpotHMGS()
end


----------------------------------
--[[ THE PLAYER ]]
----------------------------------

function Survive_PlayerStart()
	if SGroup_IsEmpty(sg_p1_craft) == false and SGroup_IsMoving(sg_p1_craft, false) then --and math.floor(Timer_GetRemaining(t_survive.CraftTimer)) <= 0 then
		Event_Skip()
		
		Rule_AddDelayedInterval(Survive_AlliesMove, 0.5, 1)
		Rule_RemoveMe()
	end
end



function Survive_AlliesMove()
	if Objective_IsComplete(OBJ_Survive) or Objective_IsFailed(OBJ_Survive) then
		Rule_RemoveMe()
	else
		for k,this in pairs(t_survive.para) do 
			if SGroup_IsEmpty(this.sgroup) then
				Util_CreateSquads(player2, this.sgroup, SBP.ALLIES.PARATROOPER, mkr_mapEntry7, nil, 1, World_GetRand(2, 3))
				
				SGroup_AddGroup(sg_surv_paraAll, this.sgroup)
				this.accMod = Modify_ReceivedAccuracy(this.sgroup, 3)
				this.damMod = Modify_ReceivedDamage(this.sgroup, 1.5)
				this.supMod = Modify_ReceivedSuppression(this.sgroup, 5)
				GreyCastle_MoveCover(this.sgroup, this.goto, 10)
			else
				if SGroup_IsPinned(this.sgroup, false) then
					Cmd_Stop(this.sgroup)
				elseif SGroup_IsMoving(this.sgroup, false) == false then
					GreyCastle_MoveCover(this.sgroup, this.goto, 10)
				end
			end
		end
		Rule_RemoveMe()
		Rule_AddInterval(Survive_AlliesMove, 5)
	end
end

function Survive_AbleBakerArrive()
	if SGroup_IsEmpty(sg_p1_craft) == false then
		local pos = World_GetHiddenPositionOnPath(player1, mkr_mapEntry3, SGroup_GetPosition(sg_p1_craft), CHECK_OFFCAMERA)
		
		if pos == nil then
		
			pos = mkr_mapEntry7
		
		end
		
		-- spawn ABLE
		local sgroup = sg_p1_able
		Util_CreateSquads(player1, sgroup, SBP.LA_FIERE.ALLIES.ABLE_3MAN, pos, nil, 1, 3)
		GreyCastle_CompanyBias(sgroup, 1, 1, 1.2, .8, 1)
		Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sgroup, 1), 2)
		Cmd_Move(sgroup, sg_p1_craft, false, nil, nil, OFFSET_FRONT, 5)
		
		-- spawn BAKER
		local sgroup = sg_p1_baker
		Util_CreateSquads(player1, sgroup, SBP.LA_FIERE.ALLIES.BAKER_3MAN, pos, nil, 1, 3)
		GreyCastle_CompanyBias(sgroup, 1, 1, .8, .8, 1)
		Misc_SetSquadControlGroup(SGroup_GetSpawnedSquadAt(sgroup, 1), 3)
		Cmd_Move(sgroup, sg_p1_craft, false, nil, nil, OFFSET_RIGHT, 5)
		
		
		Rule_AddInterval(AbleBakerSurvivalStartCheck, 1)
		Rule_AddInterval(AbleBakerSurvivalMod, 1)
		SGroup_SetCrushable(sg_p1_able, false)
		SGroup_SetCrushable(sg_p1_baker, false)
	end
	
	
	
	-- also add sgroups to tracker if applicable
	if SGroup_IsEmpty(sg_p1_baker) == false then
		
		SGroup_AddGroup(sg_p1_overgroup, sg_p1_baker)
		
	end
	
	if SGroup_IsEmpty(sg_p1_able) == false then
	
		SGroup_AddGroup(sg_p1_overgroup, sg_p1_able)
		
	end
	
	Rule_AddOneShot(Survive_AbleBakerNotification1, 1)
	Rule_AddOneShot(Survive_AbleBakerNotification2, 3)
	
	
	RPGTracker_SetSGroup(sg_p1_overgroup) 
	
	--updates able and baker entities
	Casualty_Force_EntityPopulate()
	if SGroup_IsEmpty(sg_p1_baker) == false then
		Danger_RPGMechanics_KickOff(sg_p1_baker)
	end
end

-- speech to notify player about the appearance of able and baker
function Survive_AbleBakerNotification1()

	PlayLaFiere_C_Speech(player1, soundData.notify1)

end

function Survive_AbleBakerNotification2()

	PlayLaFiere_C_Speech(player1, soundData.notify2)

end

----------------------------------
--[[ THE GERMANS ]]
----------------------------------

function Survive_SpotHMGS()
	
	for k,this in pairs(t_survive.hmg) do 
		FOW_RevealMarker(this.spawn, -1)
	end
	
	Rule_AddInterval(Survive_UnrevealHMGS, 5)
end

function Survive_UnrevealHMGS()
	local done = true
	for k,this in pairs(t_survive.hmg) do 
		if SGroup_IsEmpty(this.sgroup) then
			done = false
		elseif this.unreveal ~= true and SGroup_IsEmpty(this.sgroup) then
			-- move up folks
			if k == 1 then
				t_survive.para[5].goto = t_survive.para[5].goto2
			elseif k == 2 then
				t_survive.para[3].goto = t_survive.para[3].goto2
			elseif k == 3 then
				t_survive.para[4].goto = t_survive.para[4].goto2
			end
			FOW_UnRevealMarker(this.spawn)
			this.unreveal = true
		end
	end
	if done == true then 
		Rule_AddInterval(Survive_HMGSRespond, 5)
		Rule_RemoveMe() 
	end
end

function Survive_HMGSRespond()
	local done = true
	for k,this in pairs(t_survive.hmg) do 
		if SGroup_IsEmpty(this.sgroup) == false then
			done = false
			--[[
			if k ~= 1 and SGroup_TotalMembersCount(this.sgroup) <= 2 then
				Cmd_Retreat(this.sgroup, Marker_GetPosition(mkr_mapEntry10), mkr_mapEntry10)
			end
			]]
		end
	end
	if done == true then 
		Rule_RemoveMe() 
	end
end


function Survive_Defenders()
	if Objective_IsComplete(OBJ_Survive) or Objective_IsFailed(OBJ_Survive) then
		Rule_AddInterval(Survive_Defenders_BeyondOBJ, 5)
		Rule_RemoveMe()
	else
	
		for k,this in pairs(t_survive.def) do 
			if SGroup_IsEmpty(this.sgroup) then
				-- put soldiers in them
				Util_CreateSquads(player3, this.sgroup, SBP.AXIS.GRENADIER, this.spawn, nil, 1, 7, false, nil, {UPG.AXIS.GREN_MG42})
				SGroup_SetTeamWeaponCapturable(this.sgroup, false)
				LaFiere_LogSyncW(this.sgroup)
				SGroup_AddGroup(sg_surv_defAll, this.sgroup)
				
				--Modify_SightRadius(this.sgroup, 1.5)
				Modify_WeaponRange(this.sgroup, "hardpoint_01", 1.1)
				Modify_WeaponAccuracy(this.sgroup, "hardpoint_01", .5)
				Modify_ReceivedAccuracy(this.sgroup, .8)
				
			else
				if SGroup_IsMoving(this.sgroup, false) then
					
					if SGroup_IsUnderAttack(this.sgroup, false, 5) or SGroup_IsDoingAttack(this.sgroup, false, 5) then
						
						Cmd_Stop(this.sgroup)
					else
						-- do nothing
					end
				else
					
					if SGroup_IsUnderAttack(this.sgroup, false, 5) then
						
						local l_GrenadeRandomToss = World_GetRand(1, 3)
						
						if l_GrenadeRandomToss == 3 then
							
							if SGroup_IsDoingAbility(this.sgroup, ABILITY.AXIS.GRENADE, ANY) == true then
							
							elseif SGroup_IsDoingAbility(this.sgroup, ABILITY.AXIS.GRENADE, ALL) == false then
								
								local l_LastAttacker = SGroup_CreateIfNotFound("l_LastAttacker")
								
								SGroup_GetLastAttacker(this.sgroup, l_LastAttacker)
								
								if l_LastAttacker ~= nil and SGroup_IsEmpty(l_LastAttacker) == false then
									
									Cmd_Ability(this.sgroup, ABILITY.AXIS.GRENADE, l_LastAttacker, nil,true)
									
								end	
							
							end
							
						else
							if SGroup_IsDoingAbility(this.sgroup, ABILITY.AXIS.GRENADE, ANY) == false then
								
								Cmd_Move(this.sgroup, this.sgroup, false, nil, nil, OFFSET_BACK, World_GetRand(4, 12), 10)
								
							end
							
						end
						
					elseif SGroup_IsDoingAttack(this.sgroup, false, 5) then
						-- do nothing
					elseif SGroup_IsUnderAttack(this.sgroup, false, 30) == false and Prox_AreSquadsNearMarker(this.sgroup, this.goto, false, 15) == false then
						GreyCastle_MoveCover(this.sgroup, this.goto, 10)
					end
				end
			end
		end
	end
end


function Survive_Defenders_BeyondOBJ()
	
	if SGroup_IsEmpty(sg_surv_defAll) then
		Rule_RemoveMe()
	else
		for k,this in pairs(t_survive.def) do 
			if SGroup_IsEmpty(this.sgroup) == false then
				if SGroup_TotalMembersCount(this.sgroup) == 1 then
					Cmd_Retreat(this.sgroup, Marker_GetPosition(this.spawn), this.spawn)
				elseif SGroup_IsMoving(this.sgroup, false) then
					Cmd_Stop(this.sgroup)
				else
					if SGroup_IsUnderAttack(this.sgroup, false, 5) then
						
						
						local l_GrenadeRandomToss = World_GetRand(1, 3)
						
						if l_GrenadeRandomToss == 3 then
							
							if SGroup_IsDoingAbility(this.sgroup, ABILITY.AXIS.GRENADE, ANY) == true then
							
							elseif SGroup_IsDoingAbility(this.sgroup, ABILITY.AXIS.GRENADE, ALL) == false then
								
								local l_LastAttacker = SGroup_CreateIfNotFound("l_LastAttacker")
								
								SGroup_GetLastAttacker(this.sgroup, l_LastAttacker)
								
								if l_LastAttacker ~= nil and SGroup_IsEmpty(l_LastAttacker) == false then
									
									Cmd_Ability(this.sgroup, ABILITY.AXIS.GRENADE, l_LastAttacker, nil,true)
									
								end	
								
							end
							
						else
							if SGroup_IsDoingAbility(this.sgroup, ABILITY.AXIS.GRENADE, ANY) == false then
								
--~ 								Cmd_Move(this.sgroup, this.sgroup, false, nil, nil, OFFSET_BACK, World_GetRand(4, 12), 10)
--~ 							
--~ 							end
--~ 							
--~ 						end
--~ 						
								if Prox_AreSquadsNearMarker(this.sgroup, mkr_fork1, false, 20) == false then
									Cmd_Move(this.sgroup, mkr_fork1, false, nil, nil, OFFSET_BACK, World_GetRand(4, 12), 10)
								else
									Cmd_Move(this.sgroup, this.sgroup, false, nil, nil, OFFSET_BACK, World_GetRand(4, 12), 10)
								end
							end
						end
						
					elseif SGroup_IsDoingAttack(this.sgroup, false, 5) then
						-- do nothing
					elseif SGroup_IsUnderAttack(this.sgroup, false, 30) == false and Prox_AreSquadsNearMarker(this.sgroup, mkr_fork1, false, 15) == false then
						-- GreyCastle_MoveCover(this.sgroup, mkr_fork1, 10)
						
						-- set up defenses here?
						
					end
				end
			end
		end
	end
end

