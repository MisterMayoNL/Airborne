Scar_AddInit(NIS_Init)

EVENTS = {}

EVENTS.CapturePoint = function()
	
	local choices = {}
	choices[1] = {actor = ACTOR.CXP2.Wolfgang, line = 1481100}	
	choices[2] = {actor = ACTOR.CXP2.Wolfgang, line = 1481101}		
	choices[3] = {actor = ACTOR.CXP2.Wolfgang, line = 1481102}		
--~ 	choices[4] = {actor = ACTOR.CXP2.Wolfgang, line = 1481103}		
--~ 	choices[5] = {actor = ACTOR.CXP2.Wolfgang, line = 1481104}		
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()

end

EVENTS.NIS02 = function()

	CTRL.Game_FadeToBlack(FADE_OUT, 2)
	CTRL.Game_Letterbox(true, 2)
	CTRL.WAIT()
	
	CTRL.Game_FadeToBlack(FADE_IN, 0)
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()
	
	nis_stop()
	
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)
	Sound_SetVolume("Music", 0.0, 0)

	Game_BlockTextClear()
	Game_BlockTextAdd( 1309280 )
	CTRL.Game_BlockTextFade( 2, 8, 1 )
	CTRL.WAIT()
	
	Game_BlockTextClear()
	Game_BlockTextAdd( 1309281 )
	CTRL.Game_BlockTextFade( 1, 8, 1 )
	CTRL.WAIT()
	
	Game_BlockTextClear()
	Game_BlockTextAdd( 1309282 )
	Game_BlockTextAdd( 1309283 )
	Game_BlockTextAdd( 1309284 )
	CTRL.Game_BlockTextFade( 1, 10, 1 )
	CTRL.WAIT()
	
	CTRL.Event_Delay(2)
	CTRL.WAIT()
	
	Game_EndSP(true)
end


