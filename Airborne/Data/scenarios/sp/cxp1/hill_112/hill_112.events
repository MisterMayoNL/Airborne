	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Wallis, line = 1322330}
	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1322340}
	choices[3] = {actor = ACTOR.CXP1.Wallis, line = 1322350}
	choices[4] = {actor = ACTOR.CXP1.Wallis, line = 1322360}

	local rand = World_GetRand(1, table.getn(choices))
	
