-------------------------------------------------------------------------
-- Objective Name 
-------------------------------------------------------------------------
-- Short descriptive name of what the player is cht_eventsed to do
-- give a brief description of win conditions and loose conditions if any 
-- also describe the kind of challenges the player will face
-------------------------------------------------------------------------
function Initialize_OBJ_Chef()

	OBJ_Chef = {
		
		SetupUI = function() 
			-- mark a point or position
			OBJ_Chef.mapElementID = Objective_AddUIElements(OBJ_Chef, mkr_causeway_East, true, 9419090, true)
		end,
		
		OnStart = function()
			Sound_PlayMusic("Music/DLC/Causeway/LaFiere_A/LFA_Phase_2.bsc",2,0)
			
			-- announce the goal
			Util_AutoIntel(t_chef.events.Intro)
			
			-- win/lose check
			Rule_AddInterval(Chef_Rule_WinCheck, 5)
			
			-- start related action
			Chef_Kickoff()
			-- EncounterName_Kickoff()
			
		end,
		
		OnComplete = function()
			
			-- tell the player they did good
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 9419090, -- Capture Chef du Pont
		Description = 9419110, -- Clear the cluster of buildings known as Chef du Pont at the east end of the Causeway.
		TitleEnd = 9419100, -- Chef du Pont Cleared

		Type = OT_Primary,
		
--~ 		SitRep = {}, -- only needed once the SitRep is created and there are lines of dialogue.
	}
	
	-- Register Objective
	Objective_Register(OBJ_Chef)
	
	-- Initialize Data
	Chef_Init()
	
end

Scar_AddInit(Initialize_OBJ_Chef)

-------------------------------------------------------------------------
-- Objective Name - Functions 
-------------------------------------------------------------------------

-- 'Init()' is used to initialize the Obj data
-- anything that needs to be there for the Obj to work
-- does not need to be called at 'OnInit()'
