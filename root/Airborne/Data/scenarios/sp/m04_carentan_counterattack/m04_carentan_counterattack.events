EVENTS.NIS01 = function()
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)
	eg_NISplayer1 = EGroup_CreateIfNotFound("eg_NISplayer1")
	World_GetEntitiesNearMarker(player1, eg_NISplayer1, mkr_HideNIS1, OT_Ally)
	EGroup_Hide(eg_NISplayer1, true)
	eg_NISplayer2 = EGroup_CreateIfNotFound("eg_NISplayer2")
	World_GetEntitiesNearMarker(player1, eg_NISplayer2, mkr_HideNIS2, OT_Ally)
	EGroup_Hide(eg_NISplayer2, true)
	eg_NISplayer3 = EGroup_CreateIfNotFound("eg_NISplayer3")
	World_GetEntitiesNearMarker(player1, eg_NISplayer1, mkr_HideNIS3, OT_Ally)
	EGroup_Hide(eg_NISplayer3, true)
	eg_NISplayer5 = EGroup_CreateIfNotFound("eg_NISplayer5")
	World_GetEntitiesNearMarker(player1, eg_NISplayer5, mkr_HideNIS5, OT_Ally)
	EGroup_Hide(eg_NISplayer5, true)
	
	eg_NISgroup1 = EGroup_CreateIfNotFound("eg_NISgroup1")
	World_GetNeutralEntitiesNearMarker(eg_NISgroup1, mkr_HideNIS1)
	EGroup_Hide(eg_NISgroup1, true)
	eg_NISgroup2 = EGroup_CreateIfNotFound("eg_NISgroup2")
	World_GetNeutralEntitiesNearMarker(eg_NISgroup2, mkr_HideNIS2)
	EGroup_Hide(eg_NISgroup2, true)
	eg_NISgroup3 = EGroup_CreateIfNotFound("eg_NISgroup3")
	World_GetNeutralEntitiesNearMarker(eg_NISgroup3, mkr_HideNIS3)
	EGroup_Hide(eg_NISgroup3, true)
	eg_NISgroup5 = EGroup_CreateIfNotFound("eg_NISgroup5")
	World_GetNeutralEntitiesNearMarker(eg_NISgroup5, mkr_HideNIS5)
	EGroup_Hide(eg_NISgroup5, true)
	sg_AllyGuys = SGroup_CreateIfNotFound("sg_AllyGuys")
	Player_GetAll(player1, sg_AllyGuys)
	SGroup_Hide("sg_AllyGuys", true)
	
	FOW_Enable(false)
	Game_Letterbox(true, 0.75)
	--EGroup_Kill(Blg_CafeNormandie)
	Game_FadeToBlack(FADE_IN, 2)	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()
	nis_stop()
	EGroup_Hide(eg_NISplayer1, false)
	EGroup_Hide(eg_NISplayer2, false)
	EGroup_Hide(eg_NISplayer3, false)
	EGroup_Hide(eg_NISplayer5, false)
	EGroup_Hide(eg_NISgroup1, false)
	EGroup_Hide(eg_NISgroup2, false)
	EGroup_Hide(eg_NISgroup3, false)
	EGroup_Hide(eg_NISgroup5, false)
	SGroup_Hide(sg_AllyGuys, false)
	Cmd_Move(sg_AllyGuys,Marker_D26) 
	Util_PlayMusic("Sound/music/sp/M04/M04_Ob1_PrepTime1", 2, 0)	
	Game_FadeToBlack(FADE_OUT, 0)
--~ 	Actor_PlaySpeechWithoutPortrait(ACTOR.McKay, 249016)
	Camera_MoveToPosition(Marker_D25, false)
	Camera_ResetToDefault()
	Camera_ResetToDefault()
 	CTRL.Event_Delay(2)
	CTRL.WAIT()
	FOW_Enable(true)
	Objective_Start(OBJECTIVE1, false)
	--Scar_Autosave(249050) 
--~ 	Game_FadeToBlack(FADE_IN, 5)
--~ 	Game_Letterbox(false, 0.75)
	
--~ 	FOW_Enable(true)
--~ 	Camera_MoveToPosition(Marker_D25, false)
--~ 	Camera_ResetToDefault()
--~ 	Camera_ResetToDefault()
--~ 	CTRL.Util_MissionTitle(249023)					--- Forward HQ established
	--CTRL.WAIT()
end


