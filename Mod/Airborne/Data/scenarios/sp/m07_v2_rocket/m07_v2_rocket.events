function NIS_Init()

	-- load NIS's
	NIS01 = "sp/M07_V2_Rocket/NIS/N07_01"
	nis_load(NIS01)
	NIS02 = "sp/M07_V2_Rocket/NIS/N07_02"
	nis_load(NIS02)
	NIS_V2_Launch = "sp/M07_V2_Rocket/NIS/N07_V2_launch"
	nis_load(NIS_V2_Launch)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)


