import("ScarUtil.scar")
import("AirborneUtil.scar")

function OnInit()
	TimeRule_AddInterval(Refresh_AI,600,1)
	
	-- this is for starting ressources
	for i=1, World_GetPlayerCount() do
		 if (Player_GetRaceName(World_GetPlayerAt(i)) == TRACE_AXIS_PANZER_ELITE) then
			Player_GetAll(World_GetPlayerAt(i), sg_temp)
			SGroup_Filter(sg_temp, {SBP.ELITE.KETTENRAD, SBP.ELITE.SCHWIMMWAGEN}, FILTER_KEEP)
			Util_CreateSquadsAtMarker(World_GetPlayerAt(i), nil, SBP.ELITE.PANZERGRENADIER, SGroup_GetPosition(sg_temp), 1)
			SGroup_DestroyAllSquads(sg_temp)
		 end
		 Setup_SetPlayerTeam(World_GetPlayerAt(i),i+1)
		 Player_AddResource(World_GetPlayerAt(i), RT_Munition, 50)
		 Modify_PlayerResourceRate(World_GetPlayerAt(i), RT_Manpower, 0.85)
		 Modify_PlayerResourceRate(World_GetPlayerAt(i), RT_Munition, 0.65)
		 Modify_PlayerResourceRate(World_GetPlayerAt(i), RT_Fuel, 0.5)

	-- Remove all vehicles from commander tree
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_COMBAT_GROUP, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_CALLIOPE, ITEM_REMOVED)
		 Player_SetAbilityAvailability(World_GetPlayerAt(i), ABILITY.COMMANDER_TREE.ALLIES.RECRUIT_PERSHING, ITEM_REMOVED)
