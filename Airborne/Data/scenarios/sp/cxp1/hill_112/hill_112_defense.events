	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380251)		-- Sappers, I want A-T guns covering the hill.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380252)		-- Williams, have your sections dig SLIT-TRENCHES and cover them with MGs.
