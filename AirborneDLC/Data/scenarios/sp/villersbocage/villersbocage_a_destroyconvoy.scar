-------------------------------------------------------------------------
-- Destroy Convoy
-------------------------------------------------------------------------
-- The player's job is to assault the vehicles in the convoy and destroy them.
-------------------------------------------------------------------------

function Initialize_OBJ_DestroyConvoy()

	OBJ_DestroyConvoy = {
		
		SetupUI = function() 
			-- mark a point or position
			-- OBJ_DestroyConvoy.mapElementID = Objective_AddUIElements(OBJ_DestroyConvoy, mkr_marker, true, 000000, true)
			Objective_SetAlwaysShowDetails(OBJ_DestroyConvoy, false, true, false)
		end,
		
		OnStart = function()
			
			-- announce the goal
			Util_AutoIntel(t_DC.t_Speech.objStart)
			-- win/lose check
			Rule_AddInterval(DestroyConvoy_WinCheck, 5)
			
			-- start related action
			DestroyConvoy_Kickoff()
			
			Misc_SelectSquad(SGroup_GetSpawnedSquadAt(sg_Tiger, 1), true)
			SGroup_SetAutoTargetting(sg_Tiger, "hardpoint_01", true)
			
		end,
		
		OnComplete = function()
			
			if t_DC.bAltObjComplete == true then
				Util_AutoIntel(t_DC.t_Speech.objCompleteAlt)
			else
				Util_AutoIntel(t_DC.t_Speech.objComplete)
			end
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 6019001,
		Description = 6019010,
		TitleEnd = 6019020,
		Type = OT_Primary,
		
	}
	
	-- Register Objective
	Objective_Register(OBJ_DestroyConvoy)
	-- Initialize Data
	DestroyConvoy_Init()
	
end

Scar_AddInit(Initialize_OBJ_DestroyConvoy)

-------------------------------------------------------------------------
-- Objective Name - Functions 
-------------------------------------------------------------------------

-- 'Init()' is used to initialize the Obj data
-- anything that needs to be there for the Obj to work
-- does not need to be called at 'OnInit()'
