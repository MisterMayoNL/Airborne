--------------------------------------------------------------------------------
-- NIS 01: V2 ROCKET LAUNCH
--------------------------------------------------------------------------------
EVENTS.NIS01 = function ()
	-- set speech and sfx volume groups to 0 so we don't hear any audio in between NIS and Sit Rep.  Sit Rep transition out will re-set volume groups.
	Sound_SetVolume("Speech", 0.0, 0)
	Sound_SetVolume("SFXmaster", 0.0, 0)

	nis_usegamecamera(false)
	CTRL.Game_Letterbox(true, 1)
		Game_FadeToBlack(FADE_IN, 1)
		FOW_Enable(false)
	CTRL.WAIT()

	CTRL.Scar_PlayNIS(NIS01)
		CTRL.WAIT()

	nis_stop()
	
--~ 	CTRL.Game_Letterbox(false, 1)
		EGroup_Hide(LAYER_GameplayLayer, false)
		FOW_Enable(true)
	
	CTRL.WAIT()

end

--------------------------------------------------------------------------------
-- NIS 02: V2 ROCKET DESTRUCTION
--------------------------------------------------------------------------------

EVENTS.NIS02 = function ()

	nis_stop()
	nis_usegamecamera(false)
	CTRL.Game_Letterbox(true, 0)
	Sound_SetVolume("Speech", 0.0, 1.5)
	Sound_SetVolume("SFXmaster", 0.0, 1.5)
	CTRL.WAIT()
	Util_ClearWrecksFromMarker(mkr_barracks7_spawn3)
	Util_ClearWrecksFromMarker(mkr_barracks7_spawn2)
	Util_ClearWrecksFromMarker(mkr_barracks5_spawn1)
	FOW_Enable(false)
	World_ClearCasualties()
	CTRL.Scar_PlayNIS(NIS02)
	CTRL.WAIT()
	nis_stop()
	FOW_Enable(true)
	CTRL.WAIT()
	Game_EndSP(true)

end


--------------------------------------------------------------------------------
-- NIS V2 ROCKET LAUNCH DURING MISSION
--------------------------------------------------------------------------------
EVENTS.NIS_V2_LAUNCH = function ()

	nis_usegamecamera(true)
	nis_playambient(NIS_V2_Launch)

end
