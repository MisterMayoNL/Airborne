--------------------------------------------------------------------------------
-- Ambient Event - Phase 3 waves attack
--------------------------------------------------------------------------------

EVENTS.Ambient_Phase3_First_Wave = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380520}		-- Aye Jerry that one's for Scotland!
	choices[2] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380530}		-- Take 'em and tear 'em lads!
	choices[3] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380540}		-- Away an bile yer' hyde ya numpty Jerries!
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380550}		-- Damn Huns looking' awfy peely-wally if you ask me!
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380560}		-- Cuntybuggerybumshite!
	choices[6] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380570}		-- Dry your eyes Jerry this is our bloody hill!

	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()

end

EVENTS.Ambient_Phase3_Second_Wave = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Dillingham, line = 1380580}		-- Fucking German knobdobbers everywhere!
	choices[2] = {actor = ACTOR.CXP1.Dillingham, line = 1380590}		-- If we don't get some support soon well all be dead!
	choices[3] = {actor = ACTOR.CXP1.Dillingham, line = 1380600}		-- Cuntybuggerybumshite they'll killed Keegan!
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380610}		-- Jammy bastards. 
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380620}		-- Stop muckin' about and kill some Jerry!
	choices[6] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380630}		-- Medic I need a fucking medic!

	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()

end

EVENTS.Ambient_Phase3_Third_Wave = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Wallis, line = 1380640}		-- I know your jeeked men, just hold out!
	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1380650}		-- Fucking Huns are coming back for more!
	choices[3] = {actor = ACTOR.CXP1.Wallis, line = 1380660}		-- Hold the mother loving hill and kill those sorry fucks!
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1380690}		-- Keep it coming Jerry I'll be busting out all your wallies!

	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeechWithoutPortrait(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
	
	if rand <= 3 then
		
		local rand2 = World_GetRand(1, 2)
		
		if rand2 == 1 then
		
			CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1380670)		-- Aye Captain Wallis, we'll hold out! 
			CTRL.WAIT()
			
		elseif rand2 == 2 then
		
			CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.GenericCommonwealth, 1380680)		-- Kill them totty tarts we will! 
			CTRL.WAIT()
		end
	end
end



--------------------------------------------------------------------------------
-- Mission Complete
--------------------------------------------------------------------------------

EVENTS.Mission_Complete = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380340)		-- There we go lads, Jerry's retreat in full force now!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380341)		-- Excellent, I had my doubts, but we blummin did it! 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380342)		-- Bra-fucking-vo Royal Scots!
	CTRL.WAIT()
end


