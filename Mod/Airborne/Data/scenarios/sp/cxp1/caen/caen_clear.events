EVENTS.AMBI_StreetFighting = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360940} -- There comin' out of the fuckin' rubble!
	choices[2] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360941} -- Watch the rubble mate!
	choices[3] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360942} -- Their in the bloody ruins!
	choices[4] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360943} -- Don't chase 'em!  They're tryin' to lure you out!
	choices[5] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360944} -- They're coming out of the ground!
	choices[6] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360945} -- Go wide on the corners!  Go wide on the fuckin' corners!
	choices[7] = {actor = ACTOR.CXP1.GenericCommonwealth, line = 1360947} -- God Damn!  We're in a kill zone!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Event_Delay(0.5)
