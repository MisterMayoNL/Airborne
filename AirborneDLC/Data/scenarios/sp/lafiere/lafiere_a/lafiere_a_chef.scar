-- cheat to suppress troops
function Chef_SuppressWatch()
	local sgroup = t_chef.suppressGroup
	if table.getn(sgroup) == 0 then
		Rule_RemoveMe()
	else
		for i = 1, table.getn(sgroup) do 
			SGroup_GetLastAttacker(sgroup[i], sg_chefAttacker)
			-- is baker attacking?
			if t_chef.suppressed[i] ~= true and SGroup_IsEmpty(sg_chefAttacker) == false and SGroup_ContainsSGroup(sg_chefAttacker, sg_p1_baker, false) then
				-- cheat and increase suppression
				Modify_ReceivedSuppression(sgroup[i], 10)
				t_chef.suppressed[i] = true
				-- table.remove(t_chef.suppressGroup, i)
				break
			end
		end
	end
end


function Chef_OpelRetreat()

	--local lt_sgrouptemp = t_chef.opeldata
	if SGroup_IsEmpty(sg_chefAll) == true then
		
		Rule_RemoveMe()
		
	else
		
		if SGroup_IsUnderAttackByPlayer(sg_chefAll, player1, 5) and Player_CanSeePosition(player1, Marker_GetPosition(mkr_AxisPatrolArea)) then
			
			for i = 1, table.getn(t_chef.opeldata) do 
				
				if SGroup_IsEmpty(t_chef.opeldata[i].name) == false then
					if t_chef.opeldata[i].fled == true then
					
					elseif t_chef.opeldata[i].fled == false then
						
						-- flee!
						-- action here
						Cmd_SquadPath(t_chef.opeldata[i].name, t_chef.opeldata[i].path, true, 0, false, 0, mkr_opelDisappears, true, nil)
						
						t_chef.opeldata[i].fled = true
						
						break -- break for next one
					
					end
				end	
			end
		end	
		
	end

end

-- 1st squad of grens retreat
function Chef_Action1_Retreat()
	local sgroup = sg_chef_def[1]
	if SGroup_IsEmpty(sgroup) then
		Rule_RemoveMe()
	elseif SGroup_TotalMembersCount(sgroup) < 3 then
		Cmd_Ungarrison(sgroup, mkr_chef_nest2)
		Cmd_Retreat(sgroup, Marker_GetPosition(mkr_chef_nest2))
		Cmd_Garrison(sgroup, eg_chef_trench1, true, true)
		Rule_RemoveMe()
	end
end

