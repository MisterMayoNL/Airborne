-- Tactical Event
EVENTS.River_OnBridge = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321390)		-- We've got a fuckin' heavy defensive line here!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321400)		-- Where the hell are Royal Scot's and their fuckin' Churchills!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1321410)		-- You'd think Tennant could light a fire under their arse!
	CTRL.WAIT()
end


-- Tactical Event
EVENTS.River_ChurchillArrived = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321420)		-- Tennant! The Scot's here!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321430)		-- You've got your Churchills!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321440)		-- They have an AVRE with them!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321450)		-- Good timing sir! 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321460)		-- Degnan!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321470)		-- Link up with those Churchills and have them neutralise that blockade!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Bailey, 1321480)		-- WE NEED TO CROSS the river at any cost.
	CTRL.WAIT()
end


-- Tactical Event
EVENTS.River_ATGunSpotted = function()
	
	local choices = {}
	if flag_spottedfirstatgun == false then
		choices[1] = {actor = ACTOR.CXP1.Degnan, line = 1321490}		-- Contact! AT Gun!
	else
		choices[1] = {actor = ACTOR.CXP1.Degnan, line = 1321490}		-- Contact! AT Gun!
		choices[2] = {actor = ACTOR.CXP1.Degnan, line = 1321520}		-- There's another Pak 38!
	end
	
	local rand = choices[World_GetRand(1, table.getn(choices))]
	
	CTRL.Actor_PlaySpeech(rand.actor, rand.line)
	CTRL.WAIT()
	
	flag_spottedfirstatgun = true
	
end


-- Tactical Event
EVENTS.River_ATGunSpotted_Riverbank = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1321500)		-- AT Gun on the riverbank!
	CTRL.WAIT()	
	flag_spottedfirstatgun = true
end


-- Tactical Event
EVENTS.River_ATGunSpotted_Bridge = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1321510)		-- AT Gun covering the bridge!
	CTRL.WAIT()	
	flag_spottedfirstatgun = true
end


-- Tactical Event
EVENTS.River_MentionHiddenBridge = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.GenericCommonwealth, 1321350)		-- That bridge's repairable sir!
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321360)		-- Then get your arse over there!
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321370)		-- Where the bloody hell is Corpral Degnan?
	CTRL.WAIT()	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1321380)		-- We need covering fire for our lads!
	CTRL.WAIT()	
end



