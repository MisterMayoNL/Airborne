function Infantry_KillHMG_ThrowGrenade()
	
	if Prox_ArePlayerMembersNearMarker(player1, mkr_infantry_flankhmg, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		Player_SetAbilityAvailability(player1, ABILITY.ALLIES.GRENADE, ITEM_UNLOCKED)
		
		Objective_UpdateText(OBJ_INFANTRY_ATTACKHMG, 409232, 409233, false)
		
		Rule_AddSGroupEvent(Infantry_KillHMG_CheckAbility, sg_playerunits, GE_AbilityExecuted)
		Rule_AddInterval(Infantry_KillHMG_Done, 0.5)
		
		if Misc_IsSGroupSelected(sg_playerunits, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryAttackHMGThrowGrenade)
			
			Objective_RemoveUIElements(OBJ_INFANTRY_ATTACKHMG, OBJ_INFANTRY_ATTACKHMG.PingID)
			OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_group2, false, 409257, true)
			
			if flashid_infantry_grenade == nil then
				flashid_infantry_grenade = UI_FlashAbilityButton(ABILITY.ALLIES.GRENADE, false, BT_UI_Strong_CommandBtn )
				hpid_infantry_grenade = HintPoint_AddToAbilityButton(ABILITY.ALLIES.GRENADE, 409271, false)
			end
			
		else 
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.ParatroopersSelect)
			
			Objective_RemoveUIElements(OBJ_INFANTRY_ATTACKHMG, OBJ_INFANTRY_ATTACKHMG.PingID)
			OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_playerunits, false, 409266, true)
			
			Rule_AddInterval(Infantry_KillHMG_ThrowGrenadeAirborneSelected, 0.5)
			
		end
		
	elseif Misc_IsSGroupSelected(sg_playerunits, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to select paratroopers
		Util_StartIntel(EVENTS.ParatroopersSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_ATTACKHMG, OBJ_INFANTRY_ATTACKHMG.PingID)
		OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_KillHMG_FlankAirborneSelected, 0.5)
		
	end
	
end


function Infantry_KillHMG_ThrowGrenadeAirborneSelected()
	
	if Misc_IsSGroupSelected(sg_playerunits, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryAttackHMGThrowGrenade)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_ATTACKHMG, OBJ_INFANTRY_ATTACKHMG.PingID)
		OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_group2, false, 409257, true)
		
		if flashid_infantry_grenade == nil then
			flashid_infantry_grenade = UI_FlashAbilityButton(ABILITY.ALLIES.GRENADE, false, BT_UI_Strong_CommandBtn )
			hpid_infantry_grenade = HintPoint_AddToAbilityButton(ABILITY.ALLIES.GRENADE, 409271, false)
		end
		
	end
	
end


function Infantry_KillHMG_CheckAbility(squad, abilityID, target)

	if abilityID == ABILITY.ALLIES.GRENADE then
		
		if (scartype(target) == ST_SQUAD and SGroup_ContainsSquad(sg_group2, Squad_GetGameID(target))) or 
		   (scartype(target) == ST_ENTITY and SGroup_ContainsEntity(sg_group2, target)) or 
		   (scartype(target) == ST_SCARPOS and World_DistancePointToPoint(target, SGroup_GetPosition_EVEN_IF_EMPTY(sg_group2)) < 4) then
			
			Game_SkipEvent()
			
			SGroup_SetInvulnerable(sg_group2, false)
			if SyncWeapon_Exists(infantry_hmg) then
				Entity_SetInvulnerable(SyncWeapon_GetEntity(infantry_hmg), 1, -1)
			end
			Modify_Vulnerability(sg_group2, 1.7)
			EGroup_DeSpawn(LAYER_wall_infantry_3)
			
			if flashid_infantry_grenade ~= nil then
				UI_StopFlashing(flashid_infantry_grenade)
				HintPoint_Remove(hpid_infantry_grenade)
				flashid_infantry_grenade = nil
				hpid_infantry_grenade = nil
			end
			
		else
			
			-- it's way off
			
			
		end
		
	end
	
end


function Infantry_KillHMG_Done()								-- flanked: change objective to throw grenade
	
	if SGroup_Count(sg_group2) == 0 then
		
		Rule_RemoveMe()
		if Event_IsAnyRunning() then Game_SkipEvent() end
		if Rule_Exists(Infantry_KillHMG_ThrowGrenadeAirborneSelected) then Rule_Remove(Infantry_KillHMG_ThrowGrenadeAirborneSelected) end
		
		Rule_RemoveSGroupEvent(Infantry_KillHMG_CheckAbility, sg_playerunits)
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_ATTACKHMG, false)
		
		Util_StartIntel(EVENTS.InfantryAttackHMGDone)
		Rule_AddInterval(Infantry_PickUp_BeginLesson, 0.5)
		
	elseif Misc_IsSGroupSelected(sg_playerunits, ANY) == false and Rule_Exists(Infantry_KillHMG_ThrowGrenadeAirborneSelected) == false then
		
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_ATTACKHMG, OBJ_INFANTRY_ATTACKHMG.PingID)
		OBJ_INFANTRY_ATTACKHMG.PingID = Objective_AddUIElements(OBJ_INFANTRY_ATTACKHMG, sg_playerunits, false, 409266, true)
		
		Rule_AddInterval(Infantry_KillHMG_ThrowGrenadeAirborneSelected, 0.5)
		
	end
	
end




