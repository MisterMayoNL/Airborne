-----------------------------------------------------------------------------------
-- Ambient Event Speech
-----------------------------------------------------------------------------------

-- this function plays the ambient events for the first wave of phase 3
function Ambient_First_Wave()
	local min_time = 30	-- how much time has to pass before it will display another warning speech event
	local current_time = World_GetGameTime()
	local time_passed = current_time - last_ambient_first_wave 	-- how much time has passed since the last ambient event
	
	if wave == 2 then
		Rule_RemoveMe()
		
	elseif wave == 1 and time_passed >= min_time then
			
		last_ambient_first_wave = World_GetGameTime()
		Util_StartAmbient(EVENTS.Ambient_Phase3_First_Wave)
		
	end
end

-- this function plays the ambient events for the second wave of phase 3
function Ambient_Second_Wave()
	local min_time = 30	-- how much time has to pass before it will display another warning speech event
	local current_time = World_GetGameTime()
	local time_passed = current_time - last_ambient_second_wave 	-- how much time has passed since the last ambient event
	
	if wave == 3 then
		Rule_RemoveMe()
		
	elseif wave == 2 and time_passed >= min_time then
			
		last_ambient_second_wave = World_GetGameTime()
		Util_StartAmbient(EVENTS.Ambient_Phase3_Second_Wave)
		
	end
end

