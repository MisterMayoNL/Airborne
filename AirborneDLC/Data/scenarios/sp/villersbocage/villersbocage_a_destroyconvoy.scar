			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 50,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Vehicle Fixed")
				t_DC.t_Breakdown.bTargeting = false
				t_DC.t_Breakdown.bRepairing = false
				Camera_MoveToSGroup(sg_Tiger, true, SLOW_CAMERA_PANNING)
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011200 },
			},
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 54,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Starting Engine")
				SGroup_OverrideCriticalDisplay(sg_Tiger, CT_VehicleEngineRed, false, true)
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "startup_short")
				SGroup_SetAnimatorState(sg_Tiger, "blowtorch_state", "inactive")
				Rule_Remove(TankHeal_Rule_Continuous)
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Schroif, 6011260 },
			},
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 59,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Tank Starts Moving")
				Modifier_Remove(t_DC.t_Breakdown.speedMod)
				Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.SLOW_TURRET) -- give the player the ability to move back
				Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
				SGroup_SetAvgHealth(sg_Tiger, 1)
				SGroup_SetAnimatorState(sg_Tiger, "engine_backfire", "healthy")
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "healthy")
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss, 6011300 },
			},
		},
	}

end

function DestroyConvoy_Preset()

	-- spawn squads
	
	for k,this in pairs(t_DC.t_vehicles) do
		
		-- only spawn the first 7 vehicles.
		if k == 7 then
			break
		end
		
		if this.spawned == false then
			Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn)
			
			-- spawn the infantry that will occupy the vehicle
			if (k > 7 or this.sbp == SBP.CW.BREN_CARRIER)
			and this.sbp ~= SBP.CW.STUART
			and this.sbp ~= SBP.CW.STAGHOUND
			and this.sbp ~= SBP.CW.CROMWELL then
				local inf = t_DC.t_inf[k]
				Util_CreateSquads(player2, inf.sgroup, inf.sbp, this.sgroup, nil, nil, inf.loadout)
				if inf.upg ~= nil then
					Cmd_InstantUpgrade(inf.sgroup, inf.upg)
				end
			end
			
			Modify_Vulnerability(this.sgroup, 1.5)
			Modify_UnitSpeed(this.sgroup, 0.7)
			Timer_Start(t_DC.tmr_SpVehic, t_DC.tmr_SpVehicAmt)
			this.spawned = true
		end
	end
	
	-- start enemy behavior
	
	-- do other cool things

end

-- example of how to finish an Obj
function DestroyConvoy_WinCheck()
	
	-- check to see if the player has lost
	if t_DC.countEscaped ~= nil and t_DC.countEscaped > 6 then
		Objective_Fail(OBJ_DestroyConvoy)
		Rule_RemoveMe()
		return
	end
	
	-- check the player's command points
	if Player_GetResource(player1, RT_Command) > 0 then
		t_DC.bGrantResource = false
	end
	
	local all_dead = true
	local count = 0
	local count_alive = 0
	for k, this in pairs(t_DC.t_vehicles) do 
		if this.spawned == false then
			all_dead = false
			count_alive = count_alive + 1
		elseif SGroup_IsEmpty(this.sgroup) == false then
			all_dead = false
			count_alive = count_alive + 1
			if SGroup_IsEmpty(sg_DC_ObjUI) == true then
				if this.objUI == false then
					this.objUI = Objective_AddUIElements(OBJ_DestroyConvoy, this.sgroup, true, nil, true)
					SGroup_AddGroup(sg_DC_ObjUI, this.sgroup)
				end
			end
		else
			count = count + 1
		end
	end
	t_DC.totalAlive = count_alive
	print("Alive: "..count_alive)
	
	if t_DC.t_Breakdown.bStarted == false
	and count >= t_DC.t_Breakdown.count then
		DC_StartBreakdown()
	end
	
	if all_dead == true then
		Objective_Complete(OBJ_DestroyConvoy)
		Rule_RemoveMe()
	end

	
end

function DestroyConvoy_Debug()

	-- add in the necessary information that can automatically start this objective 
	-- with the press of a hotkey
	for k, this in pairs(t_DC.t_vehicles) do 
		SGroup_DestroyAllSquads(this.sgroup)
		this.spawned = true
	end

end


-- start the related action
function DestroyConvoy_Kickoff()

	-- action that starts with the Obj being granted
	Rule_AddDelayedInterval(DestroyConvoy_Rule_AI, 20, 1.5)
	
	Util_CreateSquads(player2, sg_DCStaghound, SBP.CW.STAGHOUND, mkr_VillersA_StagSp)
	Cmd_SquadPath(sg_DCStaghound, "path_Villers_A_Start", true, LOOP_NONE, false, 0)
	Modify_Vulnerability(sg_DCStaghound, 0.55)
	Squad_SetInvulnerableMinCap(SGroup_GetSpawnedSquadAt(sg_DCStaghound, 1), 0.4, 12)
	
end


function DestroyConvoy_Rule_AI()
	
	if Objective_IsComplete(OBJ_DestroyConvoy) then
		Rule_RemoveMe()
		return
	end
	
	if SGroup_IsEmpty(sg_DCStaghound) == false
	and SGroup_IsOnScreen(player1, sg_DCStaghound, ANY, 0.9) == true 
	and Prox_MarkerSGroup(mkr_VillersA_Stag2, sg_DCStaghound, PROX_CENTER) > 5 then
		Cmd_Move(sg_DCStaghound, mkr_VillersA_Stag2)
	end
	
	for k,this in pairs(t_DC.t_inf) do 
		if SGroup_IsEmpty(this.sgroup) == false then
			if SGroup_IsOnScreen(player1, this.sgroup, ANY, 0.8)
			or SGroup_IsInHoldSquad(this.sgroup, ANY) == false
			or SGroup_IsUnderAttack(this.sgroup, ANY, 20) then
				
				if CombatPlan_IsExecuting(this.CombatPlanId) == false then
					this.CombatPlanId = CombatPlan_Add(this.sgroup, this.CombatPlan, sg_Tiger)
				end
			end
			
			if Prox_AreSquadsNearMarker(this.sgroup, mkr_ConvoyRetreatDelete, ANY, 10) then
				Rule_RemoveSGroupEvent(VBBounty_DeathEvent, this.sgroup)
				SGroup_DestroyAllSquads(this.sgroup)
				
			end
		end
	end	
	
	for k,this in pairs(t_DC.t_vehicles) do
	
		if this.spawned == false then
			if Timer_Exists( t_DC.tmr_SpVehic ) == false
			or Timer_GetRemaining( t_DC.tmr_SpVehic ) == 0 then
				Util_CreateSquads(player2, this.sgroup, this.sbp, this.posSpawn)
				
				if this.sbp ~= SBP.CW.STUART 
				and this.sbp ~= SBP.CW.CROMWELL 
				and this.sbp ~= SBP.CW.STAGHOUND then
					local inf = t_DC.t_inf[k]
					Util_CreateSquads(player2, inf.sgroup, inf.sbp, this.sgroup, nil, nil, inf.loadout)
					if this.upg ~= nil then
						Cmd_InstantUpgrade(inf.sgroup, inf.upg)
					end
					
					-- only modify the unit carrying vehicles.
					Modify_Vulnerability(this.sgroup, 1.5)
				end
				
				Modify_UnitSpeed(this.sgroup, 0.70)
				Cmd_SquadPath(this.sgroup, "path_Convoy", true, false, true, nil)
				Timer_Start(t_DC.tmr_SpVehic, t_DC.tmr_SpVehicAmt)
				this.spawned = true
				break
			else
				break
			end
		elseif SGroup_IsEmpty(this.sgroup) == false then
			
			if Prox_AreSquadsNearMarker(this.sgroup, mkr_ConvoyExit, ANY, 10) == true
			or (Prox_AreSquadsNearMarker(this.sgroup, mkr_ConvoyRetreatDelete, ANY, 10) == true and this.runAway == true) then
				if t_DC.totalAlive <= 2 then
					t_DC.bAltObjComplete = true
				end
				SGroup_RemoveGroup( sg_DC_ObjUI, this.sgroup)
				
				if SGroup_IsHoldingAny(this.sgroup) == true then
					SGroup_Clear(sg_temp)
					SGroup_GetSquadsHeld(this.sgroup, sg_temp)
					Rule_RemoveSGroupEvent( VBBounty_DeathEvent, sg_temp)
				end
				Rule_RemoveSGroupEvent(VBBounty_DeathEvent, this.sgroup)
				SGroup_DestroyAllSquads(this.sgroup)
				
				if t_DC.countEscaped == nil then
					t_DC.countEscaped  = 0
				end
				t_DC.countEscaped = t_DC.countEscaped  + 1
				
				if t_DC.countEscaped == 3 then
					Util_AutoIntel( t_DC.t_Speech.objFailWarning1 )
				elseif t_DC.countEscaped == 4 then
					Util_AutoIntel( t_DC.t_Speech.objFailWarning2 )
				end
			end
			
			if t_DC.t_Speech.bConvoyApproach == false 
			and this.sbp == SBP.CW.CROMWELL 
			and (SGroup_IsDoingAttack(this.sgroup, ANY, 10) == true or SGroup_IsUnderAttack(this.sgroup, ANY, 10) == true) then
				Util_AutoIntel(t_DC.t_Speech.convoyApproach)
				t_DC.t_Speech.bConvoyApproach = true
			end
			
			-- manages trucks deciding to run away from the Tiger
			-- are you bored yet?
			if this.imBored == true then
				if (SGroup_IsUnderAttack(this.sgroup, ANY, 15) == false 
				or (SGroup_IsEmpty(sg_Tiger) == false and Prox_SGroupSGroup(this.sgroup, sg_Tiger, PROX_SHORTEST) <= 25))
				and SGroup_IsMoving(this.sgroup, false) == false then
					Cmd_SquadPath(this.sgroup, "path_Convoy", true, false, true, nil)
				end
				
			elseif this.runAway == true 
			and SGroup_IsHoldingAny(this.sgroup) == false then
				if SGroup_IsOnScreen(player1, this.sgroup, ANY, 0.8)
				and (SGroup_IsEmpty(sg_Tiger) == false and Prox_SGroupSGroup(sg_Tiger, this.sgroup, PROX_SHORTEST) <= 25) then
					Cmd_Move(this.sgroup, mkr_ConvoyRetreatDelete)
				end
			elseif SGroup_IsUnderAttack(this.sgroup, ANY, 15) 
			or (SGroup_IsEmpty(sg_Tiger) == false and Prox_SGroupSGroup(this.sgroup, sg_Tiger, PROX_SHORTEST) <= 25) then
				
				if SGroup_IsMoving(this.sgroup, ANY) == true then
					Cmd_Stop(this.sgroup)
				elseif SGroup_IsHoldingAny(this.sgroup) == false
				and this.runAway ~= true
				and (this.sbp == SBP.VILLERS_BOCAGE.CW.VILLERS_TRUCK or this.sbp == SBP.VILLERS_BOCAGE.CW.M3_HALFTRACK) then
					this.runAway = true
				elseif SGroup_IsMoving(this.sgroup, ANY) == false
				and SGroup_IsOnScreen(player1, this.sgroup, ANY, 0.8) == true then
					Cmd_Ungarrison(this.sgroup)
				end
				
			end
			
			-- counter for the boredom
			if this.imBored ~= nil and scartype(this.imBored) == ST_NUMBER then
				if this.imBored <= 0 then
					this.imBored = true
				else
					this.imBored = this.imBored-1
				end
			end
			
--~ 			if SGroup_GetAvgHealth(this.sgroup) <= 0.1 then
--~ 				local rand = World_GetRand(1, 5)
--~ 				if SGroup_IsMoving(this.sgroup, ANY) and rand == 5 then
--~ 					Cmd_CriticalHit(player2, this.sgroup, CRIT.VEH.CONTROL_FAST, CRIT.DAMAGE_RED)
--~ 				else
--~ 					SGroup_Kill(this.sgroup)
--~ 				end
--~ 			end
			
		end
	end

end

function DC_GetRandomTommyUpgrade()

	local upg = {UPG.CW.RIFLE_GRENADE, UPG.CW.BREN, false, false }
	item = upg[World_GetRand(1, table.getn(upg))]
	
	if item == false then
		return nil
	end
	return item
	
end




function DC_StartBreakdown()

	if Rule_Exists(DC_RuleBreakdown) == false then
		Rule_AddInterval(DC_RuleBreakdown, 0.2)
	end
	
	t_DC.t_Breakdown.bStarted = true
	Timer_Start(t_DC.t_Breakdown.tmrEvents, t_DC.t_Breakdown.tmrEventsAmt)

end


function DC_RuleBreakdown()

	if Timer_GetRemaining(t_DC.t_Breakdown.tmrEvents) == 0 then
		DC_FinishBreakdown()
		-- function to randomly slow the tank
		Rule_AddDelayedInterval(DC_BreakdownTeaser, 45, 13)
		Rule_RemoveMe()
		return
	end
	
	-- don't try to run this rule if the tiger has died
	if SGroup_IsEmpty(sg_Tiger) == true then
		return
	end
	
	if t_DC.t_Breakdown.bRepairing == true 
	and g_difficulty ~= GD_EXPERT
	and SGroup_IsDoingAbility(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR, ANY) == false then
		Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR)
	end
	
	if t_DC.t_Breakdown.bTargeting == true then
		
--~ 		UI_CreateSGroupKickerMessage(player1, sg_Tiger, 6019514)
		
		if SGroup_IsEmpty(sg_DCBreakdownTarget) == true then
			
			Player_GetAllSquadsNearMarker(player2, sg_DCBreakdownTarget, Misc_GetMouseOnTerrain(), 6)
			SGroup_Filter(sg_DCBreakdownTarget, {SBP.CW.TOMMIES, SBP.CW.LIEUTENANT, SBP.CW.SAPPER}, FILTER_REMOVE) 
			if SGroup_IsEmpty(sg_DCBreakdownTarget) == false 
			and Player_CanSeeSGroup(player1, sg_DCBreakdownTarget, ANY) == true then
				if t_DC.t_Breakdown.hpTarget ~= nil then
					HintPoint_Remove(t_DC.t_Breakdown.hpTarget)
				end
				if t_DC.t_Breakdown.hpGroundTarget ~= nil then
					HintPoint_Remove(t_DC.t_Breakdown.hpGroundTarget)
				end
				if Squad_IsDirectFireActive(SGroup_GetSpawnedSquadAt(sg_Tiger, 1)) == true then
					t_DC.t_Breakdown.hpTarget = HintPoint_Add(SGroup_GetSpawnedSquadAt(sg_DCBreakdownTarget, 1), true, 6019513)
				end
				Util_AutoIntel(t_DC.t_Speech.targetAcquiredRand, true)
			else
				if t_DC.t_Breakdown.hpGroundTarget ~= nil then
					HintPoint_Remove(t_DC.t_Breakdown.hpGroundTarget)
				end
--~ 				t_DC.t_Breakdown.hpGroundTarget = HintPoint_Add(Misc_GetMouseOnTerrain(), true, 6019503)
			end
		end
		
	end
	
	for k, this in pairs(t_DC.t_Breakdown.t_Events) do
		
		if Timer_GetRemaining(t_DC.t_Breakdown.tmrEvents) <= this.execTime then
			this.execFunc()
			table.remove(t_DC.t_Breakdown.t_Events, k)
			if scartype(this.speech) == ST_TABLE then
				Util_AutoIntel(this.speech)
			end
		end
	end

end

-- turn an engine breakdown teaser on and off
-- every 13 seconds it has a 1 in 4 chance of breaking down
-- speech pieces are recycled from the other major break down events
function DC_BreakdownTeaser()

	if t_DC.teaserOn == true then
		
		t_DC.teaserOn = false
		
		SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "healthy")
		Modifier_Remove(t_DC.teaserSpeed)
		
		local rand = World_GetRand(1, 2)
		if rand == 1 and Event_IsAnyRunning() == false then
			Util_AutoIntel({{ ACTOR.VILLERS_BOCAGE.Voss, 6012020 }})
		end
		
	elseif t_CVB.t_firefly.bTriggered ~= true
	and Event_IsAnyRunning() == false then
		
		if SGroup_IsEmpty(sg_Tiger) == false then
			local rand = World_GetRand(1, 5)
			if SGroup_GetAvgHealth( sg_Tiger ) < 0.6 then
				rand = World_GetRand(1, 4)
			end
			
			if rand == 1 then
				
				t_DC.teaserOn = true
				t_DC.teaserSpeed = Modify_UnitSpeed(sg_Tiger, .6)
				
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "grinding_running")
				
				local rand = World_GetRand(1, 3)
				if rand == 1 then 
					local speech = {
						{ ACTOR.VILLERS_BOCAGE.Voss, 6011120 },
						{ ACTOR.VILLERS_BOCAGE.Schroif, 6011190 },
						{ ACTOR.VILLERS_BOCAGE.Schroif, 6011140 },
						{ ACTOR.VILLERS_BOCAGE.Schroif, 6011160 },
					}
					Util_AutoIntel(speech, true)
				end
			end
		end
		
	end
	
	-- remove once the fireflies are triggered
	if t_CVB.t_firefly.bTriggered == true then
		Rule_RemoveMe()
		return
	end
	
end

function DC_FinishBreakdown()

	TankHeal_AddSGroup(sg_Tiger)
	Modifier_Remove(g_StopTank)
	HintPoint_Remove(t_DC.t_Breakdown.hpTarget)
	HintPoint_Remove(t_DC.t_Breakdown.hpGroundTarget)
	EGroup_DestroyAllEntities(eg_BreakdownSmoke)

end
