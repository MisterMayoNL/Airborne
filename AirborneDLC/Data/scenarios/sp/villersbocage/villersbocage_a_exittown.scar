-------------------------------------------------------------------------
-- Exit Town
-------------------------------------------------------------------------
-- A fake objective that orders the player to head back to Point 2-1-3, but
-- when he tries to head there, his tank is ambushed by an AT Gun and disabled.
-------------------------------------------------------------------------
function Initialize_OBJ_ExitTown()

	OBJ_ExitTown = {
		
		SetupUI = function() 
			-- mark a point or position
			OBJ_ExitTown.mapElementID = Objective_AddUIElements(OBJ_ExitTown, mkr_ConvoyExit, true)
			Objective_SetAlwaysShowDetails(OBJ_ExitTown, false, true, false)
		end,
		
		OnStart = function()
			
			-- announce the goal
			-- Util_AutoIntel(t_obj_title.EventStart)
			
			-- win/lose check
			
			
			-- start related action
			
		end,
		
		OnComplete = function()
			
			-- tell the player they did good
			
		end,
		
		IsComplete = function()
			return false
		end,
		
		OnFail = function()
			
			-- tell the player they lost
			
		end,
		
		Title = 6019300,
		Description = 6019310,
		Type = OT_Primary,
		
--~ 		SitRep = {}, -- only needed once the SitRep is created and there are lines of dialogue.
	}
	
	-- Register Objective
--~ 	Objective_Register(OBJ_ExitTown)
	
	-- Initialize Data
	ExitTown_Init()
	
end

Scar_AddInit(Initialize_OBJ_ExitTown)

-------------------------------------------------------------------------
-- Exit Town - Functions 
-------------------------------------------------------------------------

-- 'Init()' is used to initialize the Obj data
-- anything that needs to be there for the Obj to work
-- does not need to be called at 'OnInit()'
function ExitTown_Init()

	-- data needed?
	t_ET = {
		
		tmr			= "TIMER EXIT TOWN",
		tmrAmount	= 35,
	}
	
	t_ET.t_Speech = {
		
		objStart = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010692 },
			{ ACTOR.VILLERS_BOCAGE.Shultz, 	6010700 },
			-- insert kill count line here
		},
		
		killCount = {},
		
		ambObjStart = {
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010970 },
			{ ACTOR.VILLERS_BOCAGE.Voss, 	6010980 },
		}
	}
	
	-- the placement of the kills in the table matches the speech line that is delivered.
	-- 1 to 15
	for i=1, 15 do 
		t_ET.t_Speech.killCount[i] = { ACTOR.VILLERS_BOCAGE.Litzke, 6010710 }
