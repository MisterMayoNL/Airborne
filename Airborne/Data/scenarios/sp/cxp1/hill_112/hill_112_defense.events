--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- NIS File for Hill 112 Defence Mission
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

function NIS_Init()

	-- load NIS's
	NIS01 = "sp/CXP1/Hill_112/NIS/N05_01"
	nis_load(NIS01)
	
	nis_setintransitiontime(0)
	nis_setouttransitiontime(0)

end

Scar_AddInit(NIS_Init)





EVENTS = {}


--------------------------------------------------------------------------------
-- Opening Cinematic (NIS01)
--------------------------------------------------------------------------------

EVENTS.NIS01 = function()

	Game_Letterbox(true, 0)
	
	CTRL.Scar_PlayNIS(NIS01)
	CTRL.WAIT()
	
	nis_stop()
	
	Game_Letterbox(false, 2)
	
end

EVENTS.GlennDead = function()
	UI_EnableEventSkip(false)
	CTRL.Event_Delay(1)
	CTRL.WAIT()
	Game_Letterbox(true, 0)
	UI_EnableEventSkip(true)
	Camera_MoveToPosition(cameraGlenn, true, SLOW_CAMERA_PANNING)
	CTRL.Event_Delay(2.5)
	CTRL.WAIT()
end


--------------------------------------------------------------------------------
-- Initial Attack
--------------------------------------------------------------------------------

EVENTS.FirstAttack_Chatter = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380200)		-- Captain Wallace sir, we've got some heavy troubles.  
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380201)		-- I can't get anything up the chain.
	CTRL.WAIT()
end


EVENTS.FirstAttack_LieutenantResponse = function()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Wallis, 1380203)		-- Fuckin shite, get ahold of yourself lad.  
	CTRL.WAIT()
	CTRL.Actor_PlaySpeechWithoutPortrait(ACTOR.CXP1.Wallis, 1380204)		-- Every moment you waste worrying good men die.   
	CTRL.WAIT()
end


EVENTS.FirstAttack_MentionArtillery = function()
	
	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Wallis, line = 1380210}		-- Radio artillery and tell them to target the grid location ahead of our current position.
	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1380211}		-- Have Arty blast this goddamn good'fer'nothing hill!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()
end


EVENTS.FirstAttack_MentionArtilleryAgain = function()
	
	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Wallis, line = 1380220}		-- For Christ's sake call that artillery in NOW!
	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1380221}		-- We need some bloody Arty support ASAP!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()

end


EVENTS.FirstAttack_PostBattleChatter = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380230)		-- Stand Down, Stand Down. 
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380231)		-- I knew we'd be easy bloody targets on this foresaken Hill.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380240)		-- CPL Dillingham, get 3rd Battalion HQ on the horn A-SAP, we need  all the support we can get before those Panzers throw themselves at us again.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380232)		-- We got no bloody luck Sir, the radio to HQ's gone dead and forward observers are reporting Jerry Panzers in-bound.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380222)		-- Alright Coporal level yourself and listen closeley!
	CTRL.WAIT()
end



