end

-- example of how to finish an Obj
function ExitTown_Rule_WinCheck()
	
	if SGroup_IsEmpty(sg_Tiger) == true then
		return
	end
	
	if Event_IsAnyRunning() == false then
		SGroup_SetInvulnerable(sg_Tiger, true)
		
		Util_StartNIS(NIS_CLOSING_NO_BLACK, nil, {player1, player2})
		
		-- removing the RPGMechanics Rule to prevent audio from playing after the last NIS.
		Rule_Remove(VB_RPGMechanics_ThreatAssess)
		Rule_AddOneShot(ET_DelayTigerModifications, 1.1)
		Rule_Add(ExitTown_DelayObjectiveCompletion)
		TankHeal_Stop()
		Rule_RemoveMe()
	end
	
end

function ET_DelayTigerModifications()

	Cmd_Stop( sg_Tiger )
	Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.COMMANDER_DOWN, nil, nil, true)
	Cmd_Ability(player1, ABILITY.SP.SINGLE_MORTAR_SMOKEENTRANCE, SGroup_GetPosition(sg_Tiger))

end

function ExitTown_DelayObjectiveCompletion()

	if Event_IsAnyRunning() == false then
--~ 		Objective_Complete(OBJ_ExitTown, false)
		g_CompleteMission = true
	end

end

function ExitTown_Debug()

	-- add in the necessary information that can automatically start this objective 
	-- with the press of a hotkey
	Objective_Start(OBJ_ExitTown)

end


-- start the related action
-- Rule added in VillersBocage_A.scar
function ExitTown_Kickoff()

	if SGroup_IsEmpty( sg_Tiger ) == false then
		
		if SGroup_IsDoingAbility( sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR , ANY ) == true then
			SGroup_StopAbility( sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.TIGER_REPAIR, true)
		elseif SGroup_IsDoingAbility( sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.FLANK_SPEED , ANY ) == true then
			SGroup_StopAbility( sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.FLANK_SPEED, true)
		else
			Cmd_Ability(sg_Tiger, ABILITY.SP.VILLERS_BOCAGE.COMMANDER_DOWN, nil, nil, true, false)
			
			if SGroup_IsEmpty(sg_Tiger) == false then
				Cmd_Move(sg_Tiger, mkr_ConvoyExit)
				Modify_UnitSpeed( sg_Tiger, 0.2)
				Camera_FollowSGroup(sg_Tiger)
			end
	
			voss_start = {6010690, 6010691, 6010692}
			local nislet = {
				{camPos = false, waitType = NISLET_TIME, waitValue = 1},
				{camPos = false, waitType = NISLET_VO, waitValue = {ACTOR.VILLERS_BOCAGE.Voss, voss_start[World_GetRand(1, table.getn(voss_start))]}},
				{camPos = false, waitType = NISLET_VO, waitValue = {ACTOR.VILLERS_BOCAGE.Shultz, 6010700}},
				{camPos = false, waitType = NISLET_VO, waitValue = t_ET.t_Speech.killCount[g_KillCount]},
				{camPos = false, waitType = NISLET_VO, waitValue = {ACTOR.VILLERS_BOCAGE.Shultz, 6010990}},
				{camPos = false, waitType = NISLET_VO, waitValue = {ACTOR.VILLERS_BOCAGE.Shultz, 6011000}},
				{camPos = false, waitType = NISLET_TIME, waitValue = 1},
			}
			
			Util_AutoNISlet(NISLET_GAME2LETTER, nislet)
			Rule_AddInterval(ExitTown_Rule_WinCheck, 1)
			Rule_RemoveMe()
		end
		
	end
	
end

