EVENTS.ArtilleryTowerFinish = function()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 299101)  -- We have concealed our positions from the Nebelwerfers now
	CTRL.WAIT()
end
EVENTS.SpeechDozer = function()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290330)  -- Without those dozers on our Shermans we're not going anywhere.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290340)  -- Crush the hedgerows to avoid chokepoints
	CTRL.WAIT()
end

EVENTS.LeftTown = function()

	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290220)  -- The Germans are reinforcing the hedges on this left side from here.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290230)  -- We should reinforce every point from here on.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290240)  -- We can't have Jerry coming in and cutting off our advance. 
	CTRL.WAIT()
end

EVENTS.RightTown = function()

	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290250)  -- This is where Charlie Company got ambushed.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.Conti, 290260)  -- We should secure this town to protect our right flank. 
	CTRL.WAIT()
end
EVENTS.Flank = function()
	CTRL.Actor_PlaySpeech( ACTOR.McKay, 290280)  -- The Germans are using the hedgerows to flank our main line of advance.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech( ACTOR.McKay, 290290)  -- Defend our flanks by deploying MGs and mortar squads along the hedgerows.
	CTRL.WAIT()
end

