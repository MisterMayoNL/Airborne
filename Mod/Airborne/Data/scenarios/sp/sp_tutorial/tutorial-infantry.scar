function Infantry_Upgrade_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		Player_SetUpgradeAvailability(player1, UPG.ALLIES.PARATROOPER_AT, ITEM_DEFAULT)
		
		-- make sure the player has enough resources
		Tutorial_SafetySetResources(cost.recoilless)	
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_UPGRADE, false)
		
		if Misc_IsSGroupSelected(sg_group1, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryUpgradeIntro)
			
			flashid_infantry_upgrade = UI_FlashProductionButton(PITEM_SquadUpgrade, UPG.ALLIES.PARATROOPER_AT, true, BT_UI_Strong_UpgradeBtn )
			HintPoint_AddToProductionButton(PITEM_SquadUpgrade, UPG.ALLIES.PARATROOPER_AT, 409272, true)
			Rule_AddInterval(Infantry_Upgrade_IsUpgrading, 0.5)
			
		else
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.ParatroopersSelect)
			
			OBJ_INFANTRY_UPGRADE.PingID = Objective_AddUIElements(OBJ_INFANTRY_UPGRADE, sg_group1, false, 409266, true)
			
			Rule_AddInterval(Infantry_Upgrade_AirborneSelected, 0.5)
			
