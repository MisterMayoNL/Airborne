EVENTS.SpeechTownHallOverun = function()
	CTRL.Actor_PlaySpeech(ACTOR.Joey , 240270)						--    GOD DAMN!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Joey, 240280)						--    FALL BACK!
	CTRL.WAIT()
	local rand = World_GetRand(1, 2)
	if rand == 1 then
		CTRL.Actor_PlaySpeech(ACTOR.Joey, 240290)						--     The town square’s OVERRUN.
		CTRL.WAIT()
	elseif rand == 2 then
		CTRL.Actor_PlaySpeech(ACTOR.Joey, 240260)						--     The town square’s OVERRUN.
		CTRL.WAIT()
	end
	CTRL.Actor_PlaySpeech(ACTOR.Lewis, 243008)						--    Let's hustle!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Thompson, 240300)						--     WITHDRAW to the church and defend it at all costs.
	CTRL.WAIT()
	
end


