-- The player first is confronted by a smal force before the main counterattack, but it contains a Tiger Tank!
EVENTS.OBJ_TigerEngaged = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Bailey, line = 1370800} -- Stand To!  Germans on the line!
	choices[2] = {actor = ACTOR.CXP1.Bailey, line = 1370810} -- Cover off on your posts!  Jerry's tryin' to push in! 
	choices[3] = {actor = ACTOR.CXP1.Bailey, line = 1370820} -- Man your posts!  They've mustered a counter attack!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Event_Delay(0.5)
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	
	CTRL.WAIT()
	
end



--------------------------------------------------------------------------------
-- Main Counterattack
--------------------------------------------------------------------------------

-- Blackmore's post-sitrep speech
EVENTS.OBJ_PostSitRep = function()
	
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Blackmore, 1370910)	-- Get this out at section level.  Make sure they know its coming directly from me.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Blackmore, 1370920)	-- Defend Caen... At all costs.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Blackmore, 1370930)	-- Show the Hun's what you're made of.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Blackmore, 1370940)	-- Our motto is "Doubt not" for good reason.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech (ACTOR.CXP1.Blackmore, 1370950)	-- Let's hand Jerry his arse.
	CTRL.WAIT()
end

