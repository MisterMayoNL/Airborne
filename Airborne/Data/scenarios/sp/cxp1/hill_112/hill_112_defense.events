end


EVENTS.Deploy_ArmourHQArrived = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380254)		-- Armour HQ on map. Get service battalion to set that thing up double quick lads!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1380255)		-- Move all HQ Trucks and the Command Posts away from the villages and to the Hill. We need to keep them in sight and away from Jerry!
	CTRL.WAIT()
end


EVENTS.Deploy_FireflysArrivingShortly = function()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380830)		-- Captain Wallis! I've got HQ! Fucking hell!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Dillingham, 1380840)		-- I've managed to raise Battalion sigs, message from Major Blackmore's coming in Sir!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1380850)		-- RSE this is Major Blackmore heavy armor support is in-bound! We got your back now boys!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1380860)		-- Maintain control of the Odon at all costs!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1380870)		-- We'll be there soon, tell the men to hold tight Captain Wallis!
	CTRL.WAIT()
end




