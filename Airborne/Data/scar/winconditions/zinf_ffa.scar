		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.CW.ENGINEERS_11, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.CW.ENGINEERS_12, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.ELITE.TANK_DESTROYER, ITEM_LOCKED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.ELITE.SCORCHED_EARTH_12, ITEM_REMOVED)
		 Player_SetUpgradeAvailability(World_GetPlayerAt(i), UPG.COMMANDER_TREE.ELITE.LUFTWAFFE_02, ITEM_REMOVED)
