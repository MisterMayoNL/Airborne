--------------------------------------------------------------------------------
-- Bridge Counterattack / meatgrinder
--------------------------------------------------------------------------------

EVENTS.BridgeCounterattack = function()
	
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Degnan, 1361090) -- German's are counter attacking!  Rally the troops and block their advance!
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Seville, 1361094) -- Jerry's moving on the fuckin' island!
	
	CTRL.WAIT()
	
end

EVENTS.DegnanDies = function()

	if g_DegnanKiller == "Sniper" then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1361890) -- Sniper!
		CTRL.WAIT()
	elseif g_DegnanKiller == "MG42" then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1361920) -- Duck MG!!!!!!!
		CTRL.WAIT()
	elseif g_DegnanKiller == "Mine" then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1361910) -- Watch out for that mine!
		CTRL.WAIT()
	elseif g_DegnanKiller == "Panzer" then
		CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1361900) -- Watch out for that Panzer!
		CTRL.WAIT()
	end
		
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1361930) -- Oh fucking hell, they got Degnan!
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Wallis, 1361940) -- We need a medic double quick! Medic!
	CTRL.WAIT()
	
	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Jones, line = 1361950} -- Degnans down! Right fucked mate!
	choices[2] = {actor = ACTOR.CXP1.Jones, line = 1361960} -- Shite! Degnans fucked mate!
	choices[3] = {actor = ACTOR.CXP1.Jones, line = 1361970} -- Jerry took Degnan out!
	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Event_Delay(0.5)
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	
	CTRL.WAIT()
	
end

--------------------------------------------------------------------------------
-- Mission Complete
--------------------------------------------------------------------------------

EVENTS.MissionComplete = function()

	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1361790)	-- Understood. (beat) Capt. Cutting, have the Battalion stand down.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1361800)	-- Make sure they take care of our wounded lads.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1361810)	-- And give me list of names for battlefield commendations.
	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.CXP1.Blackmore, 1361820)	-- Caen is ours!
	CTRL.WAIT()
end 