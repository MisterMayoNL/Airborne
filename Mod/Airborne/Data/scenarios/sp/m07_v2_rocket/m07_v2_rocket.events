	CTRL.WAIT()
	CTRL.Actor_PlaySpeech(ACTOR.Carota, 272140)
	CTRL.WAIT()
end

t_dv2_under_attack = {272150, 272160, 272170}
EVENTS.OBJ_DV2_SnipersAttacking = function()
	local text = t_dv2_under_attack[World_GetRand(1, table.getn(t_dv2_under_attack))]
		--if text >= 272150 and text <= 272170 then
			CTRL.Actor_PlaySpeech(ACTOR.Carota, text)
			CTRL.WAIT()
