EVENTS.Losing_Points = function()

	local choices = {}
	choices[1] = {actor = ACTOR.CXP1.Wallis, line = 1380310}		-- Enemy elements are approaching the hill!
	choices[2] = {actor = ACTOR.CXP1.Wallis, line = 1380311}		-- The Germans are closing in, hold your line and for Christ-sakes keep our control points!
	choices[3] = {actor = ACTOR.CXP1.Wallis, line = 1380312}		-- We've lost another Sector - push the fucking Jerries back off that damn hill!
	choices[4] = {actor = ACTOR.CXP1.Wallis, line = 1380313}		-- Ready... Enemy contacts in-bound to the hill
	choices[5] = {actor = ACTOR.CXP1.Wallis, line = 1380314}		-- Jerry's back! Get to his location before we lose more territory.
	choices[6] = {actor = ACTOR.CXP1.Wallis, line = 1380315}		-- The enemy is trying to cut us off. 

	
	local rand = World_GetRand(1, table.getn(choices))
	
	CTRL.Actor_PlaySpeech(choices[rand].actor, choices[rand].line)
	CTRL.WAIT()

end


