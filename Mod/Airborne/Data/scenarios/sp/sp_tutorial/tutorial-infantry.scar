--------------------------------------------------------------------------------
-- Lesson: Capture Point
--------------------------------------------------------------------------------
function Infantry_Capture_BeginLesson()
	
	if Event_IsAnyRunning() == false then
		
		Rule_RemoveMe()
		
		-- give the objective
		Objective_Start(OBJ_INFANTRY_CAPTURE, false)
		
		SGroup_AddGroup(sg_playerunits, sg_group1)
		Player_SetCommandAvailability(player1, SCMD_Capture, ITEM_DEFAULT)
		
		-- if we've tripped the "make invulnerable when down to four" rule, reset it
		if Rule_Exists(Infantry_CheckSquad) == false then
			SGroup_SetInvulnerable(sg_playerunits, false)
			Rule_Add(Infantry_CheckSquad)
		end
		
		if Misc_IsSGroupSelected(sg_group1, ANY) then
			
			-- give the introductory talk
			Util_StartIntel(EVENTS.InfantryCaptureIntro)
			
			OBJ_INFANTRY_CAPTURE.PingID = Objective_AddUIElements(OBJ_INFANTRY_CAPTURE, eg_vp_infantry, false, 409262, true, 2)
			
			Rule_AddInterval(Infantry_Capture_Done, 1)
			
		else
			
			-- ask to select paratroopers
			Util_StartIntel(EVENTS.InfantryCaptureSelectNew)
			
			OBJ_INFANTRY_CAPTURE.PingID = Objective_AddUIElements(OBJ_INFANTRY_CAPTURE, sg_group1, false, 409266, true)
			
			Rule_AddInterval(Infantry_Capture_AirborneSelected, 0.5)
			
		end
		
	end
	
end


function Infantry_Capture_AirborneSelected()
	
	if Misc_IsSGroupSelected(sg_group1, ANY) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- give the introductory talk
		Util_StartIntel(EVENTS.InfantryCaptureIntro)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_CAPTURE, OBJ_INFANTRY_CAPTURE.PingID)
		OBJ_INFANTRY_CAPTURE.PingID = Objective_AddUIElements(OBJ_INFANTRY_CAPTURE, eg_vp_infantry, false, 409262, true, 2)
		
		Rule_AddInterval(Infantry_Capture_Done, 1)
		
	end
	
end


function Infantry_Capture_Done()
	
	if Player_OwnsEGroup(player1, eg_vp_infantry) then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- complete the objective
		Objective_Complete(OBJ_INFANTRY_CAPTURE, false)
		HintPoint_RemoveAll()
		
		Util_StartIntel(EVENTS.InfantryCaptureDone)
		Rule_AddInterval(Infantry_Upgrade_BeginLesson, 0.5)
		
	elseif Misc_IsSGroupSelected(sg_group1, ANY) == false then
		
		Rule_RemoveMe()
		Game_SkipEvent()
		
		-- ask to re-select paratroopers
		Util_StartIntel(EVENTS.ParatroopersReSelect)
		
		Objective_RemoveUIElements(OBJ_INFANTRY_CAPTURE, OBJ_INFANTRY_CAPTURE.PingID)
		OBJ_INFANTRY_CAPTURE.PingID = Objective_AddUIElements(OBJ_INFANTRY_CAPTURE, sg_group1, false, 409266, true)
		
		Rule_AddInterval(Infantry_Capture_AirborneSelected, 0.5)
		
	end
	
end




