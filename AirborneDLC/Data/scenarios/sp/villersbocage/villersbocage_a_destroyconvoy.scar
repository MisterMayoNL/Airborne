function DestroyConvoy_InitBreakdown()

	sg_DCBreakdownTarget = SGroup_CreateIfNotFound("sg_DCBreakdownTarget")
	eg_BreakdownSmoke = EGroup_CreateIfNotFound("eg_BreakdownSmoke")
	
	----------------------------------------------------------------------------------
	-- ************************ TANK BREAKDOWN ************************************ --
	----------------------------------------------------------------------------------
	t_DC.t_Breakdown = {
		tmrEvents 			= "DC BREAKDOWN TIMER",
		tmrEventsAmt		= 60,
		count				= 5, 			-- number of convoy vehicles that need to be destroyed before the breakdown event will occur
		bStarted			= false,
		speedMod			= false,
	}

	t_DC.t_Breakdown.t_Events = {
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 1,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Starts Breaking Down")
				if SGroup_IsMoving(sg_Tiger, ANY) == false then
					Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
				end
				SGroup_OverrideCriticalDisplay(sg_Tiger, CT_VehicleEngineYellow, true, true)
				
				SGroup_SetAnimatorState(sg_Tiger, "tiger_breakdown", "grinding_short")
			end,
			speech = false,
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 2,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Tank Lurches")
				Cmd_Stop(sg_Tiger)
			end,
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 3,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Speech About Getting Fixed")
				Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
			end,
			speech = {
				{ ACTOR.VILLERS_BOCAGE.Voss, 6012037 },
			},
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 4,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Starting Repairs")
				Cmd_Stop(sg_Tiger)
			end,
			speech = false,
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 5,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Checking Tank")
				Cmd_Move(sg_Tiger, SGroup_GetOffsetPosition(sg_Tiger, OFFSET_FRONT, 10))
			end,
			speech = false
		},
		{
			execTime 		= t_DC.t_Breakdown.tmrEventsAmt - 6,
			execFunc 		= function()
				print("t_DC.t_Breakdown.t_Events >> Fixed, Starting Engine")
				t_DC.t_Breakdown.speedMod = Modify_UnitSpeed(sg_Tiger, 0.6)
				SGroup_SetAvgHealth( sg_Tiger, 0.3)
